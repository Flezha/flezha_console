<.page_header eyebrow="Platform" title="Audit log">
  <:sentence>
    The controller's record of who did what, as which <.term key="principal" />, and with which
    outcome. Read it with a filter, or tail it live.
  </:sentence>
</.page_header>
<div class="space-y-6">
  <.runtime_error error={@load_error} action="the audit log" />

  <.notice :if={@disabled_reason} testid="audit-disabled">
    {disabled_message(@disabled_reason)}
  </.notice>

  <%= if is_nil(@disabled_reason) do %>
    <%!-- Stats --%>
    <div :if={@stats}>
      <dl data-testid="audit-stats" class="fcon-facts">
        <.stat :for={{label, value} <- stat_tiles(@stats)} label={label}>{value}</.stat>
      </dl>
      <p :if={@stats[:drop_count] not in [nil, 0]} class="mt-3 fcon-tone-negative">
        {Words.count(@stats[:drop_count], "record")} dropped rather than written.
      </p>
    </div>

    <%!-- Files --%>
    <.section testid="audit-files-panel" digest={Words.count(length(@files), "rotated file")}>
      <:title>Files</:title>
      <:actions>
        <.button
          :if={NodeManager.granted?(@operations, "Logs.rotate")}
          variant="secondary"
          size="sm"
          icon="hero-arrow-path-rounded-square"
          phx-click="rotate"
          data-testid="audit-rotate-btn"
        >
          Rotate
        </.button>
      </:actions>
      <div :if={@rotate_error} data-testid="audit-rotate-error" class="mb-3">
        <.runtime_error error={@rotate_error} action="the rotation" />
      </div>
      <%!-- The catalog lists rotated files, so it is empty until the first
            rotation even while the current file is being written. --%>
      <p :if={@files == []} class="fcon-figures mb-3" data-testid="audit-files-empty">
        A rotated file holds the records written before a rotation. None has been rotated yet;
        records are being written to <span class="fcon-num">{current_file(@stats)}</span>.
      </p>
      <% readable? = NodeManager.granted?(@operations, "Logs.read") %>
      <p :if={readable? and @catalog != []} class="fcon-figures mb-2">
        Open a file to read its records.
      </p>
      <.grid
        :if={@catalog != []}
        paging={@paging}
        id="audit-file-rows"
        rows={@catalog}
        testid="audit-files"
        row_testid={&"audit-file#{if &1.current?, do: "-current"}"}
        row_selected={&(&1.filename == @filter["file"])}
      >
        <:col :let={file} label="File">
          <span class="fcon-num">{file.filename}</span>
          <.chip :if={file.current?}>current</.chip>
        </:col>
        <:col :let={file} label="Records" num>{file[:record_count] || "—"}</:col>
        <:col :let={file} label="Size" num>
          {(file[:size_bytes] && Format.bytes(file[:size_bytes])) || "—"}
        </:col>
        <:col :let={file} :if={readable?} label="Read">
          <.button
            variant="ghost"
            size="sm"
            icon="hero-document-magnifying-glass"
            phx-click="open_file"
            phx-value-file={file.filename}
            aria-label={"Open #{file.filename}"}
            data-testid={"audit-open-#{file.filename}"}
          >
            Open
          </.button>
        </:col>
      </.grid>
    </.section>

    <%!-- Read --%>
    <.section id="audit-records" testid="audit-records-panel">
      <:title>Records</:title>
      <:actions>
        <.button
          variant="secondary"
          size="sm"
          icon="hero-arrow-path"
          phx-click="read"
          data-testid="audit-read-btn"
        >
          Read
        </.button>
      </:actions>

      <div class="space-y-4">
        <form phx-change="filter_change" class="grid gap-4 sm:grid-cols-4">
          <.input
            type="text"
            name="filter[file]"
            label="File"
            value={@filter["file"]}
            placeholder="current file"
            data-testid="audit-filter-file"
          />
          <.input
            type="text"
            name="filter[source]"
            label="Source"
            value={@filter["source"]}
            placeholder="all sources"
            data-testid="audit-filter-source"
          />
          <.input
            type="text"
            name="filter[name]"
            label="Name"
            value={@filter["name"]}
            placeholder="all names"
            data-testid="audit-filter-name"
          />
          <.input
            type="number"
            name="filter[limit]"
            label="Limit"
            value={@filter["limit"]}
            data-testid="audit-filter-limit"
          />
        </form>

        <.runtime_error :if={@read_error} error={@read_error} action="this audit read" />

        <%= cond do %>
          <% @read_error && is_nil(@records) -> %>
          <% is_nil(@records) -> %>
            <p class="fcon-figures">Read loads the records this filter matches.</p>
          <% @records == [] -> %>
            <p data-testid="audit-records-empty" class="fcon-figures">
              No record matches this filter.
            </p>
          <% true -> %>
            <div class="fcon-record-head fcon-record-cols" aria-hidden="true">
              <span>Time</span>
              <span>Source</span>
              <span>Name</span>
              <span>Principal</span>
              <span>Outcome</span>
            </div>
            <ol data-testid="audit-records" class="fcon-records">
              <%!-- Not paged: Read more is capped at max_records/0. --%>
              <li :for={{record, index} <- Enum.with_index(@records)} data-testid="audit-record">
                <button
                  type="button"
                  class="fcon-record-head"
                  aria-expanded={to_string(MapSet.member?(@expanded, index))}
                  phx-click="record_toggle"
                  phx-value-index={index}
                  data-testid={"audit-record-#{index}"}
                >
                  <span class="fcon-num">{field(record, ["ts_iso"]) || "—"}</span>
                  <span>{field(record, ["source"]) || "—"}</span>
                  <span class="font-medium">{field(record, ["name"]) || "—"}</span>
                  <span class="fcon-num">
                    {field(record, ["caller", "principal"]) ||
                      field(record, ["metadata", "principal"]) ||
                      "—"}
                  </span>
                  <span>{outcome(record) || "—"}</span>
                </button>
                <pre
                  :if={MapSet.member?(@expanded, index)}
                  class="fcon-code"
                  data-testid={"audit-record-json-#{index}"}
                >{Format.json_line(record, pretty: true)}</pre>
              </li>
            </ol>
            <div :if={@truncated} class="flex items-center gap-3">
              <span class="fcon-figures" data-testid="audit-truncated">
                More records match than this read took.
              </span>
              <span
                :if={!more_readable?(@records)}
                class="fcon-figures"
                data-testid="audit-capped"
              >
                Narrow the filter to read past the first {max_records()}.
              </span>
              <.button
                :if={more_readable?(@records)}
                variant="secondary"
                size="sm"
                phx-click="read_more"
                data-testid="audit-read-more"
              >
                Read more
              </.button>
            </div>
        <% end %>
      </div>
    </.section>

    <%!-- Tail --%>
    <.section
      testid="audit-tail-panel"
      digest={
        if @tailing,
          do: Words.count(length(@tail_records), "record") <> " so far",
          else: "stopped"
      }
    >
      <:title>Live tail</:title>
      <:actions>
        <.switch
          checked={@tailing != nil}
          label="Tail new records"
          phx-click={if @tailing, do: "stop_tail", else: "start_tail"}
          testid="audit-tail-toggle"
        />
      </:actions>
      <div>
        <%!-- A subscription the controller refused is stated: a tail that never
              started looks exactly like a quiet one otherwise. --%>
        <.runtime_error
          :if={@tail_error}
          error={@tail_error}
          action="the live audit tail"
        />
        <%= cond do %>
          <% is_nil(@tailing) -> %>
            <p data-testid="audit-tail-idle" class="fcon-figures">
              The tail is stopped. Start it to stream new audit records as they are written.
            </p>
          <% @tail_records == [] -> %>
            <p class="fcon-figures">Tailing — waiting for the next record.</p>
          <% true -> %>
            <pre data-testid="audit-tail-records" class="fcon-code"><span :for={record <- @tail_records} class="block">{Format.json_line(record)}</span></pre>
        <% end %>
      </div>
    </.section>
  <% end %>
</div>
