<div class="max-w-2xl">
  <.page_header eyebrow="Account" title="Settings">
    <:sentence>
      Your console account, and the flezha token every controller call is made with.
    </:sentence>
  </.page_header>

  <.section flush testid="email-settings">
    <:title>Email</:title>
    <div>
      <.form :let={f} for={@email_changeset} action={~p"/users/settings"} id="update_email">
        <input type="hidden" name="action" value="update_email" />

        <.input
          field={f[:email]}
          type="email"
          label="Email"
          autocomplete="username"
          spellcheck="false"
          required
        />

        <.button class="mt-4" phx-disable-with="Changing…">Change email</.button>
      </.form>
    </div>
  </.section>

  <.section testid="password-settings">
    <:title>Password</:title>
    <div>
      <.form :let={f} for={@password_changeset} action={~p"/users/settings"} id="update_password">
        <input type="hidden" name="action" value="update_password" />

        <.input
          field={f[:password]}
          type="password"
          label="New password"
          autocomplete="new-password"
          spellcheck="false"
          required
        />
        <.input
          field={f[:password_confirmation]}
          type="password"
          label="Confirm new password"
          autocomplete="new-password"
          spellcheck="false"
          required
        />
        <.button class="mt-4" phx-disable-with="Changing…">Save password</.button>
      </.form>
    </div>
  </.section>

  <.section testid="flezha-token-settings">
    <:title>Flezha token</:title>
    <div class=" space-y-4">
      <p>
        The credential this console presents to the controller, as which <.term key="principal" />
        it acts. Stored encrypted and never shown again — issue one with <code>flz token issue</code>.
      </p>

      <dl class="fcon-facts" data-testid="flezha-token-binding">
        <.stat label="Stored for you">
          {if @user_token_stored?, do: "Yes", else: "No — the service token is used"}
        </.stat>
        <.stat :if={@authz.principal} label="Principal" mono>{@authz.principal}</.stat>
        <.stat :if={@authz.namespace} label="Namespace" mono>{@authz.namespace}</.stat>
        <.stat :if={@authz.role} label="Role" mono>{@authz.role}</.stat>
        <.stat :if={is_nil(@authz.principal)} label="Bound identity">
          None — {if @authz.reason,
            do: code_names(error_message(@authz.reason)),
            else: "no token is presented."}
        </.stat>
      </dl>

      <.form
        for={%{}}
        as={:flezha_token}
        action={~p"/users/settings"}
        method="put"
        id="update_flezha_token"
      >
        <input type="hidden" name="action" value="update_flezha_token" />
        <.input
          type="password"
          name="flezha_token[token]"
          id="flezha_token_token"
          value=""
          label={if @user_token_stored?, do: "Replace token", else: "Token"}
          autocomplete="off"
          spellcheck="false"
          placeholder="flz_…"
        />
        <.button class="mt-4">Save token</.button>
      </.form>

      <.form
        :if={@user_token_stored?}
        for={%{}}
        as={:flezha_token}
        action={~p"/users/settings"}
        method="put"
        id="clear_flezha_token"
      >
        <input type="hidden" name="action" value="clear_flezha_token" />
        <.button variant="secondary">Clear token</.button>
      </.form>
    </div>
  </.section>
</div>
