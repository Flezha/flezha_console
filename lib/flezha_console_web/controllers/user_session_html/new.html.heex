<Layouts.auth flash={@flash} current_scope={@current_scope}>
  <.page_header help={false} eyebrow={product_name()} title="Log in">
    <:sentence :if={@current_scope}>
      Confirm your password to change sensitive account settings.
    </:sentence>
    <:sentence :if={!@current_scope}>
      The console for a flezha controller. Accounts are created by an operator;
      ask one if you have none.
    </:sentence>
  </.page_header>

  <.form
    :let={f}
    for={@form}
    as={:user}
    id="login_form_password"
    action={~p"/users/log-in"}
    class="space-y-4"
  >
    <.input
      field={f[:email]}
      type="email"
      label="Email"
      autocomplete="username"
      spellcheck="false"
      required
      phx-mounted={JS.focus()}
      readonly={!!@current_scope}
    />
    <.input
      field={f[:password]}
      type="password"
      label="Password"
      autocomplete="current-password"
      spellcheck="false"
    />
    <.button
      name={@form[:remember_me].name}
      value="true"
      class="w-full"
      icon_right="hero-arrow-right"
    >
      Log in
    </.button>
  </.form>
</Layouts.auth>
