<div class="min-h-screen bg-surface-base flex flex-col items-center justify-center px-4">
  <div class="mb-8 text-center">
    <a href="/" class="inline-flex items-center gap-2">
      <span class="text-3xl font-bold text-accent">flezha</span>
      <span class="text-sm text-th-muted font-medium uppercase tracking-wider">UI</span>
    </a>
  </div>

  <div class="w-full max-w-sm bg-surface border border-brd rounded-modal p-8 shadow-modal">
    <.flash_group flash={@flash} />
    <%= if assigns[:inner_block] do %>
      {render_slot(@inner_block)}
    <% else %>
      {@inner_content}
    <% end %>
  </div>
</div>
