<div class="min-h-screen flex flex-col items-center justify-center px-4 py-10">
  <.link navigate={~p"/"} class="mb-8">
    <.brand_lockup on={:canvas} />
  </.link>

  <div class="flex items-center justify-center gap-10 w-full">
    <%!-- Decorative: a mascot only where nobody is working. --%>
    <img :if={assigns[:mascot]} src={@mascot} alt="" class="flz-hide-mobile w-80 shrink" />
    <div class="flz-panel w-full max-w-sm p-8">
      <.flash_group flash={@flash} />
      <%= if assigns[:inner_block] do %>
        {render_slot(@inner_block)}
      <% else %>
        {@inner_content}
      <% end %>
    </div>
  </div>
</div>
