<main class="fui-auth" data-testid="auth-canvas">
  <div class="fui-auth-toggle"><.theme_toggle /></div>
  <div class="fui-auth-form">
    <.link navigate={~p"/"} class="justify-self-center">
      <.brand_lockup on={:canvas} />
    </.link>
    <%= if assigns[:inner_block] do %>
      {render_slot(@inner_block)}
    <% else %>
      {@inner_content}
    <% end %>
  </div>
</main>

<.flash_group flash={@flash} />
