<main class="fui-auth" data-testid="auth-canvas">
  <div class="fui-auth-form">
    <.link navigate={~p"/"} class="justify-self-start">
      <.brand_lockup on={:canvas} />
    </.link>
    <%= if assigns[:inner_block] do %>
      {render_slot(@inner_block)}
    <% else %>
      {@inner_content}
    <% end %>
  </div>
  <%!-- Decorative: a mascot only where nobody is working, and not on a phone. --%>
  <img :if={assigns[:mascot]} src={@mascot} alt="" class="fui-auth-mascot" />
</main>

<.flash_group flash={@flash} />
