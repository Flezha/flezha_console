<% node = FlezhaUi.Service.NodeManager.connected_node()

authz =
  FlezhaUi.Service.NodeManager.authz_status(
    FlezhaUi.Accounts.Scope.flezha_token(assigns[:current_scope])
  )

current_path = assigns[:current_path] || (assigns[:conn] && assigns[:conn].request_path) || "/"

nav = [
  {~p"/", "hero-squares-2x2", "Dashboard"},
  {~p"/namespaces", "hero-rectangle-stack", "Namespaces"},
  {~p"/operatives", "hero-cpu-chip", "Operatives"},
  {~p"/plugins", "hero-puzzle-piece", "Plugins"},
  {~p"/cluster", "hero-server-stack", "Cluster"},
  {~p"/observability", "hero-signal", "Observability"},
  {~p"/controller", "hero-server", "Controller"},
  {~p"/schedules", "hero-clock", "Schedules"},
  {~p"/dlq", "hero-inbox-stack", "Dead-letter"},
  {~p"/audit", "hero-document-text", "Audit log"}
] %>
<div class="flz-app">
  <aside class="flz-sidebar">
    <.link navigate={~p"/"} class="flz-sidebar-brand">
      <.brand_lockup on={:chrome} />
    </.link>

    <nav class="flz-sidebar-nav">
      <.link
        :for={{path, icon, label} <- nav}
        navigate={path}
        aria-current={nav_current?(current_path, path) && "page"}
        class="flz-sidebar-link"
      >
        <.icon name={icon} class="w-4 h-4 shrink-0" />{label}
      </.link>
    </nav>

    <div class="flz-sidebar-foot">
      <div class="flex items-center gap-2 mb-2">
        <.status_dot connected?={!!node} />
        <span :if={node} class="flz-num truncate">{node}</span>
        <span :if={!node}>Disconnected</span>
      </div>
      <p class="flz-num">flezha_ui v0.1.0</p>
    </div>
  </aside>

  <div class="flz-app-main">
    <header class="flz-topbar">
      <div class="flex items-center gap-3">
        <span :if={node} class="flex items-center gap-1.5">
          <.status_dot connected?={true} />{node}
        </span>
        <span :if={!node} class="flz-topbar-muted flex items-center gap-1.5">
          <.status_dot connected?={false} /> Not connected
        </span>
      </div>
      <div class="flex items-center gap-4">
        <.authz_identity status={authz} />
        <span class="flz-topbar-muted">
          {assigns[:current_scope] && assigns[:current_scope].user &&
            assigns[:current_scope].user.email}
        </span>
        <.link navigate={~p"/users/settings"}>Settings</.link>
        <.link href={~p"/users/log-out"} method="delete">Log out</.link>
        <button
          type="button"
          data-flz-theme-toggle
          class="flz-chrome-icon-btn"
          title="Toggle light/dark mode"
          aria-label="Toggle light/dark mode"
        >
          <%!-- Sun in dark mode (switch to light), moon in light mode. --%>
          <.icon name="hero-sun" class="w-4 h-4 show-in-dark" />
          <.icon name="hero-moon" class="w-4 h-4 show-in-light" />
        </button>
      </div>
    </header>

    <main class="flz-canvas">
      <.flash_group flash={@flash} />
      <.authz_banner status={authz} />
      <%= if assigns[:inner_block] do %>
        {render_slot(@inner_block)}
      <% else %>
        {@inner_content}
      <% end %>
    </main>
  </div>
</div>
