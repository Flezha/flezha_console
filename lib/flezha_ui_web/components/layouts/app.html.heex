<% node = FlezhaUi.Service.NodeManager.connected_node()

token = FlezhaUi.Accounts.Scope.flezha_token(assigns[:current_scope])
authz = FlezhaUi.Service.NodeManager.authz_status(token)

# The settings screens are plain controller pages sharing this shell, and a
# LiveComponent cannot be mounted into one.
live? = is_nil(assigns[:conn])

current_path = assigns[:current_path] || (assigns[:conn] && assigns[:conn].request_path) || "/"

scope =
  if live?,
    do: assigns[:shell_namespace],
    else: FlezhaUiWeb.Layouts.dead_namespace(assigns)

namespaces =
  if live?,
    do: assigns[:shell_namespaces] || [],
    else: FlezhaUiWeb.Layouts.dead_namespaces(assigns)

problems = assigns[:shell_pulse] && assigns[:shell_pulse].items %>
<div class="flz-app">
  <aside class="flz-sidebar">
    <.link
      navigate={~p"/"}
      class="flz-sidebar-brand"
      aria-label="Flezha UI"
      data-testid="brand-link"
    >
      <.brand_lockup on={:chrome} />
    </.link>

    <nav class="flz-sidebar-nav">
      <%= for section <- nav_sections(scope) do %>
        <p
          class="flz-sidebar-section"
          data-current={
            Enum.any?(section.entries, &nav_current?(current_path, &1.path)) && "true"
          }
        >
          {section.heading}<span :if={section.scope} class="flz-num">{section.scope}</span>
        </p>

        <p :if={section.entries == []} class="flz-sidebar-hint" data-testid="no-namespace-scoped">
          No namespace in scope. <.link navigate={~p"/namespaces"} class="underline">Pick one</.link>.
        </p>

        <.link
          :for={entry <- section.entries}
          navigate={entry.path}
          aria-current={nav_current?(current_path, entry.path) && "page"}
          class="flz-sidebar-link"
        >
          <.icon name={entry.icon} class="w-4 h-4 shrink-0" />{entry.label}
          <span
            :if={entry.count == :problems and problems not in [nil, []]}
            class={"fui-count fui-count--#{FlezhaUiWeb.Attention.worst(problems)} ml-auto"}
            data-testid="problems-count"
            data-tone={FlezhaUiWeb.Attention.worst(problems)}
          >
            {length(problems)}
          </span>
        </.link>
      <% end %>
    </nav>

    <div class="flz-sidebar-foot">
      <div class="flex items-center gap-2 mb-2">
        <span
          class={["fui-shape", (node && "fui-tone-positive") || "fui-tone-negative"]}
          data-shape="dot"
          aria-hidden="true"
        >
        </span>
        <span :if={node} class="flz-num truncate">{node}</span>
        <span :if={!node}>Disconnected</span>
      </div>
      <p class="flz-num">flezha_ui v0.1.0</p>
    </div>
  </aside>

  <div class="flz-app-main">
    <header class="flz-topbar" data-testid="topbar">
      <div class="flex flex-wrap items-center gap-3">
        <span :if={node} class="flex items-center gap-1.5">
          <span class="fui-shape fui-tone-positive" data-shape="dot" aria-hidden="true"></span>{node}
        </span>
        <span :if={!node} class="flz-topbar-muted flex items-center gap-1.5">
          <span class="fui-shape fui-tone-negative" data-shape="dot" aria-hidden="true"></span>
          Not connected
        </span>

        <%!-- One meaning in both places: show me this namespace. --%>
        <div :if={live?} id="namespace-picker" class="relative" data-fui-pop>
          <button
            type="button"
            class="flz-dropdown-trigger flz-chrome-icon-btn"
            data-fui-pop-trigger
            data-testid="namespace-picker"
            aria-label="Namespace scope"
            aria-haspopup="menu"
            aria-expanded="false"
            phx-mounted={JS.ignore_attributes(["aria-expanded"])}
          >
            <.icon name="hero-rectangle-stack" class="w-4 h-4" />
            <span class="flz-num">{scope || "no namespace"}</span>
            <.icon name="hero-chevron-down-micro" class="shrink-0" />
          </button>
          <div
            class="flz-dropdown flz-menu mt-1"
            role="menu"
            data-fui-pop-panel
            hidden
            phx-mounted={JS.ignore_attributes(["hidden", "style"])}
          >
            <p :if={namespaces == []} class="flz-menu-item">No namespace is reachable.</p>
            <.link
              :for={name <- namespaces}
              navigate={scope_target(current_path, name)}
              aria-current={name == scope && "true"}
              data-testid={"namespace-picker-#{name}"}
              data-fui-pop-item
              class="flz-menu-item flz-num"
            >
              {name}
            </.link>
          </div>
        </div>
      </div>

      <div class="flex flex-wrap items-center gap-3">
        <div
          :if={assigns[:refresh_interval]}
          data-testid="liveness"
          class="flex items-center gap-2"
        >
          <span class="flz-topbar-muted" data-testid="liveness-state">
            <span :if={assigns[:refresh_paused]}>Paused</span>
            <span :if={!assigns[:refresh_paused]}>
              Every {FlezhaUi.Format.duration(@refresh_interval)} · {FlezhaUi.Format.time_of_day(
                assigns[:refresh_at]
              )}
            </span>
          </span>
          <button
            type="button"
            phx-click="refresh_toggle"
            aria-pressed={to_string(assigns[:refresh_paused] || false)}
            data-testid="liveness-toggle"
            class="flz-chrome-icon-btn"
            title={if assigns[:refresh_paused], do: "Resume refreshing", else: "Pause refreshing"}
            aria-label={
              if assigns[:refresh_paused], do: "Resume refreshing", else: "Pause refreshing"
            }
          >
            <.icon :if={assigns[:refresh_paused]} name="hero-play" class="w-4 h-4" />
            <.icon :if={!assigns[:refresh_paused]} name="hero-pause" class="w-4 h-4" />
          </button>
        </div>

        <span
          :if={authz.principal}
          data-testid="authz-identity"
          class="flz-num flz-topbar-muted flex items-center gap-1.5 text-xs"
          title={"flezha principal #{authz.principal}"}
        >
          <.icon name="hero-key" class="w-3.5 h-3.5" />
          {authz.principal}
          <span :if={authz.namespace}>/{authz.namespace}</span>
          <span :if={authz.role}>({authz.role})</span>
        </span>

        <button
          type="button"
          class="flz-chrome-icon-btn"
          data-fui-help-open
          aria-label="Help for this screen"
          data-testid="help-btn"
        >
          <.icon name="hero-question-mark-circle" class="w-5 h-5" />
        </button>

        <div id="account-menu" class="relative" data-fui-pop>
          <button
            type="button"
            class="flz-dropdown-trigger flz-chrome-icon-btn"
            data-fui-pop-trigger
            data-testid="account-menu"
            aria-label="Account"
            aria-haspopup="menu"
            aria-expanded="false"
            phx-mounted={JS.ignore_attributes(["aria-expanded"])}
          >
            <.icon name="hero-user-circle" class="w-5 h-5" />
            <.icon name="hero-chevron-down-micro" class="shrink-0" />
          </button>
          <div
            class="flz-dropdown flz-menu mt-1 right-0"
            role="menu"
            data-fui-pop-panel
            hidden
            phx-mounted={JS.ignore_attributes(["hidden", "style"])}
          >
            <p class="flz-menu-item" data-testid="account-identity">
              {assigns[:current_scope] && assigns[:current_scope].user &&
                assigns[:current_scope].user.email}
            </p>
            <hr class="flz-menu-sep" />
            <.link navigate={~p"/users/settings"} class="flz-menu-item" data-fui-pop-item>
              <.icon name="hero-cog-6-tooth" class="w-4 h-4" /> Settings
            </.link>
            <button
              type="button"
              data-flz-theme-toggle
              data-fui-pop-item
              class="flz-menu-item"
              title="Toggle light/dark mode"
            >
              <%!-- Sun in dark mode (switch to light), moon in light mode. --%>
              <.icon name="hero-sun" class="w-4 h-4 flz-theme-sun" />
              <.icon name="hero-moon" class="w-4 h-4 flz-theme-moon" /> Toggle theme
            </button>
            <hr class="flz-menu-sep" />
            <.link
              href={~p"/users/log-out"}
              method="delete"
              class="flz-menu-item"
              data-fui-pop-item
              data-testid="log-out"
            >
              <.icon name="hero-arrow-right-start-on-rectangle" class="w-4 h-4" /> Log out
            </.link>
          </div>
        </div>
      </div>
    </header>

    <main class="flz-canvas" data-testid="main">
      <.authz_banner status={authz} />
      <%= if assigns[:inner_block] do %>
        {render_slot(@inner_block)}
      <% else %>
        {@inner_content}
      <% end %>
    </main>
  </div>
</div>

<%!-- What `g` then a letter follows; each is in the rail too. --%>
<div hidden>
  <.link navigate={(scope && ~p"/namespaces/#{scope}") || ~p"/namespaces"} data-shortcut="h">
    Home
  </.link>
  <.link navigate={(scope && ~p"/namespaces/#{scope}/relays") || ~p"/relays"} data-shortcut="r">
    Relays
  </.link>
  <.link navigate={~p"/problems"} data-shortcut="p">Problems</.link>
  <.link navigate={~p"/cluster"} data-shortcut="c">Cluster</.link>
</div>

<.flash_group flash={@flash} />
<.help_overlay screen={FlezhaUiWeb.Layouts.screen(current_path)} />

<.live_component
  :if={live?}
  module={FlezhaUiWeb.CommandPalette}
  id={FlezhaUiWeb.CommandPalette.id()}
  namespaces={namespaces}
  scope={scope}
  token={token}
  operations={assigns[:operations]}
/>
