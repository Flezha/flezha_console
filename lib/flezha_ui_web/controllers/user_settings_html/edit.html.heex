<div class="max-w-xl space-y-6">
  <.header>
    Account settings
    <:subtitle>Manage your account email address and password settings</:subtitle>
  </.header>

  <.panel icon="hero-envelope">
    <:title>Email</:title>
    <div class="flz-panel-body">
      <.form :let={f} for={@email_changeset} action={~p"/users/settings"} id="update_email">
        <input type="hidden" name="action" value="update_email" />

        <.input
          field={f[:email]}
          type="email"
          label="Email"
          autocomplete="username"
          spellcheck="false"
          required
        />

        <.button class="mt-4" phx-disable-with="Changing...">Change Email</.button>
      </.form>
    </div>
  </.panel>

  <.panel icon="hero-lock-closed">
    <:title>Password</:title>
    <div class="flz-panel-body">
      <.form :let={f} for={@password_changeset} action={~p"/users/settings"} id="update_password">
        <input type="hidden" name="action" value="update_password" />

        <.input
          field={f[:password]}
          type="password"
          label="New password"
          autocomplete="new-password"
          spellcheck="false"
          required
        />
        <.input
          field={f[:password_confirmation]}
          type="password"
          label="Confirm new password"
          autocomplete="new-password"
          spellcheck="false"
          required
        />
        <.button class="mt-4" phx-disable-with="Changing...">
          Save Password
        </.button>
      </.form>
    </div>
  </.panel>

  <.panel testid="flezha-token-settings" icon="hero-key">
    <:title>Flezha token</:title>
    <div class="flz-panel-body space-y-4">
      <p class="text-sm text-th-secondary">
        The credential this UI presents to the controller. Stored encrypted and never shown again —
        issue one with <code class="font-mono">flz token issue</code>.
      </p>

      <dl class="text-sm space-y-1" data-testid="flezha-token-binding">
        <div class="flex gap-2">
          <dt class="text-th-secondary w-32">Stored for you</dt>
          <dd>{if @user_token_stored?, do: "yes", else: "no — using the service token"}</dd>
        </div>
        <div :if={@authz.principal} class="flex gap-2">
          <dt class="text-th-secondary w-32">Principal</dt>
          <dd class="flz-num">{@authz.principal}</dd>
        </div>
        <div :if={@authz.namespace} class="flex gap-2">
          <dt class="text-th-secondary w-32">Namespace</dt>
          <dd class="flz-num">{@authz.namespace}</dd>
        </div>
        <div :if={@authz.role} class="flex gap-2">
          <dt class="text-th-secondary w-32">Role</dt>
          <dd class="flz-num">{@authz.role}</dd>
        </div>
        <div :if={@authz.expires_at} class="flex gap-2">
          <dt class="text-th-secondary w-32">Expires</dt>
          <dd class="flz-num">{Format.token_expiry(@authz.expires_at)}</dd>
        </div>
        <div :if={is_nil(@authz.principal)} class="flex gap-2">
          <dt class="text-th-secondary w-32">Bound identity</dt>
          <dd>
            none — {if @authz.reason,
              do: FlezhaUiWeb.CoreComponents.error_message(@authz.reason),
              else: "no token is presented."}
          </dd>
        </div>
      </dl>

      <.form
        for={%{}}
        as={:flezha_token}
        action={~p"/users/settings"}
        method="put"
        id="update_flezha_token"
      >
        <input type="hidden" name="action" value="update_flezha_token" />
        <.input
          type="password"
          name="flezha_token[token]"
          id="flezha_token_token"
          value=""
          label={if @user_token_stored?, do: "Replace token", else: "Token"}
          autocomplete="off"
          spellcheck="false"
          placeholder="flz_..."
        />
        <.button class="mt-4">Save token</.button>
      </.form>

      <.form
        :if={@user_token_stored?}
        for={%{}}
        as={:flezha_token}
        action={~p"/users/settings"}
        method="put"
        id="clear_flezha_token"
      >
        <input type="hidden" name="action" value="clear_flezha_token" />
        <.button variant="secondary">Clear token</.button>
      </.form>

      <%!-- Only while no admin has claimed the controller: a claim after that
            would be core's recovery, which unbinds the existing admin. --%>
      <div
        :if={@authz.posture == :bootstrap_pending}
        data-testid="bootstrap-claim"
        class="border-t border-brd-subtle pt-4 space-y-3"
      >
        <p class="text-sm text-th-secondary">
          No admin has claimed this controller yet. Claim it with the one-time bootstrap token
          from its <code class="font-mono">bootstrap.token</code>
          file; the admin token it mints is stored as yours and not shown.
        </p>
        <.runtime_error error={@bootstrap_error} action="the bootstrap claim" />
        <.form
          for={%{}}
          as={:bootstrap}
          action={~p"/users/settings"}
          method="put"
          id="claim_bootstrap"
        >
          <input type="hidden" name="action" value="claim_bootstrap" />
          <.input
            type="password"
            name="bootstrap[token]"
            id="bootstrap_token"
            value=""
            label="Bootstrap token"
            autocomplete="off"
            spellcheck="false"
          />
          <.button class="mt-4" data-testid="bootstrap-claim-btn">Claim bootstrap</.button>
        </.form>
      </div>
    </div>
  </.panel>
</div>
