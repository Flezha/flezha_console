<Layouts.auth flash={%{}} mascot={~p"/images/badger-not-found.webp"}>
  <div data-testid="not-found">
    <.page_header eyebrow="Not found" title="Nothing here">
      <:sentence>
        This page does not exist. The link may be mistyped, or what it pointed at has moved.
      </:sentence>
    </.page_header>
    <.button variant="secondary" href={~p"/"} icon="hero-arrow-left">Back to the console</.button>
  </div>
</Layouts.auth>
