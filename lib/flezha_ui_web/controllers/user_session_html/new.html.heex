<Layouts.auth
  flash={@flash}
  current_scope={@current_scope}
  mascot={~p"/images/badger-laptop.webp"}
>
  <div class="space-y-6">
    <.header>
      Log in
      <:subtitle :if={@current_scope}>
        You need to reauthenticate to perform sensitive actions on your account.
      </:subtitle>
      <:subtitle :if={!@current_scope}>
        No account?
        <.link navigate={~p"/users/register"} class="hover:underline">
          Register
        </.link>
      </:subtitle>
    </.header>

    <.form :let={f} for={@form} as={:user} id="login_form_password" action={~p"/users/log-in"}>
      <div class="space-y-4">
        <.input
          field={f[:email]}
          type="email"
          label="Email"
          autocomplete="username"
          spellcheck="false"
          required
          phx-mounted={JS.focus()}
          readonly={!!@current_scope}
        />
        <.input
          field={f[:password]}
          type="password"
          label="Password"
          autocomplete="current-password"
          spellcheck="false"
        />
      </div>
      <.button
        name={@form[:remember_me].name}
        value="true"
        class="w-full mt-6"
      >
        Log in <span aria-hidden="true">&rarr;</span>
      </.button>
    </.form>
  </div>
</Layouts.auth>
