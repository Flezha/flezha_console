<Layouts.auth flash={@flash} current_scope={@current_scope}>
  <.page_header help={false} eyebrow="Flezha UI" title={"Welcome, #{@user.email}"}>
    <:sentence>
      {if @user.confirmed_at,
        do: "Log in with this link.",
        else: "Confirm your account to log in."}
    </:sentence>
  </.page_header>

  <.form
    :if={!@user.confirmed_at}
    for={@form}
    id="confirmation_form"
    action={~p"/users/log-in?_action=confirmed"}
    phx-mounted={JS.focus_first()}
    class="space-y-2"
  >
    <input type="hidden" name={@form[:token].name} value={@form[:token].value} />
    <.button
      name={@form[:remember_me].name}
      value="true"
      phx-disable-with="Confirming…"
      class="w-full"
    >
      Confirm and stay logged in
    </.button>
    <.button variant="secondary" phx-disable-with="Confirming…" class="w-full">
      Confirm and log in only this time
    </.button>
  </.form>

  <.form
    :if={@user.confirmed_at}
    for={@form}
    id="login_form"
    action={~p"/users/log-in"}
    phx-mounted={JS.focus_first()}
    class="space-y-2"
  >
    <input type="hidden" name={@form[:token].name} value={@form[:token].value} />
    <%= if @current_scope do %>
      <.button phx-disable-with="Logging in…" class="w-full">Log in</.button>
    <% else %>
      <.button
        name={@form[:remember_me].name}
        value="true"
        phx-disable-with="Logging in…"
        class="w-full"
      >
        Log in and stay logged in
      </.button>
      <.button variant="secondary" phx-disable-with="Logging in…" class="w-full">
        Log in only this time
      </.button>
    <% end %>
  </.form>

  <.notice :if={!@user.confirmed_at}>
    If you prefer a password, you can set one in your account settings.
  </.notice>
</Layouts.auth>
