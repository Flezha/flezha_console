<Layouts.auth
  flash={@flash}
  current_scope={@current_scope}
  mascot={~p"/images/badger-laptop.webp"}
>
  <.page_header eyebrow="Flezha UI" title="Create an account">
    <:sentence>
      Already have one?
      <.link navigate={~p"/users/log-in"} data-testid="login-link">Log in</.link>
    </:sentence>
  </.page_header>

  <.form :let={f} for={@changeset} action={~p"/users/register"} class="space-y-4">
    <.input
      field={f[:email]}
      type="email"
      label="Email"
      autocomplete="username"
      spellcheck="false"
      required
      phx-mounted={JS.focus()}
    />
    <.button phx-disable-with="Creating account…" class="w-full">Create account</.button>
  </.form>
</Layouts.auth>
