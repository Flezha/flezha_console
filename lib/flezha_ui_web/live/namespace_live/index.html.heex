<div class="space-y-6">
  <div class="flex items-center justify-between">
    <h1 class="text-2xl font-bold text-white">Namespaces</h1>
  </div>

  <%= if @namespaces == [] do %>
    <div class="bg-zinc-900 border border-zinc-800 rounded-lg px-6 py-10 text-center">
      <p class="text-zinc-400">No namespaces found.</p>
      <p class="text-sm text-zinc-500 mt-1">Make sure the flezha agent is connected.</p>
    </div>
  <% else %>
    <div class="bg-zinc-900 border border-zinc-800 rounded-lg overflow-hidden">
      <table class="w-full text-sm">
        <thead>
          <tr class="border-b border-zinc-800">
            <th class="text-left px-5 py-3 text-zinc-400 font-medium">Namespace</th>
            <th class="text-left px-5 py-3 text-zinc-400 font-medium">Processors</th>
            <th class="text-left px-5 py-3 text-zinc-400 font-medium">Compute Engines</th>
            <th class="px-5 py-3"></th>
          </tr>
        </thead>
        <tbody>
          <%= for ns <- @namespaces do %>
            <tr class="border-b border-zinc-800/50 hover:bg-zinc-800/30">
              <td class="px-5 py-3 text-white font-medium font-mono">{ns.name}</td>
              <td class="px-5 py-3 text-zinc-300">{ns.processor_count}</td>
              <td class="px-5 py-3 text-zinc-300">{ns.ce_count}</td>
              <td class="px-5 py-3 text-right">
                <a
                  href={~p"/namespaces/#{ns.name}"}
                  class="text-sm font-medium hover:text-white transition-colors"
                  style="color: #FD4F00;"
                >
                  View &rarr;
                </a>
              </td>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>
  <% end %>
</div>
