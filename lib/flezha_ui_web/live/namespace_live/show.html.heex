<div class="space-y-6">
  <.header mono>
    {@ns}
    <:actions>
      <.button
        :if={NodeManager.granted?(@operations, "Relay.start")}
        phx-click="launcher_open"
        data-testid="start-relay-btn"
        icon="hero-plus"
      >
        Start Relay
      </.button>
    </:actions>
  </.header>

  <.runtime_error error={@load_error} />

  <.fleet_summary topology={@topology} />

  <%!-- Quotas --%>
  <.panel
    fold="quotas"
    open={@sections["quotas"] or @quota_breached}
    forced={@quota_breached}
    testid="quota-panel"
    icon="hero-chart-bar"
    class="overflow-hidden"
  >
    <:title>
      Quotas <span :if={@quota_breached} class="flz-badge flz-badge--negative">breached</span>
    </:title>
    <:actions>
      <button
        :if={@declared != nil and NodeManager.granted?(@operations, "Namespace.set_quotas")}
        phx-click="open_quotas"
        data-testid="edit-quotas-btn"
        class="flz-button flz-button--sm flz-button--secondary"
      >
        Edit
      </button>
    </:actions>
    <p
      :if={is_nil(@declared)}
      data-testid="namespace-undeclared"
      class="px-5 py-3 text-xs text-th-muted"
    >
      This namespace has a running hub but no declaration, so no limits apply to its counters.
    </p>
    <table class="flz-table">
      <tbody>
        <tr
          :for={row <- @quotas}
          data-testid={"quota-#{row.kind}"}
          class="last:border-b-0"
        >
          <td class="flz-num text-xs w-48">{row.kind}</td>
          <td class="text-th-primary flz-num text-xs w-32">{row.value || "—"}</td>
          <td>
            <div :if={row.limit} class="flex items-center gap-2">
              <div class="h-1.5 w-40 rounded-full bg-surface-input overflow-hidden">
                <div
                  class={[
                    "h-full rounded-full",
                    if(row.breached?, do: "bg-danger", else: "bg-accent")
                  ]}
                  style={"width: #{min(100, round((row.value || 0) * 100 / max(row.limit, 1)))}%"}
                >
                </div>
              </div>
              <span class="text-[11px] text-th-muted font-mono">of {row.limit}</span>
              <span
                :if={row.breached?}
                data-testid={"quota-breached-#{row.kind}"}
                class="flz-badge flz-badge--negative"
              >
                breached
              </span>
            </div>
            <span
              :if={is_nil(row.limit)}
              data-testid={"quota-unset-#{row.kind}"}
              class="text-[11px] text-th-muted"
            >
              no limit applies
            </span>
          </td>
        </tr>
      </tbody>
    </table>
  </.panel>

  <%!-- Role bindings --%>
  <.panel
    fold="role-bindings"
    open={@sections["role-bindings"]}
    testid="role-bindings"
    icon="hero-key"
    class="overflow-hidden"
  >
    <:title>Role bindings ({length(@role_bindings)})</:title>
    <:actions>
      <button
        :if={NodeManager.granted?(@operations, "Namespace.bind_role")}
        phx-click="open_bind"
        data-testid="bind-role-btn"
        class="flz-button flz-button--sm flz-button--secondary"
      >
        <.icon name="hero-plus" class="w-3.5 h-3.5" /> Bind
      </button>
    </:actions>
    <%= if @role_bindings == [] do %>
      <.empty_state icon="hero-key" testid="role-bindings-empty">
        No principal is bound to this namespace.
        <:detail :if={NodeManager.granted?(@operations, "Namespace.bind_role")}>
          <button phx-click="open_bind" data-testid="bind-role-empty-btn" class="underline">
            Bind one
          </button>
        </:detail>
      </.empty_state>
    <% else %>
      <table class="flz-table">
        <tbody>
          <tr
            :for={binding <- @role_bindings}
            data-testid={"role-binding-#{binding[:principal]}"}
            class="last:border-b-0"
          >
            <td class="text-th-primary flz-num text-xs">{binding[:principal]}</td>
            <td class="flz-num text-xs">
              <span
                :for={role <- binding[:roles] || []}
                class="inline-flex items-center gap-1 mr-2"
                data-testid={"role-#{binding[:principal]}-#{role}"}
              >
                {role}
                <button
                  :if={NodeManager.granted?(@operations, "Namespace.unbind_role")}
                  phx-click="confirm_unbind"
                  phx-value-principal={binding[:principal]}
                  phx-value-namespace={binding[:namespace]}
                  phx-value-role={role}
                  data-testid={"unbind-role-#{binding[:principal]}-#{role}"}
                  class="text-danger-text hover:text-danger"
                  aria-label={"Unbind #{role}"}
                >
                  <.icon name="hero-x-mark" class="w-3 h-3" />
                </button>
              </span>
            </td>
            <td class="text-right">
              <button
                :if={NodeManager.granted?(@operations, "Namespace.unbind_role")}
                phx-click="confirm_unbind"
                phx-value-principal={binding[:principal]}
                phx-value-namespace={binding[:namespace]}
                data-testid={"unbind-binding-#{binding[:principal]}"}
                class="text-xs text-danger-text hover:text-danger transition-colors"
              >
                Remove binding
              </button>
            </td>
          </tr>
        </tbody>
      </table>
    <% end %>
  </.panel>

  <%!-- Tokens; never the token itself --%>
  <.panel
    fold="tokens"
    open={@sections["tokens"]}
    testid="tokens-panel"
    icon="hero-identification"
    class="overflow-hidden"
  >
    <:title>Tokens ({length(@tokens)})</:title>
    <:actions>
      <button
        :if={NodeManager.granted?(@operations, "Namespace.issue_token")}
        phx-click="open_issue"
        data-testid="issue-token-btn"
        class="flz-button flz-button--sm flz-button--secondary"
      >
        <.icon name="hero-plus" class="w-3.5 h-3.5" /> Issue
      </button>
    </:actions>
    <.runtime_error error={@tokens_error} action="the token listing" />
    <.empty_state :if={@tokens == [] and is_nil(@tokens_error)} icon="hero-identification">
      No token is issued for this namespace.
    </.empty_state>
    <table :if={@tokens != []} class="flz-table">
      <thead>
        <tr>
          <th>Id</th>
          <th>Principal</th>
          <th>Role</th>
          <th>Label</th>
          <th>Status</th>
          <th></th>
        </tr>
      </thead>
      <tbody>
        <tr :for={row <- @tokens} data-testid={"token-#{row.id}"}>
          <td class="flz-num text-xs">{row.id}</td>
          <td class="flz-num text-xs">{row.principal}</td>
          <td class="text-xs">{row.role}</td>
          <td class="text-xs">{row[:label] || "—"}</td>
          <td class="text-xs" data-testid={"token-status-#{row.id}"}>{row.status}</td>
          <td class="text-right">
            <button
              :if={
                row.status == :active and
                  NodeManager.granted?(@operations, "Namespace.revoke_token")
              }
              phx-click="confirm_revoke"
              phx-value-id={row.id}
              data-testid={"revoke-token-#{row.id}"}
              class="text-xs text-danger-text hover:text-danger transition-colors"
            >
              Revoke
            </button>
          </td>
        </tr>
      </tbody>
    </table>
  </.panel>

  <%!-- Relays panel --%>
  <.panel icon="hero-cpu-chip" class="overflow-hidden">
    <:title>Relays ({length(@relays)})</:title>
    <%= if @relays == [] do %>
      <.empty_state icon="hero-cpu-chip" testid="no-relays-msg">
        No relays running.
      </.empty_state>
    <% else %>
      <table data-testid="relays-table" class="flz-table">
        <thead>
          <tr>
            <th>Relay ID</th>
            <th>Health</th>
            <th>Node</th>
            <th>Factory</th>
            <th>Run</th>
            <th>Runner</th>
            <th>Plugins</th>
            <th></th>
          </tr>
        </thead>
        <tbody>
          <%= for relay <- @relays do %>
            <tr data-testid={"relay-row-#{relay.id}"}>
              <td class="text-th-primary flz-num text-xs">
                {relay.id}
                <span :if={relay[:partitions]} class="flz-badge ml-1">
                  group {relay.partitions}
                </span>
              </td>
              <td>
                <.health_badge health={relay.health} />
              </td>
              <td class="flz-num text-xs">
                <span :if={relay[:node]}>{relay[:node]}</span>
                <span
                  :if={is_nil(relay[:node])}
                  data-testid={"unplaced-#{relay.id}"}
                  class="text-warning"
                >
                  unplaced
                </span>
              </td>
              <td class="flz-num text-xs">
                {relay[:factory] || "—"}
              </td>
              <td class="flz-num text-xs" data-testid={"relay-run-#{relay.id}"}>
                {Map.get(@runs, to_string(relay.id), "—")}
              </td>
              <td class="flz-num text-xs">
                {relay[:runner] || "—"}
              </td>
              <td class="flz-num text-xs">
                {Map.get(@plugin_counts, to_string(relay.id), 0)}
              </td>
              <td class="text-right flex items-center justify-end gap-3">
                <%!-- A group row is not a relay of its own; its members are
                      listed under the partition groups. --%>
                <a
                  :if={is_nil(relay[:partitions])}
                  data-testid={"view-relay-#{relay.id}"}
                  href={~p"/namespaces/#{@ns}/relays/#{relay.id}"}
                  class="text-sm font-medium text-accent-text hover:text-accent transition-colors"
                >
                  View
                </a>
                <button
                  :if={NodeManager.granted?(@operations, "Relay.stop")}
                  data-testid={"stop-relay-#{relay.id}"}
                  phx-click="confirm_stop"
                  phx-value-relay_id={relay.id}
                  class="text-sm text-danger-text hover:text-danger transition-colors"
                >
                  Stop
                </button>
              </td>
            </tr>
          <% end %>
        </tbody>
      </table>
    <% end %>
  </.panel>

  <%!-- Partition groups panel --%>
  <.panel
    :if={@groups != []}
    fold="partition-groups"
    open={@sections["partition-groups"]}
    testid="partition-groups"
    icon="hero-squares-plus"
    class="overflow-hidden"
  >
    <:title>Partition groups ({length(@groups)})</:title>
    <div :for={group <- @groups} class="border-b border-brd-subtle last:border-b-0">
      <details data-testid={"partition-group-#{group.id}"} class="group">
        <summary class="px-5 py-3 flex items-center gap-3 cursor-pointer hover:bg-surface-hover transition-colors">
          <.icon
            name="hero-chevron-right"
            class="w-3.5 h-3.5 text-th-muted group-open:rotate-90 transition-transform"
          />
          <span class="font-mono text-xs text-th-primary">{group.id}</span>
          <.health_badge health={group.health} />
          <span
            class="text-xs text-th-tertiary font-mono"
            data-testid={"group-members-#{group.id}"}
          >
            {group.partitions} members
          </span>
          <span
            :if={is_map(group.coverage)}
            data-testid={"group-faulted-#{group.id}"}
            class="flz-badge flz-badge--negative"
          >
            <.icon name="hero-exclamation-triangle" class="w-3 h-3" /> coverage faulted
          </span>
          <span :if={group.coverage == :unavailable} class="text-[11px] text-th-muted">
            coverage unavailable on this controller
          </span>
          <button
            :if={NodeManager.granted?(@operations, "Steps.rescale")}
            type="button"
            phx-click="open_rescale"
            phx-value-group={group.id}
            data-testid={"rescale-#{group.id}"}
            class="flz-button flz-button--sm flz-button--secondary ml-auto"
          >
            Rescale
          </button>
        </summary>

        <div :if={is_map(group.coverage)} class="px-5 pb-3">
          <.notice kind={:error} testid={"group-coverage-#{group.id}"}>
            Key-group coverage is broken — traffic for the named groups is lost.
            <span :for={{from, to} <- group.coverage.gaps} class="block font-mono text-xs">
              gap: key groups {from}–{to} are owned by no member
            </span>
            <span
              :for={{key_group, owners} <- group.coverage.overlaps}
              class="block font-mono text-xs"
            >
              overlap: key group {key_group} is claimed by {Enum.join(owners, ", ")}
            </span>
          </.notice>
        </div>

        <table class="flz-table">
          <thead>
            <tr>
              <th>Partition</th>
              <th>Relay</th>
              <th>Key groups</th>
              <th>Runner</th>
              <th>Health</th>
            </tr>
          </thead>
          <tbody>
            <tr :for={member <- group.members}>
              <td class="flz-num text-xs">
                p{member.partition.index}
              </td>
              <td class="flz-num text-xs">
                <.link
                  navigate={~p"/namespaces/#{@ns}/relays/#{member.id}"}
                  class="text-accent-text hover:text-accent transition-colors"
                >
                  {member.id}
                </.link>
              </td>
              <td class="flz-num text-xs">
                {elem(member.partition.range, 0)}–{elem(member.partition.range, 1)}
              </td>
              <td class="flz-num text-xs">
                {member[:runner] || "—"}
              </td>
              <td><.health_badge health={member.health} /></td>
            </tr>
          </tbody>
        </table>
      </details>
    </div>
  </.panel>

  <%!-- Finished relays: retained completions, not live relays --%>
  <.panel
    fold="finished-relays"
    open={@sections["finished-relays"]}
    testid="finished-relays"
    icon="hero-flag"
    class="overflow-hidden"
  >
    <:title>Finished relays ({length(@finished)})</:title>
    <:actions>
      <button
        phx-click="reload_finished"
        data-testid="reload-finished"
        disabled={@finished_loading?}
        class="flz-button flz-button--sm flz-button--secondary"
      >
        Reload
      </button>
    </:actions>
    <.runtime_error
      :if={@finished_error}
      error={@finished_error}
      action="the finished-relay listing"
      class="m-5"
    />
    <p
      :if={@finished_loading?}
      data-testid="finished-loading"
      class="px-5 py-3 text-xs text-th-muted"
    >
      Reading finished relays from the controller…
    </p>
    <%= if @finished == [] and is_nil(@finished_error) and not @finished_loading? do %>
      <.empty_state icon="hero-check-circle">
        No steps relay has finished inside its retention window.
      </.empty_state>
    <% else %>
      <table class="flz-table">
        <thead>
          <tr>
            <th>Relay</th>
            <th>Status</th>
            <th>Finished at</th>
          </tr>
        </thead>
        <tbody>
          <tr
            :for={relay <- @finished}
            data-testid={"finished-row-#{relay.id}"}
          >
            <td class="flz-num text-xs">
              <.link
                navigate={~p"/namespaces/#{@ns}/relays/#{relay.id}"}
                class="text-accent-text hover:text-accent transition-colors"
              >
                {relay.id}
              </.link>
            </td>
            <td class="flz-num text-xs">{relay[:status] || "—"}</td>
            <td class="flz-num text-xs">
              {Format.token_expiry(relay[:finished_at])}
            </td>
          </tr>
        </tbody>
      </table>
    <% end %>
  </.panel>

  <%!-- Runners panel --%>
  <.panel
    fold="runners"
    open={@sections["runners"]}
    testid="runners-panel"
    icon="hero-server-stack"
    class="overflow-hidden"
  >
    <:title>Runners ({length(@runners)})</:title>
    <%= if @runners == [] do %>
      <.empty_state icon="hero-server-stack">No runners connected.</.empty_state>
    <% else %>
      <ul class="divide-y divide-brd-subtle">
        <%= for runner <- @runners do %>
          <li class="px-5 py-3 text-th-secondary font-mono text-xs">
            {NodeManager.identifier_id(runner)}
            <span
              data-testid={"os-pid-#{NodeManager.identifier_id(runner)}"}
              class="text-th-tertiary ml-2"
            >
              pid {runner[:pid] || "—"}
            </span>
          </li>
        <% end %>
      </ul>
    <% end %>
  </.panel>
</div>

<.launcher_dialog launcher={@launcher} />

<.confirm_dialog
  :if={@confirm_stop}
  title="Stop Relay?"
  confirm_label="Stop"
  on_confirm="stop_relay"
  on_cancel="cancel_stop"
  values={%{"relay_id" => @confirm_stop}}
  testid="stop-confirm-modal"
  cancel_testid="stop-cancel-btn"
  confirm_testid="stop-confirm-btn"
>
  Are you sure you want to stop <.mono>{@confirm_stop}</.mono>?
</.confirm_dialog>

<.dialog :if={@rescale} testid="rescale-modal" size="confirm">
  <h3 class="flz-modal-title mb-3">Rescale partition group</h3>
  <p class="text-sm text-th-secondary mb-4">
    Set the member count for <.mono>{@rescale.group}</.mono>. Key ranges are redistributed across
    the new member set, and the group re-renders on the next tick.
  </p>
  <form phx-change="select_rescale" class="mb-4">
    <.input
      type="number"
      name="rescale[target]"
      label="Target members"
      value={@rescale.target}
      min="1"
      data-testid="rescale-target"
    />
  </form>
  <div class="flex justify-end gap-3">
    <.button variant="ghost" phx-click="cancel_rescale" data-testid="rescale-cancel-btn">
      Cancel
    </.button>
    <.button phx-click="rescale" data-testid="rescale-confirm-btn">
      Rescale to {@rescale.target}
    </.button>
  </div>
</.dialog>

<.dialog :if={@quota_form} testid="quota-modal" size="form" on_close="close_quotas">
  <:title>Edit quotas</:title>

  <div :if={@quota_error} data-testid="quota-error" class="mb-4">
    <.runtime_error error={@quota_error} action="the quota change" />
  </div>

  <form phx-change="quota_change" class="space-y-3">
    <.input
      :for={row <- @quotas}
      type="number"
      name={"quota[#{row.limit_key}]"}
      label={to_string(row.limit_key)}
      value={@quota_form[to_string(row.limit_key)]}
      data-testid={"quota-input-#{row.limit_key}"}
    />
  </form>
  <div class="flex justify-end gap-3 pt-4">
    <.button variant="ghost" phx-click="close_quotas">Cancel</.button>
    <.button phx-click="save_quotas" data-testid="quota-save">Save</.button>
  </div>
</.dialog>

<.dialog
  :if={@token_issue}
  testid="issue-token-modal"
  size="form"
  on_close="close_issue"
  close_testid="issue-token-close"
>
  <:title>Issue a token for {@ns}</:title>

  <%= if @token_issue.issued do %>
    <div data-testid="issued-token" class="space-y-3">
      <.notice icon="hero-exclamation-triangle">
        This token is shown once and kept nowhere. Copy it now; closing this dialog drops it.
      </.notice>
      <p class="text-xs text-th-muted">
        For <span class="font-mono">{@token_issue.issued.principal}</span>
        as {@token_issue.issued.role}, id <span data-testid="issued-token-id" class="font-mono">{@token_issue.issued.id}</span>.
      </p>
      <pre id="issued-token-value" data-testid="issued-token-value" class="flz-code break-all">{@token_issue.issued.token}</pre>
      <div class="flex justify-end gap-3">
        <.button
          variant="secondary"
          phx-click={JS.dispatch("flz:copy", to: "#issued-token-value")}
          data-testid="issued-token-copy"
          icon="hero-clipboard"
        >
          Copy
        </.button>
        <.button phx-click="close_issue" data-testid="issued-token-done">Done</.button>
      </div>
    </div>
  <% else %>
    <.form_error error={@token_issue.error} action="the token issue" testid="issue-token-error" />
    <form phx-submit="issue_token" class="space-y-4">
      <.input
        type="text"
        name="token[principal]"
        label="Principal *"
        value={@token_issue.form["principal"]}
        mono
        data-testid="issue-token-principal"
      />
      <.input
        type="text"
        name="token[role]"
        label="Role *"
        hint="admin, ops, app, viewer or runner"
        value={@token_issue.form["role"]}
        mono
        data-testid="issue-token-role"
      />
      <.input
        type="text"
        name="token[ttl]"
        label="Lifetime"
        hint="seconds, or never"
        value={@token_issue.form["ttl"]}
        mono
        data-testid="issue-token-ttl"
      />
      <.input
        type="text"
        name="token[label]"
        label="Label"
        hint="optional"
        value={@token_issue.form["label"]}
        data-testid="issue-token-label"
      />
      <div class="flex justify-end gap-3 pt-2">
        <.button variant="ghost" phx-click="close_issue" data-testid="issue-token-cancel">
          Cancel
        </.button>
        <.button type="submit" data-testid="issue-token-submit">Issue</.button>
      </div>
    </form>
  <% end %>
</.dialog>

<.confirm_dialog
  :if={@confirm_revoke}
  title="Revoke token?"
  confirm_label="Revoke"
  on_confirm="revoke_token"
  on_cancel="cancel_revoke"
  values={%{"id" => @confirm_revoke.id}}
  testid="revoke-token-modal"
  cancel_testid="revoke-token-cancel"
  confirm_testid="revoke-token-confirm"
>
  Revoke token
  <.mono>{@confirm_revoke.id}</.mono>
  of <.mono>{@confirm_revoke.principal}</.mono>? Whoever holds it can no longer use it.
</.confirm_dialog>

<.dialog :if={@role_bind} testid="bind-role-modal" size="form" on_close="close_bind">
  <:title>Bind a role in {@ns}</:title>
  <.form_error error={@role_bind.error} action="the bind" testid="bind-role-error" />
  <form phx-submit="bind_role" class="space-y-4">
    <.input
      type="text"
      name="binding[principal]"
      label="Principal *"
      value={@role_bind.form["principal"]}
      mono
      data-testid="bind-role-principal"
    />
    <.input
      type="text"
      name="binding[role]"
      label="Role *"
      hint="admin, ops, app or viewer"
      value={@role_bind.form["role"]}
      mono
      data-testid="bind-role-role"
    />
    <div class="flex justify-end gap-3 pt-2">
      <.button variant="ghost" phx-click="close_bind" data-testid="bind-role-cancel">
        Cancel
      </.button>
      <.button type="submit" data-testid="bind-role-submit">Bind</.button>
    </div>
  </form>
</.dialog>

<.confirm_dialog
  :if={@confirm_unbind}
  title={if @confirm_unbind.role, do: "Unbind role?", else: "Remove binding?"}
  confirm_label={if @confirm_unbind.role, do: "Unbind", else: "Remove"}
  on_confirm="unbind_role"
  on_cancel="cancel_unbind"
  values={%{"principal" => @confirm_unbind.principal, "role" => @confirm_unbind.role || ""}}
  testid="unbind-role-modal"
  cancel_testid="unbind-role-cancel"
  confirm_testid="unbind-role-confirm"
>
  <%= if @confirm_unbind.role do %>
    Take
    <.mono>{@confirm_unbind.role}</.mono>
    away from
    <.mono>{@confirm_unbind.principal}</.mono>
    in <.mono>{@confirm_unbind.namespace}</.mono>? Its other roles stay.
  <% else %>
    Remove every role
    <.mono>{@confirm_unbind.principal}</.mono>
    holds in <.mono>{@confirm_unbind.namespace}</.mono>? It can no longer act on this
    controller until it is bound again.
  <% end %>
  <span
    :if={@confirm_unbind.namespace == "_system"}
    class="block mt-2"
    data-testid="unbind-cluster-wide"
  >
    This binding is cluster-wide: it reaches every namespace, not only this one.
  </span>
</.confirm_dialog>
