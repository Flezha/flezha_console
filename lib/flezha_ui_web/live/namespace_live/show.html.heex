<div class="space-y-6">
  <.header mono>
    {@ns}
    <:actions>
      <.button phx-click="launcher_open" data-testid="start-relay-btn" icon="hero-plus">
        Start Relay
      </.button>
    </:actions>
  </.header>

  <.runtime_error error={@load_error} />

  <.fleet_summary topology={@topology} />

  <%!-- Quotas --%>
  <.panel
    fold="quotas"
    open={@sections["quotas"] or @quota_breached}
    forced={@quota_breached}
    testid="quota-panel"
    icon="hero-chart-bar"
    class="overflow-hidden"
  >
    <:title>
      Quotas <span :if={@quota_breached} class="flz-badge flz-badge--negative">breached</span>
    </:title>
    <:actions>
      <button
        :if={@declared}
        phx-click="open_quotas"
        data-testid="edit-quotas-btn"
        class="flz-button flz-button--sm flz-button--secondary"
      >
        Edit
      </button>
    </:actions>
    <p
      :if={is_nil(@declared)}
      data-testid="namespace-undeclared"
      class="px-5 py-3 text-xs text-th-muted"
    >
      This namespace has a running hub but no declaration, so no limits apply to its counters.
    </p>
    <table class="flz-table">
      <tbody>
        <tr
          :for={row <- @quotas}
          data-testid={"quota-#{row.kind}"}
          class="last:border-b-0"
        >
          <td class="flz-num text-xs w-48">{row.kind}</td>
          <td class="text-th-primary flz-num text-xs w-32">{row.value || "—"}</td>
          <td>
            <div :if={row.limit} class="flex items-center gap-2">
              <div class="h-1.5 w-40 rounded-full bg-surface-input overflow-hidden">
                <div
                  class={[
                    "h-full rounded-full",
                    if(row.breached?, do: "bg-danger", else: "bg-accent")
                  ]}
                  style={"width: #{min(100, round((row.value || 0) * 100 / max(row.limit, 1)))}%"}
                >
                </div>
              </div>
              <span class="text-[11px] text-th-muted font-mono">of {row.limit}</span>
              <span
                :if={row.breached?}
                data-testid={"quota-breached-#{row.kind}"}
                class="flz-badge flz-badge--negative"
              >
                breached
              </span>
            </div>
            <span
              :if={is_nil(row.limit)}
              data-testid={"quota-unset-#{row.kind}"}
              class="text-[11px] text-th-muted"
            >
              no limit applies
            </span>
          </td>
        </tr>
      </tbody>
    </table>
  </.panel>

  <%!-- Role bindings, read-only --%>
  <.panel
    fold="role-bindings"
    open={@sections["role-bindings"]}
    testid="role-bindings"
    icon="hero-key"
    class="overflow-hidden"
  >
    <:title>Role bindings ({length(@role_bindings)})</:title>
    <%= if @role_bindings == [] do %>
      <.empty_state icon="hero-key" testid="role-bindings-empty">
        No principal is bound to this namespace.
        <:detail>Bind one with <code class="font-mono">flz role bind</code>.</:detail>
      </.empty_state>
    <% else %>
      <table class="flz-table">
        <tbody>
          <tr
            :for={binding <- @role_bindings}
            data-testid={"role-binding-#{binding[:principal]}"}
            class="last:border-b-0"
          >
            <td class="text-th-primary flz-num text-xs">{binding[:principal]}</td>
            <td class="flz-num text-xs">{Enum.join(binding[:roles] || [], ", ")}</td>
          </tr>
        </tbody>
      </table>
    <% end %>
  </.panel>

  <%!-- Relays panel --%>
  <.panel icon="hero-cpu-chip" class="overflow-hidden">
    <:title>Relays ({length(@relays)})</:title>
    <%= if @relays == [] do %>
      <.empty_state icon="hero-cpu-chip" testid="no-relays-msg">
        No relays running.
      </.empty_state>
    <% else %>
      <table data-testid="relays-table" class="flz-table">
        <thead>
          <tr>
            <th>Relay ID</th>
            <th>Health</th>
            <th>Node</th>
            <th>Factory</th>
            <th>Run</th>
            <th>Runner</th>
            <th>Plugins</th>
            <th></th>
          </tr>
        </thead>
        <tbody>
          <%= for relay <- @relays do %>
            <tr data-testid={"relay-row-#{relay.id}"}>
              <td class="text-th-primary flz-num text-xs">
                {relay.id}
                <span :if={relay[:partitions]} class="flz-badge ml-1">
                  group {relay.partitions}
                </span>
              </td>
              <td>
                <.health_badge health={relay.health} />
              </td>
              <td class="flz-num text-xs">
                <span :if={relay[:node]}>{relay[:node]}</span>
                <span
                  :if={is_nil(relay[:node])}
                  data-testid={"unplaced-#{relay.id}"}
                  class="text-warning"
                >
                  unplaced
                </span>
              </td>
              <td class="flz-num text-xs">
                {relay[:factory] || "—"}
              </td>
              <td class="flz-num text-xs" data-testid={"relay-run-#{relay.id}"}>
                {Map.get(@runs, to_string(relay.id), "—")}
              </td>
              <td class="flz-num text-xs">
                {relay[:runner] || "—"}
              </td>
              <td class="flz-num text-xs">
                {Map.get(@plugin_counts, to_string(relay.id), 0)}
              </td>
              <td class="text-right flex items-center justify-end gap-3">
                <%!-- A group row is not a relay of its own; its members are
                      listed under the partition groups. --%>
                <a
                  :if={is_nil(relay[:partitions])}
                  data-testid={"view-relay-#{relay.id}"}
                  href={~p"/namespaces/#{@ns}/relays/#{relay.id}"}
                  class="text-sm font-medium text-accent-text hover:text-accent transition-colors"
                >
                  View
                </a>
                <button
                  data-testid={"stop-relay-#{relay.id}"}
                  phx-click="confirm_stop"
                  phx-value-relay_id={relay.id}
                  class="text-sm text-danger-text hover:text-danger transition-colors"
                >
                  Stop
                </button>
              </td>
            </tr>
          <% end %>
        </tbody>
      </table>
    <% end %>
  </.panel>

  <%!-- Partition groups panel --%>
  <.panel
    :if={@groups != []}
    fold="partition-groups"
    open={@sections["partition-groups"]}
    testid="partition-groups"
    icon="hero-squares-plus"
    class="overflow-hidden"
  >
    <:title>Partition groups ({length(@groups)})</:title>
    <div :for={group <- @groups} class="border-b border-brd-subtle last:border-b-0">
      <details data-testid={"partition-group-#{group.id}"} class="group">
        <summary class="px-5 py-3 flex items-center gap-3 cursor-pointer hover:bg-surface-hover transition-colors">
          <.icon
            name="hero-chevron-right"
            class="w-3.5 h-3.5 text-th-muted group-open:rotate-90 transition-transform"
          />
          <span class="font-mono text-xs text-th-primary">{group.id}</span>
          <.health_badge health={group.health} />
          <span
            class="text-xs text-th-tertiary font-mono"
            data-testid={"group-members-#{group.id}"}
          >
            {group.partitions} members
          </span>
          <span
            :if={is_map(group.coverage)}
            data-testid={"group-faulted-#{group.id}"}
            class="flz-badge flz-badge--negative"
          >
            <.icon name="hero-exclamation-triangle" class="w-3 h-3" /> coverage faulted
          </span>
          <span :if={group.coverage == :unavailable} class="text-[11px] text-th-muted">
            coverage unavailable on this controller
          </span>
          <button
            type="button"
            phx-click="open_rescale"
            phx-value-group={group.id}
            data-testid={"rescale-#{group.id}"}
            class="flz-button flz-button--sm flz-button--secondary ml-auto"
          >
            Rescale
          </button>
        </summary>

        <div :if={is_map(group.coverage)} class="px-5 pb-3">
          <.notice kind={:error} testid={"group-coverage-#{group.id}"}>
            Key-group coverage is broken — traffic for the named groups is lost.
            <span :for={{from, to} <- group.coverage.gaps} class="block font-mono text-xs">
              gap: key groups {from}–{to} are owned by no member
            </span>
            <span
              :for={{key_group, owners} <- group.coverage.overlaps}
              class="block font-mono text-xs"
            >
              overlap: key group {key_group} is claimed by {Enum.join(owners, ", ")}
            </span>
          </.notice>
        </div>

        <table class="flz-table">
          <thead>
            <tr>
              <th>Partition</th>
              <th>Relay</th>
              <th>Key groups</th>
              <th>Runner</th>
              <th>Health</th>
            </tr>
          </thead>
          <tbody>
            <tr :for={member <- group.members}>
              <td class="flz-num text-xs">
                p{member.partition.index}
              </td>
              <td class="flz-num text-xs">
                <.link
                  navigate={~p"/namespaces/#{@ns}/relays/#{member.id}"}
                  class="text-accent-text hover:text-accent transition-colors"
                >
                  {member.id}
                </.link>
              </td>
              <td class="flz-num text-xs">
                {elem(member.partition.range, 0)}–{elem(member.partition.range, 1)}
              </td>
              <td class="flz-num text-xs">
                {member[:runner] || "—"}
              </td>
              <td><.health_badge health={member.health} /></td>
            </tr>
          </tbody>
        </table>
      </details>
    </div>
  </.panel>

  <%!-- Finished relays: retained completions, not live relays --%>
  <.panel
    fold="finished-relays"
    open={@sections["finished-relays"]}
    testid="finished-relays"
    icon="hero-flag"
    class="overflow-hidden"
  >
    <:title>Finished relays ({length(@finished)})</:title>
    <:actions>
      <button
        phx-click="reload_finished"
        data-testid="reload-finished"
        disabled={@finished_loading?}
        class="flz-button flz-button--sm flz-button--secondary"
      >
        Reload
      </button>
    </:actions>
    <.runtime_error
      :if={@finished_error}
      error={@finished_error}
      action="the finished-relay listing"
      class="m-5"
    />
    <p
      :if={@finished_loading?}
      data-testid="finished-loading"
      class="px-5 py-3 text-xs text-th-muted"
    >
      Reading finished relays from the controller…
    </p>
    <%= if @finished == [] and is_nil(@finished_error) and not @finished_loading? do %>
      <.empty_state icon="hero-check-circle">
        No steps relay has finished inside its retention window.
      </.empty_state>
    <% else %>
      <table class="flz-table">
        <thead>
          <tr>
            <th>Relay</th>
            <th>Status</th>
            <th>Finished at</th>
          </tr>
        </thead>
        <tbody>
          <tr
            :for={relay <- @finished}
            data-testid={"finished-row-#{relay.id}"}
          >
            <td class="flz-num text-xs">
              <.link
                navigate={~p"/namespaces/#{@ns}/relays/#{relay.id}"}
                class="text-accent-text hover:text-accent transition-colors"
              >
                {relay.id}
              </.link>
            </td>
            <td class="flz-num text-xs">{relay[:status] || "—"}</td>
            <td class="flz-num text-xs">
              {Format.token_expiry(relay[:finished_at])}
            </td>
          </tr>
        </tbody>
      </table>
    <% end %>
  </.panel>

  <%!-- Runners panel --%>
  <.panel
    fold="runners"
    open={@sections["runners"]}
    testid="runners-panel"
    icon="hero-server-stack"
    class="overflow-hidden"
  >
    <:title>Runners ({length(@runners)})</:title>
    <%= if @runners == [] do %>
      <.empty_state icon="hero-server-stack">No runners connected.</.empty_state>
    <% else %>
      <ul class="divide-y divide-brd-subtle">
        <%= for runner <- @runners do %>
          <li class="px-5 py-3 text-th-secondary font-mono text-xs">
            {NodeManager.identifier_id(runner)}
          </li>
        <% end %>
      </ul>
    <% end %>
  </.panel>
</div>

<.launcher_dialog launcher={@launcher} />

<.confirm_dialog
  :if={@confirm_stop}
  title="Stop Relay?"
  confirm_label="Stop"
  on_confirm="stop_relay"
  on_cancel="cancel_stop"
  values={%{"relay_id" => @confirm_stop}}
  testid="stop-confirm-modal"
  cancel_testid="stop-cancel-btn"
  confirm_testid="stop-confirm-btn"
>
  Are you sure you want to stop <.mono>{@confirm_stop}</.mono>?
</.confirm_dialog>

<.dialog :if={@rescale} testid="rescale-modal" size="confirm">
  <h3 class="flz-modal-title mb-3">Rescale partition group</h3>
  <p class="text-sm text-th-secondary mb-4">
    Set the member count for <.mono>{@rescale.group}</.mono>. Key ranges are redistributed across
    the new member set, and the group re-renders on the next tick.
  </p>
  <form phx-change="select_rescale" class="mb-4">
    <.input
      type="number"
      name="rescale[target]"
      label="Target members"
      value={@rescale.target}
      min="1"
      data-testid="rescale-target"
    />
  </form>
  <div class="flex justify-end gap-3">
    <.button variant="ghost" phx-click="cancel_rescale" data-testid="rescale-cancel-btn">
      Cancel
    </.button>
    <.button phx-click="rescale" data-testid="rescale-confirm-btn">
      Rescale to {@rescale.target}
    </.button>
  </div>
</.dialog>

<.dialog :if={@quota_form} testid="quota-modal" size="form" on_close="close_quotas">
  <:title>Edit quotas</:title>

  <div :if={@quota_error} data-testid="quota-error" class="mb-4">
    <.runtime_error error={@quota_error} action="the quota change" />
  </div>

  <form phx-change="quota_change" class="space-y-3">
    <.input
      :for={row <- @quotas}
      type="number"
      name={"quota[#{row.limit_key}]"}
      label={to_string(row.limit_key)}
      value={@quota_form[to_string(row.limit_key)]}
      data-testid={"quota-input-#{row.limit_key}"}
    />
  </form>
  <div class="flex justify-end gap-3 pt-4">
    <.button variant="ghost" phx-click="close_quotas">Cancel</.button>
    <.button phx-click="save_quotas" data-testid="quota-save">Save</.button>
  </div>
</.dialog>
