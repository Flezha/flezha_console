<% flow = @topology_state.history |> Map.values() |> Topology.sum_history() %>
<% inbound = if flow != [], do: Topology.relay_rates(flow) %>
<% {condition, headline} = headline(@topology || %{state: :loading}, @items, inbound, @ns) %>
<.page_header eyebrow="Namespace" title={@ns} headline>
  <:sentence>
    <span data-testid="home-headline" data-condition={condition}>{headline}</span>
  </:sentence>
  <:figures :if={@loaded? and condition not in [:unreachable]}>
    <span data-testid="home-figures">
      {figures(@topology || %{}, @rows, inbound)}
    </span>
  </:figures>
  <:actions>
    <.button
      :if={NodeManager.granted?(@operations, "Relay.start")}
      phx-click="launcher_open"
      data-testid="start-relay-btn"
      icon="hero-plus"
    >
      Start relay
    </.button>
  </:actions>
</.page_header>

<%!-- Tells the tick when the tab is hidden, so a background tab reads nothing --%>
<div id="home-visibility" phx-hook="FlzVisibility" hidden></div>

<.runtime_error error={@load_error} action="the relay listing" />

<%= if condition == :unreachable do %>
  <div class="mt-6" data-testid="topology-disconnected">
    <.runtime_error error={:node_not_connected} />
  </div>
<% else %>
  <%!-- Everything the operator reaches, from the shell pulse --%>
  <.section
    testid="home-system"
    help="Everything your token reaches, across every namespace. Read with the shell's check every 10 seconds."
  >
    <:title>System</:title>
    <:actions :if={@shell_pulse}>
      <span class="fui-figures" data-testid="home-system-checked">
        Read at {Format.time_of_day(@shell_pulse.checked_at)}
      </span>
    </:actions>
    <.skeleton :if={is_nil(@shell_pulse)} rows={2} testid="home-system-loading" />
    <div :if={@shell_pulse} class="fui-indicators" data-testid="home-system-tiles">
      <% fleet = @shell_pulse.fleet %>
      <.tile
        testid="sys-namespaces"
        icon="hero-rectangle-stack"
        label="Namespaces"
        value={fleet.namespaces}
        condition="Reachable with your token"
        href={~p"/namespaces"}
      >
        <:foot>You are in {@ns}</:foot>
      </.tile>
      <% {nodes_tone, nodes_verdict, nodes_condition} = nodes_said(fleet[:nodes]) %>
      <.tile
        testid="sys-nodes"
        icon="hero-server-stack"
        label="Controller nodes"
        value={fleet[:nodes] && length(fleet.nodes)}
        tone={nodes_tone}
        verdict={nodes_verdict}
        condition={nodes_condition}
        href={~p"/cluster"}
      />
      <% {sys_runners_tone, sys_runners_verdict} =
        runners_said(fleet[:runners], health_total(fleet.health)) %>
      <.tile
        testid="sys-runners"
        icon="hero-cube"
        label="Runners"
        value={fleet[:runners]}
        tone={sys_runners_tone}
        verdict={sys_runners_verdict}
        condition={(fleet[:runners] && "Connected across the cluster") || "Not read yet"}
        href={~p"/cluster"}
      >
        <:foot>{length(@runners)} in {@ns}</:foot>
      </.tile>
      <% {relays_tone, relays_verdict, relays_condition} = health_said(fleet.health) %>
      <.tile
        testid="sys-relays"
        icon="hero-cpu-chip"
        label="Relays"
        value={health_total(fleet.health)}
        tone={relays_tone}
        verdict={relays_verdict}
        condition={relays_condition}
        href={~p"/relays"}
      >
        <.strip counts={fleet.health} testid="sys-relays-strip" />
        <:foot :if={@topology[:relay_count]}>{@topology.relay_count} in {@ns}</:foot>
      </.tile>
      <% {problems_tone, problems_verdict, problems_condition} =
        problems_said(@shell_pulse.items) %>
      <.tile
        testid="sys-problems"
        icon="hero-exclamation-triangle"
        label="Open problems"
        value={length(@shell_pulse.items)}
        tone={problems_tone}
        verdict={problems_verdict}
        condition={problems_condition}
        href={~p"/problems"}
      >
        <:foot>{length(@items)} in {@ns}</:foot>
      </.tile>
      <% {controller_tone, controller_value, controller_condition} =
        controller_said(NodeManager.connected_node(), fleet) %>
      <.tile
        testid="sys-controller"
        icon="hero-server"
        label="Controller"
        value={controller_value}
        tone={controller_tone}
        condition={controller_condition}
        href={~p"/controller"}
      />
    </div>
  </.section>

  <%!-- This namespace, from this screen's own tick --%>
  <.section
    testid="home-namespace"
    help="This namespace: its relays and their health, what serves them, what flows through them and how close each limit is. Read every 2 seconds."
  >
    <:title>
      <span class="fui-eyebrow">Namespace</span>
      <span class="fui-section-name" data-testid="home-namespace-name">{@ns}</span>
    </:title>
    <.skeleton :if={!@loaded?} rows={2} testid="home-namespace-loading" />
    <%= cond do %>
      <% !@loaded? -> %>
      <% condition == :empty -> %>
        <.empty_state icon="hero-squares-plus" testid="topology-empty">
          A <.term key="runner" /> is an SDK process that serves factories, and a
          <.term key="relay" /> is started from one of those factories and runs on its runner.
          Nothing runs in {@ns} yet: a runner must connect before a relay can run.
          <:action :if={NodeManager.granted?(@operations, "Relay.start")}>
            <.button phx-click="launcher_open" size="sm" data-testid="start-relay-empty-btn">
              Start relay
            </.button>
          </:action>
        </.empty_state>
      <% true -> %>
        <div class="fui-indicators" data-testid="home-namespace-tiles">
          <% health = Enum.map(@topology.health, &{&1.health, &1.count}) %>
          <% {relays_tone, relays_verdict, relays_condition} = health_said(health) %>
          <.tile
            testid="ns-relays"
            icon="hero-cpu-chip"
            label="Relays"
            value={@topology.relay_count}
            tone={relays_tone}
            verdict={relays_verdict}
            condition={relays_condition}
          >
            <.strip counts={health} testid="ns-relays-strip" />
            <span class="fui-indicator-links">
              <.link
                :for={bucket <- @topology.health}
                :if={bucket.health != :healthy}
                navigate={bucket.href}
                data-testid={"ns-relays-#{bucket.health}"}
              >
                {bucket.count} {String.downcase(Words.text(:health, bucket.health))}
              </.link>
              <.link navigate={~p"/namespaces/#{@ns}/relays"} data-testid="ns-relays-all">
                List them
              </.link>
            </span>
          </.tile>
          <% {runners_tone, runners_verdict} = runners_said(length(@runners), length(@rows)) %>
          <.tile
            testid="ns-runners"
            icon="hero-cube"
            label="Runners"
            value={length(@runners)}
            tone={runners_tone}
            verdict={runners_verdict}
            condition={runners_digest(@runners, @runner_marks)}
            href={~p"/cluster"}
          >
            <:foot>{runners_foot(@rows)}</:foot>
          </.tile>
          <% plugins = plugin_count(@plugin_pairs) %>
          <.tile
            testid="ns-plugins"
            icon="hero-puzzle-piece"
            label="Plugins"
            value={plugins}
            condition={plugins_condition(@plugin_pairs)}
            href={~p"/namespaces/#{@ns}/plugins"}
          >
            <:foot :if={plugins > 0}>{plugin_names(@plugin_pairs)}</:foot>
          </.tile>
          <.tile
            testid="ns-schedules"
            icon="hero-clock"
            label="Schedules"
            value={length(@schedules)}
            condition={schedules_condition(@schedules)}
            href={~p"/namespaces/#{@ns}/schedules"}
          >
            <:foot :if={@schedules != []}>{schedules_armed(@schedules)}</:foot>
          </.tile>
          <% {parked_tone, parked_verdict, parked_condition} = parked_said(@topology.parked) %>
          <.tile
            testid="ns-parked"
            icon="hero-inbox-stack"
            label="Dead letters"
            value={@topology.parked}
            tone={parked_tone}
            verdict={parked_verdict}
            condition={parked_condition}
            href={~p"/dlq"}
          >
            <:foot>
              {(@topology.parked > 0 && "Replay or drop them on the queue") ||
                "The queue is empty"}
            </:foot>
          </.tile>
          <% {flow_tone, flow_verdict, flow_condition} = flow_said(inbound) %>
          <.tile
            testid="ns-flow"
            icon="hero-arrow-trending-up"
            label="Flow in"
            value={inbound && Topology.rate_label(inbound.in, "")}
            unit="msgs/s"
            tone={flow_tone}
            verdict={flow_verdict}
            condition={flow_condition}
            live
          >
            <:edge>
              <.sparkline
                samples={flow}
                key={:in}
                width={160}
                height={40}
                area
                testid="ns-flow-spark"
                label="Inbound rate history"
              />
            </:edge>
            <:foot :if={inbound}>Out {Topology.rate_label(inbound[:out] || 0.0)}</:foot>
          </.tile>
          <% limits = limit_rows(@quotas) %>
          <.tile
            testid="ns-limits"
            icon="hero-adjustments-horizontal"
            label="Limits"
            value={peak_use(limits)}
            tone={(@quota_breached && :negative) || :neutral}
            verdict={if @quota_breached, do: Words.text(:quota, :breached)}
            live
            condition={limits_digest(@quotas, @declared)}
          >
            <span :if={limits != []} class="fui-indicator-meters">
              <span :for={row <- Enum.take(limits, 2)} data-testid={"ns-limit-#{row.kind}"}>
                {Words.humanize(row.kind)} · {limit_use(row)}
                <.meter
                  value={row.value}
                  max={row.limit}
                  tone={row.breached? && :negative}
                  label={"#{Words.humanize(row.kind)}: #{limit_use(row)}"}
                />
              </span>
            </span>
            <:foot>
              <.link
                href="#quotas"
                phx-click="section_reveal"
                phx-value-key="quotas"
                data-testid="ns-limits-more"
              >
                {limits_more(limits)}
              </.link>
            </:foot>
          </.tile>
        </div>
    <% end %>
  </.section>

  <%!-- The namespace's problems, worst first --%>
  <.section :if={@items != []} testid="home-attention">
    <:title>{attention_title(@items)}</:title>
    <.problem_list
      items={@items}
      operations={@operations}
      diagnoses={@diagnoses}
      limit={problems_shown()}
      testid="home-problems"
    />
  </.section>
<% end %>

<%!-- What this console saw happen --%>
<.section
  testid="home-river"
  help="Relays starting and stopping, runners connecting and leaving, and problems appearing or clearing, newest on the right. It starts when this screen opens."
>
  <:title>What happened</:title>
  <.river events={@river} error={@river_error} />
</.section>

<%!-- Limits --%>
<.section
  fold="quotas"
  open={@sections["quotas"] or @quota_breached}
  forced={@quota_breached}
  testid="quota-panel"
  digest={limits_digest(@quotas, @declared)}
  help="Caps on what this namespace may hold, such as how many relays run at once, beside how much of each is used. Reaching a limit refuses new starts until something stops."
>
  <:title>
    Limits <.state_badge :if={@quota_breached} kind={:quota} value={:breached} />
  </:title>
  <:actions>
    <.button
      :if={@declared != nil and NodeManager.granted?(@operations, "Namespace.set_quotas")}
      variant="secondary"
      size="sm"
      phx-click="open_quotas"
      data-testid="edit-quotas-btn"
    >
      Edit
    </.button>
  </:actions>
  <p :if={is_nil(@declared)} data-testid="namespace-undeclared" class="fui-figures mb-3">
    This namespace has a running hub but no declaration, so no
    <.term key="quota">limits</.term>
    apply to its counters.
  </p>
  <.grid
    paging={@paging}
    id="quota-rows"
    rows={@quotas}
    row_testid={&"quota-#{&1.kind}"}
    row_tone={&quota_tone/1}
  >
    <:col :let={row} label="Counter">{Words.humanize(row.kind)}</:col>
    <:col :let={row} label="In use" num>{row.value || "—"}</:col>
    <:col :let={row} label="Limit">
      <div :if={row.limit} class="flex items-center gap-3">
        <span class="w-40">
          <.meter
            value={row.value}
            max={row.limit}
            tone={row.breached? && :negative}
            label={"#{row.value || 0} of #{row.limit}"}
          />
        </span>
        <span class="fui-ident">of {row.limit}</span>
        <.state_badge
          :if={row.breached?}
          kind={:quota}
          value={:breached}
          testid={"quota-breached-#{row.kind}"}
        />
      </div>
      <span :if={is_nil(row.limit)} data-testid={"quota-unset-#{row.kind}"} class="fui-figures">
        No limit applies
      </span>
    </:col>
  </.grid>
</.section>

<%!-- Access: who may act here, and the tokens they act with --%>
<.section
  fold="access"
  open={@sections["access"]}
  testid="access-panel"
  digest={access_digest(@role_bindings, @tokens)}
  help="Who may do what here. A principal is an identity; a role bound to it decides what it may do in this namespace; a token is the credential a principal calls with."
>
  <:title>Access</:title>
  <div class="space-y-8">
    <div data-testid="role-bindings" class="space-y-3">
      <div class="flex items-center justify-between gap-3">
        <h3 class="fui-eyebrow">Role bindings</h3>
        <.button
          :if={NodeManager.granted?(@operations, "Namespace.bind_role")}
          variant="secondary"
          size="sm"
          icon="hero-plus"
          phx-click="open_bind"
          data-testid="bind-role-btn"
        >
          Bind
        </.button>
      </div>
      <.empty_state :if={@role_bindings == []} icon="hero-key" testid="role-bindings-empty">
        A <.term key="role" /> binding lets a <.term key="principal" />
        act in this namespace. None is bound yet.
        <:action :if={NodeManager.granted?(@operations, "Namespace.bind_role")}>
          <.button size="sm" phx-click="open_bind" data-testid="bind-role-empty-btn">
            Bind one
          </.button>
        </:action>
      </.empty_state>
      <.grid
        :if={@role_bindings != []}
        paging={@paging}
        id="role-bindings-grid"
        rows={@role_bindings}
        row_testid={&"role-binding-#{&1[:principal]}"}
      >
        <:col :let={binding} label="Principal"><.ident value={binding[:principal]} full /></:col>
        <:col :let={binding} label="Roles">
          <span class="flex flex-wrap gap-1">
            <.chip
              :for={role <- binding[:roles] || []}
              mono
              testid={"role-#{binding[:principal]}-#{role}"}
            >
              {role}
            </.chip>
          </span>
        </:col>
        <:col :let={binding} label="Scope">
          {if binding[:namespace] == "_system", do: "Cluster-wide", else: binding[:namespace]}
        </:col>
        <:col :let={binding} label="Last bound">
          <.moment at={binding[:bound_at]} testid={"binding-bound-#{binding[:principal]}"} />
        </:col>
        <:col :let={binding} label="Bound by">
          <.ident
            value={binding[:bound_by] || "—"}
            full
            testid={"binding-by-#{binding[:principal]}"}
          />
        </:col>
        <:menu :let={binding}>
          <.row_menu
            :if={NodeManager.granted?(@operations, "Namespace.unbind_role")}
            id={"binding-menu-#{binding[:principal]}"}
            label={"Actions for #{binding[:principal]}"}
            testid={"binding-menu-#{binding[:principal]}"}
          >
            <:item
              :for={role <- binding[:roles] || []}
              click="confirm_unbind"
              values={
                %{principal: binding[:principal], namespace: binding[:namespace], role: role}
              }
              testid={"unbind-role-#{binding[:principal]}-#{role}"}
              danger
            >
              Unbind {role}
            </:item>
            <:item
              click="confirm_unbind"
              values={%{principal: binding[:principal], namespace: binding[:namespace]}}
              testid={"unbind-binding-#{binding[:principal]}"}
              danger
            >
              Remove binding
            </:item>
          </.row_menu>
        </:menu>
      </.grid>
    </div>

    <%!-- Tokens; never the token itself --%>
    <div data-testid="tokens-panel" class="space-y-3">
      <div class="flex items-center justify-between gap-3">
        <h3 class="fui-eyebrow">Tokens</h3>
        <.button
          :if={NodeManager.granted?(@operations, "Namespace.issue_token")}
          variant="secondary"
          size="sm"
          icon="hero-plus"
          phx-click="open_issue"
          data-testid="issue-token-btn"
        >
          Issue
        </.button>
      </div>
      <.runtime_error error={@tokens_error} action="the token listing" />
      <.empty_state :if={@tokens == [] and is_nil(@tokens_error)} icon="hero-identification">
        A token is how a principal proves who it is. None is issued for this namespace.
      </.empty_state>
      <% listed_tokens = tokens_with_status(@tokens, @token_status) %>
      <.segmented :if={@tokens != []} label="Token status" testid="token-status-filter">
        <:option
          :for={{value, label, count} <- token_choices(@tokens)}
          click="token_status"
          value={value}
          current={@token_status == value}
          testid={"token-filter-#{value}"}
        >
          {label} <span class="fui-figures">{count}</span>
        </:option>
      </.segmented>
      <p
        :if={@tokens != [] and listed_tokens == []}
        class="fui-figures"
        data-testid="tokens-none-match"
      >
        No token has this status.
      </p>
      <.grid
        :if={listed_tokens != []}
        paging={@paging}
        id="tokens-grid"
        rows={listed_tokens}
        row_testid={&"token-#{&1.id}"}
      >
        <:col :let={row} label="Token"><.ident value={row.id} /></:col>
        <:col :let={row} label="Principal"><.ident value={row.principal} full /></:col>
        <:col :let={row} label="Role">{row.role}</:col>
        <:col :let={row} label="Label">{row[:label] || "—"}</:col>
        <:col :let={row} label="Issued">
          <.moment at={row[:created_at]} testid={"token-issued-#{row.id}"} />
        </:col>
        <:col :let={row} label="Issued by">
          <.ident value={row[:created_by] || "—"} full testid={"token-issuer-#{row.id}"} />
        </:col>
        <:col :let={row} label="Expires">
          <span :if={row[:expires_at] == :never} data-testid={"token-expires-#{row.id}"}>
            never
          </span>
          <.moment
            :if={row[:expires_at] != :never}
            at={row[:expires_at]}
            tone={expiry_tone(row)}
            testid={"token-expires-#{row.id}"}
          />
        </:col>
        <:col :let={row} label="Status">
          <.state_badge kind={:token_status} value={row.status} testid={"token-status-#{row.id}"} />
          <.moment
            :if={is_integer(row[:revoked_at])}
            at={row.revoked_at}
            testid={"token-revoked-#{row.id}"}
          />
        </:col>
        <:menu :let={row}>
          <.row_menu
            :if={
              row.status == :active and
                NodeManager.granted?(@operations, "Namespace.revoke_token")
            }
            id={"token-menu-#{row.id}"}
            label={"Actions for token #{row.id}"}
            testid={"token-menu-#{row.id}"}
          >
            <:item
              click="confirm_revoke"
              values={%{id: row.id}}
              testid={"revoke-token-#{row.id}"}
              danger
            >
              Revoke
            </:item>
          </.row_menu>
        </:menu>
      </.grid>
    </div>
  </div>
</.section>

<%!-- Partition groups --%>
<.section
  :if={@groups != []}
  fold="partition-groups"
  open={@sections["partition-groups"]}
  testid="partition-groups"
  digest={groups_digest(@groups)}
  help="Relays that split one stream of keys between them, each owning a range. Coverage says whether every key has exactly one owner."
>
  <:title>Partition groups</:title>
  <div class="space-y-6">
    <div :for={group <- @groups} data-testid={"partition-group-#{group.id}"} class="space-y-3">
      <div class="flex flex-wrap items-center gap-3">
        <span class="fui-ident">{group.id}</span>
        <.state_badge value={group.health} />
        <span class="fui-figures" data-testid={"group-members-#{group.id}"}>
          {group.partitions} members
        </span>
        <span :if={is_map(group.coverage)} data-testid={"group-faulted-#{group.id}"}>
          <span class="fui-badge fui-badge--negative">
            <span class="fui-shape" data-shape="cross" aria-hidden="true"></span>
            <.term key="coverage" id={"coverage-#{group.id}"}>Coverage</.term>
            faulted
          </span>
        </span>
        <span :if={group.coverage == :unavailable} class="fui-figures">
          Coverage is unavailable on this controller.
        </span>
        <.button
          :if={NodeManager.granted?(@operations, "Steps.rescale")}
          variant="secondary"
          size="sm"
          phx-click="open_rescale"
          phx-value-group={group.id}
          data-testid={"rescale-#{group.id}"}
          class="ml-auto"
        >
          Rescale
        </.button>
      </div>
      <.notice :if={is_map(group.coverage)} kind={:error} testid={"group-coverage-#{group.id}"}>
        <p>Key-group coverage is broken: traffic for the named key groups is lost.</p>
        <p :for={{from, to} <- group.coverage.gaps} class="fui-ident">
          Key groups {from}–{to} are owned by no member.
        </p>
        <p :for={{key_group, owners} <- group.coverage.overlaps} class="fui-ident">
          Key group {key_group} is claimed by {Enum.join(owners, ", ")}.
        </p>
      </.notice>
      <.grid
        paging={@paging}
        id={"group-#{group.id}-members"}
        rows={group.members}
        row_tone={&Words.tone(:health, &1.health)}
      >
        <:col :let={member} label="Partition">p{member.partition.index}</:col>
        <:col :let={member} label="Relay">
          <.link navigate={~p"/namespaces/#{@ns}/relays/#{member.id}"}>{member.id}</.link>
        </:col>
        <:col :let={member} label="Key groups" num>
          {Format.key_range(member.partition.range)}
        </:col>
        <:col :let={member} label="Runner">
          <.ident :if={member[:runner]} value={member[:runner]} />
        </:col>
        <:col :let={member} label="Health"><.state_badge value={member.health} /></:col>
      </.grid>
    </div>
  </div>
</.section>

<%!-- Finished relays: retained completions, not live relays --%>
<.section
  fold="finished-relays"
  open={@sections["finished-relays"]}
  testid="finished-relays"
  digest={finished_digest(@finished, @finished_loading?)}
  help="Relays that completed, failed or were cancelled, kept for a while after they end so their outcome can still be read."
>
  <:title>Finished relays</:title>
  <:actions>
    <.button
      variant="secondary"
      size="sm"
      phx-click="reload_finished"
      data-testid="reload-finished"
      disabled={@finished_loading?}
    >
      Reload
    </.button>
  </:actions>
  <.runtime_error
    :if={@finished_error}
    error={@finished_error}
    action="the finished-relay listing"
  />
  <.skeleton :if={@finished_loading?} rows={2} testid="finished-loading" />
  <.empty_state
    :if={@finished == [] and is_nil(@finished_error) and not @finished_loading?}
    icon="hero-check-circle"
  >
    A steps relay that completes is kept here until its retention window passes. None has finished
    inside it.
  </.empty_state>
  <.grid
    :if={@finished != []}
    paging={@paging}
    id="finished"
    rows={@finished}
    row_testid={&"finished-row-#{&1.id}"}
  >
    <:col :let={relay} label="Relay">
      <.link navigate={~p"/namespaces/#{@ns}/relays/#{relay.id}"}>{relay.id}</.link>
    </:col>
    <:col :let={relay} label="Run">{relay[:run] || "—"}</:col>
    <:col :let={relay} label="Status">
      <.said kind={:completion} value={relay[:status]} />
      <p
        :if={relay[:error] not in [nil, ""]}
        class="fui-tone-negative fui-ident text-xs"
        data-testid={"finished-error-#{relay.id}"}
      >
        {relay.error}
      </p>
    </:col>
    <:col :let={relay} label="Finished">
      <.moment at={relay[:finished_at]} testid={"finished-at-#{relay.id}"} />
    </:col>
    <:col :let={relay} label="Kept until">
      <.moment at={relay[:expires_at]} testid={"finished-kept-#{relay.id}"} />
    </:col>
  </.grid>
</.section>

<%!-- Runners --%>
<.section
  id="runners"
  fold="runners"
  open={@sections["runners"]}
  testid="runners-panel"
  digest={runners_digest(@runners, @runner_marks)}
  help="The SDK processes connected to this namespace that run its relays. Dropping one disconnects it and keeps it out until it is readmitted."
>
  <:title>Runners</:title>
  <.runner_table
    paging={@paging}
    namespace={@ns}
    runners={@runners}
    marks={@runner_marks}
    factories?={true}
    view={@runner_views[@ns]}
    can_drop={NodeManager.granted?(@operations, "Fleet.drop_runner")}
    can_readmit={NodeManager.granted?(@operations, "Fleet.readmit_runner")}
    error={FlezhaUiWeb.Live.RunnerActions.error_for(@runner_error, @ns)}
  >
    <:empty>
      <.empty_state icon="hero-server-stack">
        A runner serves this namespace's factories. None is connected.
      </.empty_state>
    </:empty>
  </.runner_table>
</.section>

<.inspector inspected={@inspected} operations={@operations} />

<.launcher_dialog launcher={@launcher} />

<.runner_dialogs drop={@runner_drop} readmit={@runner_readmit} />

<.confirm_dialog
  :if={@confirm_stop}
  title="Stop relay?"
  confirm_label="Stop"
  on_confirm="stop_relay"
  on_cancel="cancel_stop"
  values={%{"relay_id" => @confirm_stop}}
  testid="stop-confirm-modal"
  cancel_testid="stop-cancel-btn"
  confirm_testid="stop-confirm-btn"
>
  Stop <.ident value={@confirm_stop} full />? A steps relay finishes its in-flight work first.
</.confirm_dialog>

<.dialog :if={@rescale} testid="rescale-modal" size="confirm" on_close="cancel_rescale">
  <:title>Rescale partition group</:title>
  <p>
    Set the member count for <.ident value={@rescale.group} full />. Key ranges are redistributed
    across the new member set, and the group re-renders on the next tick.
  </p>
  <form phx-change="select_rescale">
    <.input
      type="number"
      name="rescale[target]"
      label="Target members"
      value={@rescale.target}
      min="1"
      data-testid="rescale-target"
    />
  </form>
  <:actions>
    <.button variant="ghost" phx-click="cancel_rescale" data-testid="rescale-cancel-btn">
      Cancel
    </.button>
    <.button phx-click="rescale" data-testid="rescale-confirm-btn">
      Rescale to {@rescale.target}
    </.button>
  </:actions>
</.dialog>

<.dialog :if={@quota_form} testid="quota-modal" size="form" on_close="close_quotas">
  <:title>Edit limits</:title>
  <.form_error error={@quota_error} action="the quota change" testid="quota-error" />
  <form phx-change="quota_change" class="grid gap-3 sm:grid-cols-2">
    <.input
      :for={row <- @quotas}
      type="number"
      name={"quota[#{row.limit_key}]"}
      label={Words.humanize(row.limit_key)}
      value={@quota_form[to_string(row.limit_key)]}
      data-testid={"quota-input-#{row.limit_key}"}
    />
  </form>
  <:actions>
    <.button variant="ghost" phx-click="close_quotas" data-testid="quota-cancel">Cancel</.button>
    <.button phx-click="save_quotas" data-testid="quota-save">Save</.button>
  </:actions>
</.dialog>

<.dialog
  :if={@token_issue}
  testid="issue-token-modal"
  size="form"
  on_close="close_issue"
  close_testid="issue-token-close"
>
  <:title>Issue a token for {@ns}</:title>

  <%= if @token_issue.issued do %>
    <div data-testid="issued-token" class="space-y-3">
      <.notice icon="hero-exclamation-triangle">
        This token is shown once and kept nowhere. Copy it now; closing this dialog drops it.
      </.notice>
      <p class="fui-figures">
        For <.ident value={@token_issue.issued.principal} full />
        as {@token_issue.issued.role}, id <span data-testid="issued-token-id" class="fui-ident">{@token_issue.issued.id}</span>.
      </p>
      <.code_block id="issued-token-value" testid="issued-token-value">
        {@token_issue.issued.token}
      </.code_block>
      <div class="flex justify-end gap-3">
        <.button
          variant="secondary"
          data-fui-copy-from="#issued-token-value"
          data-testid="issued-token-copy"
          icon="hero-clipboard"
        >
          Copy
        </.button>
        <.button phx-click="close_issue" data-testid="issued-token-done">Done</.button>
      </div>
    </div>
  <% else %>
    <.form_error error={@token_issue.error} action="the token issue" testid="issue-token-error" />
    <form phx-submit="issue_token" class="space-y-4">
      <.input
        type="text"
        name="token[principal]"
        label="Principal"
        hint="Who the token speaks for — a person or a service, such as ops@acme or billing-app."
        placeholder="ops@acme"
        value={@token_issue.form["principal"]}
        mono
        required
        data-testid="issue-token-principal"
      />
      <.role_field
        name="token[role]"
        value={@token_issue.form["role"]}
        testid="issue-token-role"
      />
      <.input
        type="text"
        name="token[ttl]"
        label="Lifetime"
        hint="seconds, or never"
        value={@token_issue.form["ttl"]}
        mono
        data-testid="issue-token-ttl"
      />
      <.input
        type="text"
        name="token[label]"
        label="Label"
        hint="optional"
        value={@token_issue.form["label"]}
        data-testid="issue-token-label"
      />
      <div class="flex justify-end gap-3 pt-2">
        <.button variant="ghost" phx-click="close_issue" data-testid="issue-token-cancel">
          Cancel
        </.button>
        <.button type="submit" data-testid="issue-token-submit">Issue</.button>
      </div>
    </form>
  <% end %>
</.dialog>

<.confirm_dialog
  :if={@confirm_revoke}
  title="Revoke token?"
  confirm_label="Revoke"
  on_confirm="revoke_token"
  on_cancel="cancel_revoke"
  values={%{"id" => @confirm_revoke.id}}
  testid="revoke-token-modal"
  cancel_testid="revoke-token-cancel"
  confirm_testid="revoke-token-confirm"
>
  Revoke token <.ident value={@confirm_revoke.id} full /> of
  <.ident value={@confirm_revoke.principal} full />? Whoever holds it can no longer use it.
</.confirm_dialog>

<.dialog :if={@role_bind} testid="bind-role-modal" size="form" on_close="close_bind">
  <:title>Bind a role in {@ns}</:title>
  <.form_error error={@role_bind.error} action="the bind" testid="bind-role-error" />
  <form phx-submit="bind_role" class="space-y-4">
    <.input
      type="text"
      name="binding[principal]"
      label="Principal"
      hint="Who gets the role — the principal a token was issued to, such as ops@acme."
      placeholder="ops@acme"
      value={@role_bind.form["principal"]}
      mono
      required
      data-testid="bind-role-principal"
    />
    <.role_field
      name="binding[role]"
      value={@role_bind.form["role"]}
      testid="bind-role-role"
    />
    <div class="flex justify-end gap-3 pt-2">
      <.button variant="ghost" phx-click="close_bind" data-testid="bind-role-cancel">
        Cancel
      </.button>
      <.button type="submit" data-testid="bind-role-submit">Bind</.button>
    </div>
  </form>
</.dialog>

<.confirm_dialog
  :if={@confirm_unbind}
  title={if @confirm_unbind.role, do: "Unbind role?", else: "Remove binding?"}
  confirm_label={if @confirm_unbind.role, do: "Unbind", else: "Remove"}
  on_confirm="unbind_role"
  on_cancel="cancel_unbind"
  values={%{"principal" => @confirm_unbind.principal, "role" => @confirm_unbind.role || ""}}
  testid="unbind-role-modal"
  cancel_testid="unbind-role-cancel"
  confirm_testid="unbind-role-confirm"
>
  <%= if @confirm_unbind.role do %>
    Take <.ident value={@confirm_unbind.role} full /> away from
    <.ident value={@confirm_unbind.principal} full /> in
    <.ident value={@confirm_unbind.namespace} full />? Its other roles stay.
  <% else %>
    Remove every role <.ident value={@confirm_unbind.principal} full /> holds in
    <.ident value={@confirm_unbind.namespace} full />? It can no longer act on this
    controller until it is bound again.
  <% end %>
  <span
    :if={@confirm_unbind.namespace == "_system"}
    class="block mt-2"
    data-testid="unbind-cluster-wide"
  >
    This binding is cluster-wide: it reaches every namespace, not only this one.
  </span>
</.confirm_dialog>
