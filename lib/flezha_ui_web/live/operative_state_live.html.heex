<div class="space-y-6">
  <.header back={~p"/namespaces/#{@ns}/operatives/#{@operative_id}"}>
    <span class="flz-num">{@operative_id}</span>
    <span class="ml-2 text-sm font-normal text-th-tertiary">durable state</span>
  </.header>

  <.runtime_error error={@load_error} action="the state listing" />

  <div class="flex items-center gap-4 text-xs text-th-muted">
    <span data-testid="state-retention">
      Retention: {if @retention_hours, do: "#{@retention_hours} hours", else: "not reported"}
    </span>
    <span data-testid="state-verbs">
      Deleting and rotating state are <code class="font-mono">flz state</code> verbs — this screen
      only reads.
    </span>
  </div>

  <%= if @entities == [] do %>
    <.empty_state icon="hero-circle-stack" testid="state-empty" boxed={true}>
      This operative has no durable state yet.
    </.empty_state>
  <% else %>
    <.panel
      :for={{procedure, entities} <- Enum.group_by(@entities, & &1.procedure)}
      testid={"procedure-#{procedure}"}
      icon="hero-circle-stack"
      class="overflow-hidden"
    >
      <:title>Procedure <span class="font-mono normal-case">{procedure}</span></:title>
      <table class="flz-table">
        <thead>
          <tr>
            <th>Entity</th>
            <th>WAL seq</th>
            <th>Snapshot seq</th>
            <th>Flush p99</th>
            <th>Fsync lag</th>
            <th>Dedup drops</th>
            <th></th>
          </tr>
        </thead>
        <tbody>
          <tr
            :for={entity <- entities}
            data-testid={"entity-#{entity.key}"}
          >
            <td class="text-th-primary flz-num text-xs">
              <%!-- A procedure holding one unkeyed entity reports an empty
                    key; naming it is clearer than rendering nothing. --%>
              {if entity.entity_key == "", do: "(unkeyed)", else: entity.entity_key}
              <span
                :if={lagging?(entity)}
                data-testid={"entity-lagging-#{entity.key}"}
                class="flz-badge flz-badge--accent ml-1"
              >
                lagging
              </span>
            </td>
            <td class="flz-num text-xs">
              {entity.counters[:wal_seq]}
            </td>
            <td class="flz-num text-xs">
              {entity.counters[:snapshot_seq]}
            </td>
            <td class="flz-num text-xs">
              {entity.counters[:flush_latency_ms_p99]}
            </td>
            <td class="flz-num text-xs">
              {entity.counters[:fsync_durability_lag_ms]}
            </td>
            <td class="flz-num text-xs">
              {entity.counters[:dedup_drops_total]}
            </td>
            <td class="text-right">
              <button
                phx-click="select_entity"
                phx-value-entity={entity.key}
                data-testid={"select-#{entity.key}"}
                class="text-sm text-accent-text hover:text-accent transition-colors"
              >
                Inspect
              </button>
            </td>
          </tr>
        </tbody>
      </table>
    </.panel>

    <%!-- Durability lag, sampled by this UI --%>
    <div
      data-testid="lag-chart"
      class="flz-panel p-5"
    >
      <div class="flex items-center gap-2 mb-1">
        <.icon name="hero-chart-bar-square" class="w-4 h-4 text-th-tertiary" />
        <h2 class="flz-panel-title">
          Durability lag and WAL-behind-snapshot
        </h2>
      </div>
      <p data-testid="chart-provenance" class="text-xs text-th-muted mb-4">
        Sampled by this UI every 5s — not a series the controller records. A missed tick is drawn
        as a gap, never interpolated.
      </p>
      <div :for={entity <- @entities} class="mb-4 last:mb-0">
        <p class="text-xs font-mono text-th-secondary mb-1">{entity.key}</p>
        <div class="flex items-end gap-px h-12" data-testid={"spark-#{entity.key}"}>
          <span
            :for={point <- Enum.reverse(Map.get(@history, entity.key, []))}
            class={[
              "w-1 rounded-sm",
              if(is_nil(point.lag_ms), do: "bg-transparent", else: "bg-accent")
            ]}
            style={"height: #{min(48, (point.lag_ms || 0))}px"}
            title={"lag #{point.lag_ms || "—"}ms, wal gap #{point.wal_gap || "—"}"}
          >
          </span>
        </div>
      </div>
    </div>

    <%!-- Point-in-time read --%>
    <div
      :if={@selected}
      data-testid="time-travel"
      class="flz-panel p-5"
    >
      <div class="flex items-center gap-2 mb-4">
        <.icon name="hero-clock" class="w-4 h-4 text-th-tertiary" />
        <h2 class="flz-panel-title">
          State at a point in time — <span class="font-mono normal-case">{@selected}</span>
        </h2>
      </div>

      <form phx-change="travel_change" class="flex items-end gap-3 mb-4">
        <div>
          <.dropdown
            label="Target"
            id="travel-kind"
            name="travel[kind]"
            value={@travel_form["kind"]}
            testid="travel-kind"
            class="w-36"
          >
            <:option value="seq">sequence</:option>
            <:option value="timestamp">timestamp</:option>
          </.dropdown>
        </div>
        <div>
          <.input
            type="text"
            name="travel[value]"
            label="Value"
            value={@travel_form["value"]}
            compact
            data-testid="travel-value"
          />
        </div>
      </form>
      <button
        phx-click="travel"
        data-testid="travel-submit"
        class="flz-button flz-button--sm"
      >
        Read
      </button>

      <p
        :if={@travel_target && @travel_result}
        data-testid="travel-target"
        class="text-xs text-th-muted mt-4"
      >
        Resolved target: {target_label(@travel_target)}
      </p>

      <pre
        :if={@travel_result}
        data-testid="travel-result"
        class="flz-code mt-2 max-h-64"
      >{inspect(@travel_result, pretty: true, limit: 50)}</pre>

      <.notice :if={@travel_error} kind={:error} testid="travel-error" class="mt-4">
        {travel_reason(@travel_error)}
      </.notice>
    </div>
  <% end %>
</div>
