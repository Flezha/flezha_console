<div class="space-y-6">
  <h1 class="text-2xl font-bold text-th-primary">Dashboard</h1>

  <.runtime_error error={@stats.error} />

  <%!-- Node status card --%>
  <div class="bg-surface border border-brd rounded-panel p-5 shadow-panel hover:shadow-panel-hover hover:-translate-y-0.5 transition-all duration-200">
    <h2 class="text-sm font-semibold text-th-tertiary uppercase tracking-wider mb-3">Node</h2>
    <div class="flex items-center gap-3">
      <%= if @stats.node do %>
        <.status_dot connected?={true} size="h-3 w-3" class="flex-shrink-0" />
        <div data-testid="node-connected">
          <p class="text-th-primary font-medium">{@stats.node}</p>
          <p class="text-xs text-th-tertiary">Transport: {@stats.transport}</p>
        </div>
      <% else %>
        <.status_dot connected?={false} size="h-3 w-3" class="flex-shrink-0" />
        <div data-testid="node-disconnected">
          <p class="text-th-tertiary font-medium">Not connected</p>
          <p class="text-xs text-th-muted">Set FLEZHA_NODE environment variable</p>
        </div>
      <% end %>
    </div>
  </div>

  <.fleet_summary topology={@topology}>
    <:controls>
      <form :if={@stats.namespaces != []} phx-change="select_namespace">
        <select
          name="ns"
          data-testid="topology-namespace"
          disabled={match?({:namespace, _}, @stats.token_scope)}
          class="bg-surface-input border border-brd-input rounded-xl px-3 py-1.5 text-th-primary text-xs focus:outline-none focus:border-brd-focus transition-colors disabled:opacity-60"
        >
          <option :for={ns <- Enum.sort(@stats.namespaces)} value={ns} selected={ns == @namespace}>
            {ns}
          </option>
        </select>
      </form>
      <span
        :if={match?({:namespace, _}, @stats.token_scope)}
        data-testid="topology-namespace-scope"
        class="text-[11px] text-th-muted"
      >
        scoped to {elem(@stats.token_scope, 1)} by your flezha token
      </span>
    </:controls>
  </.fleet_summary>

  <%!-- Stats grid --%>
  <div class="grid grid-cols-3 gap-4">
    <div class="group bg-surface border border-brd rounded-panel p-6 shadow-panel hover:shadow-panel-hover hover:-translate-y-0.5 transition-all duration-200 animate-fade-in-up">
      <div class="flex items-center gap-2 mb-1">
        <.icon
          name="hero-rectangle-stack"
          class="w-4 h-4 text-th-tertiary group-hover:text-accent transition-colors"
        />
        <p class="text-sm text-th-tertiary">Namespaces</p>
      </div>
      <p data-testid="stat-namespaces" class="text-3xl font-bold text-th-primary mt-1 font-mono">
        {@stats.namespace_count}
      </p>
    </div>
    <div class="group bg-surface border border-brd rounded-panel p-6 shadow-panel hover:shadow-panel-hover hover:-translate-y-0.5 transition-all duration-200 animate-fade-in-up animation-delay-100">
      <div class="flex items-center gap-2 mb-1">
        <.icon
          name="hero-cpu-chip"
          class="w-4 h-4 text-th-tertiary group-hover:text-accent transition-colors"
        />
        <p class="text-sm text-th-tertiary">Operatives</p>
      </div>
      <p data-testid="stat-operatives" class="text-3xl font-bold text-th-primary mt-1 font-mono">
        {@stats.operative_count}
      </p>
      <div
        :if={@stats.operative_health != []}
        data-testid="stat-operative-health"
        class="flex flex-wrap gap-1.5 mt-2"
      >
        <.health_badge
          :for={{health, count} <- @stats.operative_health}
          health={health}
          count={count}
        />
      </div>
      <p
        :if={@stats.unplaced_count > 0}
        data-testid="stat-unplaced"
        class="text-xs text-warning mt-2"
      >
        {@stats.unplaced_count} unplaced
      </p>
    </div>
    <div class="group bg-surface border border-brd rounded-panel p-6 shadow-panel hover:shadow-panel-hover hover:-translate-y-0.5 transition-all duration-200 animate-fade-in-up animation-delay-200">
      <div class="flex items-center gap-2 mb-1">
        <.icon
          name="hero-puzzle-piece"
          class="w-4 h-4 text-th-tertiary group-hover:text-accent transition-colors"
        />
        <p class="text-sm text-th-tertiary">Plugins</p>
      </div>
      <p data-testid="stat-plugins" class="text-3xl font-bold text-th-primary mt-1 font-mono">
        {@stats.plugin_count}
      </p>
      <p data-testid="stat-providers" class="text-xs text-th-muted mt-1">
        {@stats.provider_count} providers available
      </p>
    </div>
  </div>

  <%!-- Runners table --%>
  <.panel icon="hero-server-stack">
    <:title>Runners</:title>
    <%= if @stats.runners == [] do %>
      <div data-testid="dashboard-runners-empty" class="px-5 py-6 text-sm text-th-muted">
        No runners found.
      </div>
    <% else %>
      <table data-testid="dashboard-runners" class="w-full text-sm">
        <thead>
          <tr class="border-b border-brd">
            <th class="text-left px-5 py-2 text-th-tertiary font-medium">Runner ID</th>
            <th class="text-left px-5 py-2 text-th-tertiary font-medium">Namespace</th>
          </tr>
        </thead>
        <tbody>
          <%= for runner <- @stats.runners do %>
            <tr
              data-testid={"dashboard-runner-row-#{runner.id}"}
              class="border-b border-brd-subtle hover:bg-surface-hover transition-colors"
            >
              <td class="px-5 py-2 text-th-secondary font-mono text-xs">{runner.id}</td>
              <td class="px-5 py-2 text-th-tertiary">{runner.namespace}</td>
            </tr>
          <% end %>
        </tbody>
      </table>
    <% end %>
  </.panel>

  <%!-- Namespaces quick links --%>
  <%= if @stats.namespaces != [] do %>
    <.panel>
      <:title>Namespaces</:title>
      <div data-testid="dashboard-namespaces" class="px-5 py-3 flex flex-wrap gap-2">
        <%= for ns <- @stats.namespaces do %>
          <a
            data-testid={"dashboard-namespace-#{ns}"}
            href={~p"/namespaces/#{ns}"}
            class="px-3 py-1.5 bg-accent-subtle text-accent-text hover:bg-accent hover:text-white rounded-xl text-sm hover:scale-105 hover:shadow-sm transition-all duration-200"
          >
            {ns}
          </a>
        <% end %>
      </div>
    </.panel>
  <% end %>
</div>
