<div class="space-y-6">
  <h1 class="text-2xl font-bold text-white">Dashboard</h1>

  <%!-- Node status card --%>
  <div class="bg-zinc-900 border border-zinc-800 rounded-lg p-5">
    <h2 class="text-sm font-semibold text-zinc-400 uppercase tracking-wider mb-3">Node</h2>
    <div class="flex items-center gap-3">
      <%= if @stats.node do %>
        <span class="w-3 h-3 rounded-full bg-green-400 flex-shrink-0"></span>
        <div>
          <p class="text-white font-medium"><%= @stats.node %></p>
          <p class="text-xs text-zinc-400">Transport: <%= @stats.transport %></p>
        </div>
      <% else %>
        <span class="w-3 h-3 rounded-full bg-red-400 flex-shrink-0"></span>
        <div>
          <p class="text-zinc-400 font-medium">Not connected</p>
          <p class="text-xs text-zinc-500">Set FLEZHA_NODE environment variable</p>
        </div>
      <% end %>
    </div>
  </div>

  <%!-- Stats grid --%>
  <div class="grid grid-cols-3 gap-4">
    <div class="bg-zinc-900 border border-zinc-800 rounded-lg p-5">
      <p class="text-sm text-zinc-400">Namespaces</p>
      <p class="text-3xl font-bold text-white mt-1"><%= @stats.namespace_count %></p>
    </div>
    <div class="bg-zinc-900 border border-zinc-800 rounded-lg p-5">
      <p class="text-sm text-zinc-400">Processors</p>
      <p class="text-3xl font-bold text-white mt-1"><%= @stats.processor_count %></p>
    </div>
    <div class="bg-zinc-900 border border-zinc-800 rounded-lg p-5">
      <p class="text-sm text-zinc-400">Active Plugins</p>
      <p class="text-3xl font-bold text-white mt-1"><%= @stats.plugin_count %></p>
    </div>
  </div>

  <%!-- Compute Engines table --%>
  <div class="bg-zinc-900 border border-zinc-800 rounded-lg">
    <div class="px-5 py-4 border-b border-zinc-800">
      <h2 class="text-sm font-semibold text-zinc-400 uppercase tracking-wider">Compute Engines</h2>
    </div>
    <%= if @stats.compute_engines == [] do %>
      <div class="px-5 py-6 text-sm text-zinc-500">No compute engines found.</div>
    <% else %>
      <table class="w-full text-sm">
        <thead>
          <tr class="border-b border-zinc-800">
            <th class="text-left px-5 py-2 text-zinc-400 font-medium">Engine ID</th>
            <th class="text-left px-5 py-2 text-zinc-400 font-medium">Namespace</th>
          </tr>
        </thead>
        <tbody>
          <%= for ce <- @stats.compute_engines do %>
            <tr class="border-b border-zinc-800/50 hover:bg-zinc-800/30">
              <td class="px-5 py-2 text-zinc-200 font-mono text-xs"><%= ce.id %></td>
              <td class="px-5 py-2 text-zinc-400"><%= ce.namespace %></td>
            </tr>
          <% end %>
        </tbody>
      </table>
    <% end %>
  </div>

  <%!-- Namespaces quick links --%>
  <%= if @stats.namespaces != [] do %>
    <div class="bg-zinc-900 border border-zinc-800 rounded-lg">
      <div class="px-5 py-4 border-b border-zinc-800">
        <h2 class="text-sm font-semibold text-zinc-400 uppercase tracking-wider">Namespaces</h2>
      </div>
      <div class="px-5 py-3 flex flex-wrap gap-2">
        <%= for ns <- @stats.namespaces do %>
          <a href={~p"/namespaces/#{ns}"} class="px-3 py-1.5 bg-zinc-800 hover:bg-zinc-700 text-zinc-200 rounded text-sm transition-colors">
            <%= ns %>
          </a>
        <% end %>
      </div>
    </div>
  <% end %>
</div>
