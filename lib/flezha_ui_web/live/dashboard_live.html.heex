<div class="space-y-6">
  <.header>Dashboard</.header>

  <.runtime_error error={@stats.error} />

  <%!-- Node status card --%>
  <div class="flz-panel p-5">
    <h2 class="flz-panel-title mb-3">Controller node</h2>
    <div class="flex items-center gap-3">
      <%= if @stats.node do %>
        <.status_dot connected?={true} size="h-3 w-3" class="flex-shrink-0" />
        <div data-testid="node-connected">
          <p class="text-th-primary font-medium">{@stats.node}</p>
          <p class="text-xs text-th-secondary">Transport: {@stats.transport}</p>
        </div>
      <% else %>
        <.status_dot connected?={false} size="h-3 w-3" class="flex-shrink-0" />
        <div data-testid="node-disconnected">
          <p class="text-th-secondary font-medium">Not connected</p>
          <p class="text-xs text-th-muted">Set FLEZHA_NODE environment variable</p>
        </div>
      <% end %>
    </div>
  </div>

  <.fleet_summary topology={@topology}>
    <:controls>
      <form :if={@stats.namespaces != []} phx-change="select_namespace">
        <.dropdown
          id="topology-namespace"
          name="ns"
          value={@namespace}
          testid="topology-namespace"
          disabled={@stats.scoped_to != nil}
          class="w-44"
        >
          <:option :for={ns <- Enum.sort(@stats.namespaces)} value={ns}>{ns}</:option>
        </.dropdown>
      </form>
      <span
        :if={@stats.scoped_to}
        data-testid="topology-namespace-scope"
        class="text-xs text-th-muted"
      >
        scoped to {@stats.scoped_to} by your flezha token
      </span>
    </:controls>
  </.fleet_summary>

  <%!-- Stats grid --%>
  <div class="grid grid-cols-3 gap-4">
    <div class="flz-panel p-6">
      <div class="flex items-center gap-2 mb-1">
        <.icon
          name="hero-rectangle-stack"
          class="w-4 h-4 text-th-secondary"
        />
        <p class="text-sm text-th-secondary">Namespaces</p>
      </div>
      <p data-testid="stat-namespaces" class="text-3xl font-bold text-th-primary mt-1 font-mono">
        {@stats.namespace_count}
      </p>
    </div>
    <div class="flz-panel p-6">
      <div class="flex items-center gap-2 mb-1">
        <.icon
          name="hero-cpu-chip"
          class="w-4 h-4 text-th-secondary"
        />
        <p class="text-sm text-th-secondary">Relays</p>
      </div>
      <p data-testid="stat-relays" class="text-3xl font-bold text-th-primary mt-1 font-mono">
        {@stats.relay_count}
      </p>
      <div
        :if={@stats.relay_health != []}
        data-testid="stat-relay-health"
        class="flex flex-wrap gap-1.5 mt-2"
      >
        <.health_badge
          :for={{health, count} <- @stats.relay_health}
          health={health}
          count={count}
        />
      </div>
      <p
        :if={@stats.unplaced_count > 0}
        data-testid="stat-unplaced"
        class="text-xs text-warning mt-2"
      >
        {@stats.unplaced_count} unplaced
      </p>
    </div>
    <div class="flz-panel p-6">
      <div class="flex items-center gap-2 mb-1">
        <.icon
          name="hero-puzzle-piece"
          class="w-4 h-4 text-th-secondary"
        />
        <p class="text-sm text-th-secondary">Plugins</p>
      </div>
      <p data-testid="stat-plugins" class="text-3xl font-bold text-th-primary mt-1 font-mono">
        {@stats.plugin_count}
      </p>
      <p data-testid="stat-providers" class="text-xs text-th-muted mt-1">
        {@stats.provider_count} providers available
      </p>
    </div>
  </div>

  <%!-- Runners table --%>
  <.panel icon="hero-server-stack">
    <:title>Runners</:title>
    <%= if @stats.runners == [] do %>
      <.empty_state icon="hero-server-stack" testid="dashboard-runners-empty">
        No runners found.
      </.empty_state>
    <% else %>
      <table data-testid="dashboard-runners" class="flz-table">
        <thead>
          <tr>
            <th>Runner ID</th>
            <th>OS pid</th>
            <th>Namespace</th>
          </tr>
        </thead>
        <tbody>
          <%= for runner <- @stats.runners do %>
            <tr data-testid={"dashboard-runner-row-#{runner.id}"}>
              <td class="flz-num text-xs">{runner.id}</td>
              <td class="flz-num text-xs">{runner.pid || "—"}</td>
              <td>{runner.namespace}</td>
            </tr>
          <% end %>
        </tbody>
      </table>
    <% end %>
  </.panel>

  <%!-- Namespaces quick links --%>
  <%= if @stats.namespaces != [] do %>
    <.panel>
      <:title>Namespaces</:title>
      <div data-testid="dashboard-namespaces" class="px-5 py-3 flex flex-wrap gap-2">
        <%= for ns <- @stats.namespaces do %>
          <a
            data-testid={"dashboard-namespace-#{ns}"}
            href={~p"/namespaces/#{ns}"}
            class="flz-button flz-button--sm flz-button--secondary"
          >
            {ns}
          </a>
        <% end %>
      </div>
    </.panel>
  <% end %>
</div>
