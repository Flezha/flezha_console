<div class="space-y-6">
  <.header mono>
    {@relay_id}
    <:actions>
      <button
        :if={is_nil(@completion)}
        phx-click="confirm_stop"
        data-testid="stop-relay-btn"
        class="flz-button flz-button--md flz-button--danger"
      >
        Stop Relay
      </button>
    </:actions>
  </.header>

  <.relay_tabs ns={@ns} relay_id={@relay_id} current={:detail} />

  <.runtime_error :if={is_nil(@completion)} error={@load_error} />

  <.pipeline_graph topology={@topology}>
    <:tap>
      <aside
        data-testid="topology-tap"
        class="lg:w-72 shrink-0 bg-surface-input border border-brd rounded-xl p-4 space-y-3"
      >
        <div class="flex items-center justify-between gap-2">
          <p class="flz-label">Payload tap</p>
          <button
            :if={@tap}
            type="button"
            phx-click="graph_tap_close"
            data-testid="tap-close"
            class="text-th-muted hover:text-th-primary transition-colors"
            aria-label="Close tap"
          >
            <.icon name="hero-x-mark" class="w-4 h-4" />
          </button>
        </div>

        <p :if={!@tap} class="text-xs text-th-muted">
          Listens to this relay while open, and stops listening when you close it.
        </p>

        <div :if={!@tap} class="flex gap-2">
          <.button
            :for={direction <- ~w(input output)}
            variant="secondary"
            size="sm"
            phx-click="graph_tap"
            phx-value-direction={direction}
            data-testid={"tap-#{direction}"}
          >
            Tap {direction}
          </.button>
        </div>

        <div :if={@tap} class="space-y-2">
          <p class="text-xs text-th-secondary">
            Tapping
            <.mono>{@tap.direction}</.mono>
          </p>

          <div :if={@tap.error} data-testid="tap-error">
            <.runtime_error error={@tap.error} action="the payload tap" />
          </div>

          <dl data-testid="tap-figures" class="grid grid-cols-2 gap-x-3 gap-y-1 text-xs">
            <dt class="text-th-muted">Messages</dt>
            <dd class="text-th-secondary font-mono text-right">{@tap.count}</dd>
            <dt class="text-th-muted">Total</dt>
            <dd class="text-th-secondary font-mono text-right">{Format.bytes(@tap.bytes)}</dd>
            <dt class="text-th-muted">Rate</dt>
            <dd data-testid="tap-msg-rate" class="text-accent-text font-mono text-right">
              {tap_rate(@tap, :count)}/s
            </dd>
            <dt class="text-th-muted">Throughput</dt>
            <dd data-testid="tap-byte-rate" class="text-accent-text font-mono text-right">
              {Format.bytes(round(tap_rate(@tap, :bytes)))}/s
            </dd>
          </dl>

          <ul :if={@tap.recent != []} data-testid="tap-recent" class="space-y-1">
            <li
              :for={msg <- @tap.recent}
              class="text-[10px] font-mono text-th-muted truncate bg-surface rounded px-2 py-1"
            >
              {String.slice(msg.message, 0, 60)}
            </li>
          </ul>

          <p :if={@tap.ended?} data-testid="tap-ended" class="text-xs text-th-muted">
            The tap ended: the relay stopped or the controller let it go.
          </p>

          <p
            :if={@tap.recent == [] and is_nil(@tap.error) and not @tap.ended?}
            class="text-xs text-th-muted"
          >
            Waiting for a record to pass through.
          </p>
        </div>
      </aside>
    </:tap>
  </.pipeline_graph>

  <%!-- Info Panel --%>
  <div class="flz-panel p-5 grid grid-cols-3 gap-4 transition-shadow hover:shadow-md">
    <div>
      <p class="flz-label">Namespace</p>
      <p class="text-th-primary font-mono mt-1">{@ns}</p>
    </div>
    <div>
      <p class="flz-label">Factory ID</p>
      <p class="text-th-primary font-mono mt-1">{@factory_id || "—"}</p>
    </div>
    <div>
      <p class="flz-label">Runner</p>
      <p data-testid="relay-runner" class="text-th-primary font-mono mt-1">
        {@runner_id || "—"}
      </p>
    </div>
    <div>
      <p class="flz-label">Run</p>
      <p data-testid="relay-run" class="text-th-primary font-mono mt-1">{@run}</p>
    </div>
    <div>
      <p class="flz-label">Uptime</p>
      <p data-testid="relay-uptime" class="text-th-primary font-mono mt-1">
        {Format.duration(@uptime_ms)}
      </p>
    </div>
    <div>
      <p class="flz-label">Default Input Type</p>
      <p class="text-th-primary font-mono mt-1">{format_input_type(@default_input_type)}</p>
    </div>
    <div>
      <p class="flz-label">Health</p>
      <p data-testid="relay-health" class="mt-1">
        <.health_badge :if={@row} health={@row.health} />
        <span :if={is_nil(@row)} class="text-th-muted font-mono">—</span>
      </p>
    </div>
    <div>
      <p class="flz-label">Node</p>
      <p data-testid="relay-node" class="text-th-primary font-mono mt-1">
        <span :if={@row && @row[:node]}>{@row[:node]}</span>
        <span :if={@row && is_nil(@row[:node])} class="text-warning">unplaced</span>
        <span :if={is_nil(@row)} class="text-th-muted">—</span>
      </p>
    </div>
    <div :if={@row && @row[:partition]}>
      <p class="flz-label">Partition</p>
      <p data-testid="relay-partition" class="text-th-primary font-mono mt-1">
        p{@row.partition.index}/{@row.partition.count}
        <span class="text-th-tertiary">
          keys {elem(@row.partition.range, 0)}–{elem(@row.partition.range, 1)}
        </span>
      </p>
      <.link
        navigate={~p"/namespaces/#{@ns}"}
        data-testid="relay-partition-group"
        class="text-xs text-accent-text hover:text-accent transition-colors font-mono"
      >
        group {@row.partition.group}
      </.link>
    </div>
    <div class="col-span-3 flex items-center gap-3">
      <span
        :if={@suspended}
        data-testid="relay-suspended"
        class="flz-badge"
      >
        <.icon name="hero-pause-circle" class="w-3.5 h-3.5" /> Suspended
      </span>
      <span
        :if={@effectively_once}
        data-testid="relay-effectively-once"
        class="flz-badge"
      >
        <.icon name="hero-shield-check" class="w-3.5 h-3.5" /> Effectively once
      </span>
    </div>
  </div>

  <%!-- Completion record: a finished relay is not in the registry at all --%>
  <.panel :if={@completion} testid="completion-record" icon="hero-flag">
    <:title>Finished relay</:title>
    <div class="flz-panel-body space-y-2">
      <dl class="grid grid-cols-3 gap-4 text-sm">
        <.stat label="Status">{@completion[:status] || "—"}</.stat>
        <.stat label="Finished at">{Format.token_expiry(@completion[:finished_at])}</.stat>
        <.stat
          :if={@completion[:error] not in [nil, ""]}
          label="Error"
          tone="text-danger-text font-mono"
        >
          {@completion[:error]}
        </.stat>
      </dl>
      <p class="text-xs text-th-muted">
        This relay has completed and is retained only until its window expires. Actions that
        need a live relay are not offered.
      </p>
    </div>
  </.panel>

  <%!-- Steps facts --%>
  <.panel
    :if={@run == :steps and is_nil(@completion)}
    testid="steps-panel"
    icon="hero-arrow-path-rounded-square"
  >
    <:title>Steps</:title>
    <div class="flz-panel-body">
      <dl class="grid grid-cols-3 gap-4 text-sm">
        <.stat label="Durable" testid="steps-durable">
          {if @durable_steps, do: "yes", else: "no"}
        </.stat>
        <.stat label="Effectively once">{if @effectively_once, do: "yes", else: "no"}</.stat>
        <.stat label="Correction window" testid="steps-correction-window">
          {Format.duration(@correction_window_ms)}
        </.stat>
        <.stat label="Arrived via hotswap">
          {if @arrived_via_hotswap?, do: "yes", else: "no"}
        </.stat>
        <.stat label="Suspended">{if @suspended, do: "yes", else: "no"}</.stat>
      </dl>
      <.notice :if={@init_error} kind={:error} testid="steps-init-error" class="mt-4">
        This relay failed to initialise: {inspect(@init_error)}
      </.notice>
    </div>
  </.panel>

  <%!-- Task journal, durable steps relays only --%>
  <.panel
    :if={@journal}
    fold="journal"
    open={@sections["journal"]}
    testid="task-journal-panel"
    icon="hero-book-open"
  >
    <:title>Task journal</:title>
    <:actions>
      <button
        :if={@committed_iterations != []}
        phx-click="open_rewind"
        data-testid="open-rewind-btn"
        class="flz-button flz-button--sm flz-button--secondary"
      >
        Rewind
      </button>
    </:actions>
    <div class="px-5 py-3 text-xs text-th-tertiary font-mono border-b border-brd-subtle space-y-1">
      <p data-testid="task-journal-committed">
        committed iterations: {Enum.join(@committed_iterations, ", ")}
      </p>
      <p data-testid="task-journal-leaves">
        leaf tasklets: {Enum.join(@journal.leaf_tasks, ", ")} — {if @journal.complete,
          do: "the in-flight iteration has committed every leaf",
          else: "the in-flight iteration has not committed every leaf"}
      </p>
    </div>
    <%= if @journal.entries == [] do %>
      <.empty_state icon="hero-book-open">No journal entries yet.</.empty_state>
    <% else %>
      <table class="flz-table">
        <thead>
          <tr>
            <th>Seq</th>
            <th>Type</th>
            <th>Iteration</th>
            <th>Task</th>
            <th>Detail</th>
          </tr>
        </thead>
        <tbody>
          <tr
            :for={entry <- @journal.entries}
            data-testid={"journal-entry-#{entry[:seq]}"}
          >
            <td class="flz-num text-xs">{entry[:seq]}</td>
            <td class="text-th-primary flz-num text-xs">{entry[:type]}</td>
            <td class="flz-num text-xs">{entry[:iter]}</td>
            <td class="flz-num text-xs">{entry[:task_idx]}</td>
            <td class="flz-num text-xs">
              <span
                :if={entry[:type] == "dead_lettered"}
                data-testid={"journal-dead-lettered-#{entry[:seq]}"}
              >
                tasklet {entry[:tasklet]} parked as {entry[:dlq_entry]}
              </span>
            </td>
          </tr>
        </tbody>
      </table>
    <% end %>
  </.panel>

  <%!-- Input log --%>
  <.panel
    :if={@input_log}
    fold="input-log"
    open={@sections["input-log"]}
    testid="input-log-panel"
    icon="hero-inbox"
  >
    <:title>Input log</:title>
    <dl class="flz-panel-body grid grid-cols-3 gap-4 text-sm">
      <.stat label="Undelivered" testid="input-log-undelivered">{@input_log.undelivered}</.stat>
      <.stat label="Last offset" testid="input-log-last-offset">
        {last_offset(@input_log.last_offset)}
      </.stat>
      <.stat label="Consumed offset">{@input_log.consumed_offset || "—"}</.stat>
    </dl>
  </.panel>

  <%!-- SDK State Panel --%>
  <.panel fold="sdk-state" open={@sections["sdk-state"]} icon="hero-code-bracket">
    <:title>SDK State</:title>
    <:actions>
      <button
        phx-click="toggle_auto_refresh"
        aria-pressed={to_string(@auto_refresh_state)}
        class={["flz-button flz-button--sm", !@auto_refresh_state && "flz-button--secondary"]}
      >
        {if @auto_refresh_state, do: "Auto-refresh ON", else: "Auto-refresh OFF"}
      </button>
      <button
        phx-click="fetch_state"
        class="flz-button flz-button--sm flz-button--secondary"
      >
        <.icon name="hero-arrow-path" class="w-3.5 h-3.5" /> Fetch State
      </button>
    </:actions>
    <div class="p-5 space-y-4">
      <form phx-change="selector_change" class="grid grid-cols-2 gap-4">
        <.input
          type="text"
          name="selector[tasklet]"
          label="Tasklet"
          value={@selector_form["tasklet"]}
          placeholder="all tasklets"
          data-testid="input-selector-tasklet"
        />
        <.input
          type="text"
          name="selector[cell_key]"
          label="Cell Key"
          value={@selector_form["cell_key"]}
          placeholder="all cells"
          data-testid="input-selector-cell-key"
        />
      </form>

      <%= case @state_notice do %>
        <% {:info, message} -> %>
          <.notice testid="state-notice">{message}</.notice>
        <% {:error, reason} -> %>
          <.runtime_error error={reason} />
        <% nil -> %>
      <% end %>

      <%= if @state_json do %>
        <p :if={@state_seq} class="text-xs text-th-muted">
          Serialized at change sequence <span class="font-mono">{@state_seq}</span>; this may be
          ahead of what is durable.
        </p>
        <pre
          data-testid="state-json"
          class="flz-code"
        ><%= @state_json %></pre>
      <% else %>
        <p :if={is_nil(@state_notice)} class="text-sm text-th-muted">
          Click "Fetch State" to load the relay's current state.
        </p>
      <% end %>
    </div>
  </.panel>

  <%!-- Bindings / Plugins Panel --%>
  <.panel fold="plugins" open={@sections["plugins"]} icon="hero-puzzle-piece">
    <:title>Plugins / Bindings</:title>
    <:actions>
      <button
        phx-click="open_attach"
        data-testid="attach-plugin-btn"
        class="flz-button flz-button--sm"
      >
        <.icon name="hero-plus" class="w-3.5 h-3.5" /> Attach Plugin
      </button>
    </:actions>

    <%= if @bindings == [] do %>
      <.empty_state icon="hero-puzzle-piece" testid="no-plugins-msg">
        No plugins attached.
      </.empty_state>
    <% else %>
      <table data-testid="bindings-table" class="flz-table">
        <thead>
          <tr>
            <th>Plugin</th>
            <th>Hooks</th>
            <th>Provider</th>
            <th>Position</th>
            <th></th>
          </tr>
        </thead>
        <tbody>
          <%!-- One row per plugin: a plugin bound on several hooks is one
                binding, and is disabled as one. --%>
          <%= for {plugin_id, hooks} <- Enum.group_by(@bindings, & &1.plugin_id) do %>
            <tr data-testid={"binding-row-#{plugin_id}"}>
              <td class="flz-num text-xs">{plugin_id}</td>
              <td class="text-xs">{Enum.map_join(hooks, ", ", & &1.hook)}</td>
              <td class="text-xs">
                {hooks |> Enum.map(& &1.provider) |> Enum.uniq() |> Enum.join(", ")}
              </td>
              <td class="text-xs">
                {hooks |> Enum.map(& &1.position) |> Enum.reject(&is_nil/1) |> Enum.join(", ")}
              </td>
              <td class="text-right">
                <button
                  phx-click="confirm_detach"
                  phx-value-plugin_id={plugin_id}
                  data-testid={"detach-btn-#{plugin_id}"}
                  class="text-xs text-danger-text hover:text-danger transition-colors"
                >
                  Disable
                </button>
              </td>
            </tr>
          <% end %>
        </tbody>
      </table>
    <% end %>
  </.panel>
</div>

<.confirm_dialog
  :if={@confirm_stop}
  title="Stop Relay?"
  confirm_label="Stop"
  on_confirm="stop_relay"
  on_cancel="cancel_stop"
  testid="stop-confirm-modal"
  cancel_testid="stop-cancel-btn"
  confirm_testid="stop-confirm-btn"
>
  Stop <.mono>{@relay_id}</.mono>? A steps relay finishes its in-flight work first.
</.confirm_dialog>

<.confirm_dialog
  :if={@confirm_detach}
  title="Disable Plugin?"
  confirm_label="Disable"
  on_confirm="detach_plugin"
  on_cancel="cancel_detach"
  values={%{"plugin_id" => @confirm_detach}}
  testid="detach-confirm-modal"
  cancel_testid="detach-cancel-btn"
  confirm_testid="detach-confirm-btn"
>
  Disable plugin <.mono>{@confirm_detach}</.mono>? Every running copy stops; its bindings stay.
</.confirm_dialog>

<%!-- Attach Plugin Modal --%>
<.dialog
  :if={@attach}
  testid="attach-modal"
  size="form"
  on_close="close_attach"
  close_testid="attach-close-btn"
>
  <:title>{if @attach.provider, do: "Configure Plugin", else: "Choose Provider"}</:title>

  <%= if is_nil(@attach.provider) do %>
    <.runtime_error error={@attach.providers_error} action="the provider listing" />
    <p :if={@attach.providers == [] and is_nil(@attach.providers_error)} class="flz-empty">
      This controller offers no plugin providers.
    </p>
    <div data-testid="provider-grid" class="grid grid-cols-2 gap-3">
      <button
        :for={provider <- @attach.providers}
        phx-click="choose_provider"
        phx-value-provider={provider.id}
        data-testid={"provider-btn-#{provider.id}"}
        class="group text-left p-4 bg-surface-input hover:bg-surface-hover border border-brd rounded-xl hover:shadow-md hover:-translate-y-0.5 transition-all duration-200"
      >
        <div class="flex items-center gap-2">
          <.icon
            name="hero-cube"
            class="w-4 h-4 text-th-tertiary group-hover:text-accent transition-colors"
          />
          <p class="text-sm font-medium text-th-primary">{Format.humanize(provider.id)}</p>
        </div>
        <p class="text-xs text-th-tertiary mt-1 font-mono">{provider.id}</p>
      </button>
    </div>
  <% else %>
    <.form_error error={@attach.error} action="the plugin" testid="attach-error" />

    <form phx-submit="attach_plugin" phx-change="attach_change" class="space-y-4">
      <.input
        type="text"
        name="plugin[name]"
        label="Plugin name"
        value={@attach.form["name"]}
        mono
        data-testid="input-plugin-name"
      />

      <fieldset data-testid="input-hooks">
        <legend class="flz-label mb-2">Hooks</legend>
        <p :if={@attach.provider.hooks == []} class="text-xs text-th-muted">
          The controller did not say which hooks this provider supports.
        </p>
        <input type="hidden" name="plugin[hooks][]" value="" />
        <label
          :for={hook <- @attach.provider.hooks}
          class="flex items-center gap-2 text-sm text-th-secondary"
        >
          <input
            type="checkbox"
            name="plugin[hooks][]"
            value={hook}
            checked={to_string(hook) in List.wrap(@attach.form["hooks"])}
            data-testid={"input-hook-#{hook}"}
          />
          <span class="font-mono">{hook}</span>
        </label>
      </fieldset>

      <%!-- The provider's own help, when it answers any; the options field
            renders without it rather than the form failing. --%>
      <details :if={@attach.provider.help} data-testid="provider-help" open>
        <summary class="text-xs text-accent-text cursor-pointer hover:text-accent">
          {Format.humanize(@attach.provider.id)} options
        </summary>
        <pre class="flz-code mt-2 max-h-64">{@attach.provider.help}</pre>
      </details>

      <.input
        type="textarea"
        name="plugin[opts]"
        label="Options"
        hint="JSON object, optional"
        value={@attach.form["opts"]}
        placeholder="{}"
        mono
        data-testid="input-plugin-opts"
      />

      <div class="flex justify-between pt-2">
        <.button variant="ghost" phx-click="close_attach" data-testid="attach-cancel-btn">
          Cancel
        </.button>
        <.button type="submit" data-testid="attach-submit-btn">Attach</.button>
      </div>
    </form>
  <% end %>
</.dialog>

<.dialog :if={@rewind_target} testid="rewind-modal" size="confirm">
  <h3 class="flz-modal-title mb-3">Rewind relay</h3>
  <.notice kind={:error} class="mb-4">
    Rewinding discards every iteration after the one you choose. The relay resumes from that
    boundary and the work in between is unwound.
  </.notice>
  <form phx-change="select_rewind" class="mb-4">
    <.input
      type="select"
      name="rewind[iteration]"
      label="Committed iteration"
      value={@rewind_target}
      options={@committed_iterations}
      data-testid="rewind-iteration"
    />
  </form>
  <div class="flex justify-end gap-3">
    <.button variant="ghost" phx-click="cancel_rewind" data-testid="rewind-cancel-btn">
      Cancel
    </.button>
    <.button variant="danger" phx-click="rewind" data-testid="rewind-confirm-btn">
      Rewind to {@rewind_target}
    </.button>
  </div>
</.dialog>
