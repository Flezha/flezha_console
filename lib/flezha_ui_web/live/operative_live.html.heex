<div class="space-y-6">
  <div class="flex items-center justify-between">
    <div class="flex items-center gap-3">
      <a
        href={~p"/namespaces/#{@ns}"}
        class="text-th-tertiary hover:text-th-primary transition-colors"
      >
        <.icon name="hero-arrow-left" class="w-4 h-4" />
      </a>
      <h1 class="text-2xl font-bold text-th-primary font-mono">{@operative_id}</h1>
    </div>
    <button
      phx-click="confirm_stop"
      class="inline-flex items-center gap-2 px-4 py-2 text-sm font-medium text-danger-text border border-danger rounded-xl hover:bg-danger hover:text-white hover:scale-[1.02] active:scale-[0.98] transition-all duration-200"
    >
      Stop Operative
    </button>
  </div>

  <.runtime_error error={@load_error} />

  <.pipeline_graph topology={@topology}>
    <:tap>
      <aside
        data-testid="topology-tap"
        class="lg:w-72 shrink-0 bg-surface-input border border-brd rounded-xl p-4 space-y-3"
      >
        <div class="flex items-center justify-between gap-2">
          <p class="text-xs text-th-muted uppercase tracking-wider">Payload tap</p>
          <button
            :if={@tap}
            type="button"
            phx-click="graph_tap_close"
            data-testid="tap-close"
            class="text-th-muted hover:text-th-primary transition-colors"
            aria-label="Close tap"
          >
            <.icon name="hero-x-mark" class="w-4 h-4" />
          </button>
        </div>

        <p :if={!@tap} class="text-xs text-th-muted">
          Attaches a listener to this operative while open, and detaches it when you close it.
        </p>

        <div :if={!@tap} class="flex gap-2">
          <.button
            :for={io <- ~w(input output)}
            variant="secondary"
            size="sm"
            phx-click="graph_tap"
            phx-value-io={io}
            data-testid={"tap-#{io}"}
          >
            Tap {io}
          </.button>
        </div>

        <div :if={@tap} class="space-y-2">
          <p class="text-xs text-th-secondary">
            Tapping
            <.mono>{@tap.io_type}</.mono>
            — attached
          </p>

          <.notice :if={@tap.error} kind={:error} testid="tap-error">
            Could not attach the listener: {inspect(@tap.error)}
          </.notice>

          <dl data-testid="tap-figures" class="grid grid-cols-2 gap-x-3 gap-y-1 text-xs">
            <dt class="text-th-muted">Messages</dt>
            <dd class="text-th-secondary font-mono text-right">{@tap.count}</dd>
            <dt class="text-th-muted">Total</dt>
            <dd class="text-th-secondary font-mono text-right">{Format.bytes(@tap.bytes)}</dd>
            <dt class="text-th-muted">Rate</dt>
            <dd data-testid="tap-msg-rate" class="text-accent-text font-mono text-right">
              {tap_rate(@tap, :count)}/s
            </dd>
            <dt class="text-th-muted">Throughput</dt>
            <dd data-testid="tap-byte-rate" class="text-accent-text font-mono text-right">
              {Format.bytes(round(tap_rate(@tap, :bytes)))}/s
            </dd>
          </dl>

          <ul :if={@tap.recent != []} data-testid="tap-recent" class="space-y-1">
            <li
              :for={msg <- @tap.recent}
              class="text-[10px] font-mono text-th-muted truncate bg-surface rounded px-2 py-1"
            >
              {String.slice(msg.message, 0, 60)}
            </li>
          </ul>

          <p :if={@tap.recent == [] and is_nil(@tap.error)} class="text-xs text-th-muted">
            Waiting for a record to pass through.
          </p>
        </div>
      </aside>
    </:tap>
  </.pipeline_graph>

  <%!-- Info Panel --%>
  <div class="bg-surface border border-brd rounded-panel p-5 grid grid-cols-3 gap-4 shadow-panel hover:shadow-panel-hover hover:-translate-y-0.5 transition-all duration-200">
    <div>
      <p class="text-xs text-th-muted uppercase tracking-wider">Namespace</p>
      <p class="text-th-primary font-mono mt-1">{@ns}</p>
    </div>
    <div>
      <p class="text-xs text-th-muted uppercase tracking-wider">Factory ID</p>
      <p class="text-th-primary font-mono mt-1">{@factory_id || "—"}</p>
    </div>
    <div>
      <p class="text-xs text-th-muted uppercase tracking-wider">Runner</p>
      <p data-testid="operative-runner" class="text-th-primary font-mono mt-1">
        {@runner_id || "—"}
      </p>
    </div>
    <div>
      <p class="text-xs text-th-muted uppercase tracking-wider">Kind</p>
      <p data-testid="operative-kind" class="text-th-primary font-mono mt-1">
        {if @kind, do: inspect(@kind), else: "—"}
      </p>
    </div>
    <div>
      <p class="text-xs text-th-muted uppercase tracking-wider">Uptime</p>
      <p data-testid="operative-uptime" class="text-th-primary font-mono mt-1">
        {Format.duration(@uptime_ms)}
      </p>
    </div>
    <div>
      <p class="text-xs text-th-muted uppercase tracking-wider">Default Input Type</p>
      <p class="text-th-primary font-mono mt-1">{format_input_type(@default_input_type)}</p>
    </div>
    <div>
      <p class="text-xs text-th-muted uppercase tracking-wider">Health</p>
      <p data-testid="operative-health" class="mt-1">
        <.health_badge :if={@row} health={@row.health} />
        <span :if={is_nil(@row)} class="text-th-muted font-mono">—</span>
      </p>
    </div>
    <div>
      <p class="text-xs text-th-muted uppercase tracking-wider">Node</p>
      <p data-testid="operative-node" class="text-th-primary font-mono mt-1">
        <span :if={@row && @row[:node]}>{@row[:node]}</span>
        <span :if={@row && is_nil(@row[:node])} class="text-warning">unplaced</span>
        <span :if={is_nil(@row)} class="text-th-muted">—</span>
      </p>
    </div>
    <div :if={@row && @row[:partition]}>
      <p class="text-xs text-th-muted uppercase tracking-wider">Partition</p>
      <p data-testid="operative-partition" class="text-th-primary font-mono mt-1">
        p{@row.partition.index}/{@row.partition.count}
        <span class="text-th-tertiary">
          keys {elem(@row.partition.range, 0)}–{elem(@row.partition.range, 1)}
        </span>
      </p>
      <.link
        navigate={~p"/namespaces/#{@ns}"}
        data-testid="operative-partition-group"
        class="text-xs text-accent-text hover:text-accent transition-colors font-mono"
      >
        group {@row.partition.group}
      </.link>
    </div>
    <div class="col-span-3 flex items-center gap-3">
      <span
        :if={@suspended}
        data-testid="operative-suspended"
        class="inline-flex items-center gap-1.5 px-2.5 py-1 rounded-lg text-xs bg-surface-input border border-brd text-th-secondary"
      >
        <.icon name="hero-pause-circle" class="w-3.5 h-3.5" /> Suspended
      </span>
      <span
        :if={@effectively_once}
        data-testid="operative-effectively-once"
        class="inline-flex items-center gap-1.5 px-2.5 py-1 rounded-lg text-xs bg-surface-input border border-brd text-th-secondary"
      >
        <.icon name="hero-shield-check" class="w-3.5 h-3.5" /> Effectively once
      </span>
    </div>
  </div>

  <%!-- Completion record: a finished instance is not in the registry at all --%>
  <div
    :if={@completion}
    data-testid="completion-record"
    class="bg-surface border border-brd rounded-panel p-5 shadow-panel space-y-2"
  >
    <div class="flex items-center gap-2">
      <.icon name="hero-flag" class="w-4 h-4 text-th-tertiary" />
      <h2 class="text-sm font-semibold text-th-tertiary uppercase tracking-wider">
        Finished instance
      </h2>
    </div>
    <dl class="grid grid-cols-3 gap-4 text-sm">
      <.stat label="Status">{@completion[:status] || "—"}</.stat>
      <.stat label="Finished at">{Format.token_expiry(@completion[:finished_at])}</.stat>
      <.stat
        :if={@completion[:error] not in [nil, ""]}
        label="Error"
        tone="text-danger-text font-mono"
      >
        {@completion[:error]}
      </.stat>
    </dl>
    <p class="text-xs text-th-muted">
      This instance has completed and is retained only until its window expires. Actions that need
      a live operative are not offered.
    </p>
  </div>

  <%!-- Workflow profile --%>
  <div
    :if={@kind == :workflow}
    data-testid="workflow-panel"
    class="bg-surface border border-brd rounded-panel p-5 shadow-panel"
  >
    <div class="flex items-center gap-2 mb-4">
      <.icon name="hero-arrow-path-rounded-square" class="w-4 h-4 text-th-tertiary" />
      <h2 class="text-sm font-semibold text-th-tertiary uppercase tracking-wider">Workflow</h2>
    </div>
    <dl class="grid grid-cols-3 gap-4 text-sm">
      <.stat label="Durable" testid="workflow-durable">
        {if @durable_workflow, do: "yes", else: "no"}
      </.stat>
      <.stat label="Effectively once">{if @effectively_once, do: "yes", else: "no"}</.stat>
      <.stat label="Correction window" testid="workflow-correction-window">
        {Format.duration(@correction_window_ms)}
      </.stat>
      <.stat label="Arrived via hotswap">
        {if @arrived_via_hotswap?, do: "yes", else: "no"}
      </.stat>
      <.stat label="Suspended">{if @suspended, do: "yes", else: "no"}</.stat>
    </dl>
    <.notice :if={@init_error} kind={:error} testid="workflow-init-error" class="mt-4">
      This instance failed to initialise: {inspect(@init_error)}
    </.notice>
  </div>

  <%!-- Proc journal, durable workflows only --%>
  <.panel :if={@journal} testid="journal-panel" icon="hero-book-open">
    <:title>Proc journal</:title>
    <:actions>
      <button
        :if={@committed_iterations != []}
        phx-click="open_rewind"
        data-testid="open-rewind-btn"
        class="px-3 py-1.5 text-xs rounded-xl bg-surface-input text-th-secondary border border-brd hover:bg-surface-hover transition-colors"
      >
        Rewind
      </button>
    </:actions>
    <div class="px-5 py-3 text-xs text-th-tertiary font-mono border-b border-brd-subtle">
      committed iterations: {Enum.join(@committed_iterations, ", ")}
    </div>
    <%= if @journal == [] do %>
      <p class="px-5 py-6 text-sm text-th-muted">No journal entries yet.</p>
    <% else %>
      <table class="w-full text-sm">
        <thead>
          <tr class="border-b border-brd">
            <th class="text-left px-5 py-2 text-th-tertiary font-medium">Seq</th>
            <th class="text-left px-5 py-2 text-th-tertiary font-medium">Type</th>
            <th class="text-left px-5 py-2 text-th-tertiary font-medium">Iteration</th>
            <th class="text-left px-5 py-2 text-th-tertiary font-medium">Proc</th>
            <th class="text-left px-5 py-2 text-th-tertiary font-medium">Detail</th>
          </tr>
        </thead>
        <tbody>
          <tr
            :for={entry <- @journal}
            data-testid={"journal-entry-#{entry[:seq]}"}
            class="border-b border-brd-subtle"
          >
            <td class="px-5 py-2 text-th-tertiary font-mono text-xs">{entry[:seq]}</td>
            <td class="px-5 py-2 text-th-primary font-mono text-xs">{entry[:type]}</td>
            <td class="px-5 py-2 text-th-tertiary font-mono text-xs">{entry[:iter]}</td>
            <td class="px-5 py-2 text-th-tertiary font-mono text-xs">{entry[:proc_idx]}</td>
            <td class="px-5 py-2 text-th-tertiary font-mono text-xs">
              <span :if={entry[:type] == :parked} data-testid={"journal-parked-#{entry[:seq]}"}>
                wakes at {(entry[:payload] || %{})[:wake_deadline_ms] || "no deadline"}
              </span>
            </td>
          </tr>
        </tbody>
      </table>
    <% end %>
  </.panel>

  <%!-- Proc inbox --%>
  <div
    :if={@inbox}
    data-testid="inbox-panel"
    class="bg-surface border border-brd rounded-panel p-5 shadow-panel"
  >
    <div class="flex items-center gap-2 mb-4">
      <.icon name="hero-inbox" class="w-4 h-4 text-th-tertiary" />
      <h2 class="text-sm font-semibold text-th-tertiary uppercase tracking-wider">Proc inbox</h2>
    </div>
    <dl class="grid grid-cols-3 gap-4 text-sm">
      <.stat label="Undelivered" testid="inbox-undelivered">{@inbox.undelivered}</.stat>
      <.stat label="Last offset" testid="inbox-last-offset">{@inbox.last_offset || "—"}</.stat>
      <.stat label="Consumed offset">{@inbox.consumed_offset || "—"}</.stat>
    </dl>
  </div>

  <div class="flex justify-end">
    <.link
      navigate={~p"/namespaces/#{@ns}/operatives/#{@operative_id}/state"}
      data-testid="operative-state-link"
      class="text-sm text-accent-text hover:text-accent transition-colors"
    >
      Durable state &rarr;
    </.link>
  </div>

  <%!-- SDK State Panel --%>
  <.panel icon="hero-code-bracket">
    <:title>SDK State</:title>
    <:actions>
      <button
        phx-click="toggle_auto_refresh"
        class={"px-3 py-1.5 text-xs rounded-xl transition-colors " <> if @auto_refresh_state, do: "bg-accent text-white", else: "bg-surface-input text-th-secondary border border-brd hover:bg-surface-hover"}
      >
        {if @auto_refresh_state, do: "Auto-refresh ON", else: "Auto-refresh OFF"}
      </button>
      <button
        phx-click="fetch_state"
        class="inline-flex items-center gap-1.5 px-3 py-1.5 text-xs bg-surface-input text-th-secondary border border-brd hover:bg-surface-hover rounded-xl transition-colors"
      >
        <.icon name="hero-arrow-path" class="w-3.5 h-3.5" /> Fetch State
      </button>
    </:actions>
    <div class="p-5 space-y-4">
      <form phx-change="selector_change" class="grid grid-cols-2 gap-4">
        <div>
          <label class="block text-xs text-th-muted uppercase tracking-wider mb-1">
            Procedure
          </label>
          <input
            type="text"
            name="selector[procedure]"
            value={@selector_form["procedure"]}
            placeholder="all procedures"
            data-testid="input-selector-procedure"
            class="w-full bg-surface-input border border-brd-input rounded-xl px-3 py-2 text-th-primary text-sm focus:outline-none focus:border-brd-focus transition-colors"
          />
        </div>
        <div>
          <label class="block text-xs text-th-muted uppercase tracking-wider mb-1">
            Entity Key
          </label>
          <input
            type="text"
            name="selector[entity_key]"
            value={@selector_form["entity_key"]}
            placeholder="all entities"
            data-testid="input-selector-entity-key"
            class="w-full bg-surface-input border border-brd-input rounded-xl px-3 py-2 text-th-primary text-sm focus:outline-none focus:border-brd-focus transition-colors"
          />
        </div>
      </form>

      <%= case @state_notice do %>
        <% {:info, message} -> %>
          <.notice testid="state-notice">{message}</.notice>
        <% {:error, reason} -> %>
          <.runtime_error error={reason} />
        <% nil -> %>
      <% end %>

      <%= if @state_json do %>
        <p :if={@state_seq} class="text-xs text-th-muted">
          Serialized at change sequence <span class="font-mono">{@state_seq}</span>; this may be
          ahead of what is durable.
        </p>
        <pre
          data-testid="state-json"
          class="bg-surface-base rounded-xl p-4 text-xs text-code font-mono overflow-x-auto whitespace-pre-wrap border border-brd"
        ><%= @state_json %></pre>
      <% else %>
        <p :if={is_nil(@state_notice)} class="text-sm text-th-muted">
          Click "Fetch State" to load the operative's current state.
        </p>
      <% end %>
    </div>
  </.panel>

  <%!-- Bindings / Plugins Panel --%>
  <.panel icon="hero-puzzle-piece">
    <:title>Plugins / Bindings</:title>
    <:actions>
      <button
        phx-click="open_attach_modal"
        data-testid="attach-plugin-btn"
        class="inline-flex items-center gap-1.5 px-3 py-1.5 text-xs font-medium text-white rounded-xl bg-accent hover:bg-accent-hover hover:shadow-btn-hover hover:scale-[1.02] active:scale-[0.98] transition-all duration-200"
      >
        <.icon name="hero-plus" class="w-3.5 h-3.5" /> Attach Plugin
      </button>
    </:actions>

    <%= if @bindings == [] do %>
      <div data-testid="no-plugins-msg" class="px-5 py-6 text-sm text-th-muted">
        No plugins attached.
      </div>
    <% else %>
      <table data-testid="bindings-table" class="w-full text-sm">
        <thead>
          <tr class="border-b border-brd">
            <th class="text-left px-5 py-2 text-th-tertiary font-medium">Plugin ID</th>
            <th class="text-left px-5 py-2 text-th-tertiary font-medium">Extension</th>
            <th class="text-left px-5 py-2 text-th-tertiary font-medium">Provider</th>
            <th class="text-left px-5 py-2 text-th-tertiary font-medium">Position</th>
            <th class="px-5 py-2"></th>
          </tr>
        </thead>
        <tbody>
          <%= for binding <- @bindings do %>
            <tr
              data-testid={"binding-row-#{binding.plugin_id}"}
              class="border-b border-brd-subtle hover:bg-surface-hover transition-colors"
            >
              <td class="px-5 py-2 text-th-secondary font-mono text-xs">{binding.plugin_id}</td>
              <td class="px-5 py-2 text-th-secondary text-xs">{binding.extension}</td>
              <td class="px-5 py-2 text-th-secondary text-xs">{binding.provider}</td>
              <td class="px-5 py-2 text-th-tertiary text-xs">{binding.position || "—"}</td>
              <td class="px-5 py-2 text-right">
                <button
                  phx-click="confirm_detach"
                  phx-value-plugin_id={binding.plugin_id}
                  data-testid={"detach-btn-#{binding.plugin_id}"}
                  class="text-xs text-danger-text hover:text-danger transition-colors"
                >
                  Detach
                </button>
              </td>
            </tr>
          <% end %>
        </tbody>
      </table>
    <% end %>
  </.panel>

  <%!-- Stream links --%>
  <div class="bg-surface border border-brd rounded-panel p-5 shadow-panel">
    <div class="flex items-center gap-2 mb-3">
      <.icon name="hero-signal" class="w-4 h-4 text-th-tertiary" />
      <h2 class="text-sm font-semibold text-th-tertiary uppercase tracking-wider">
        Stream Viewer
      </h2>
    </div>
    <div class="flex gap-3">
      <.link
        navigate={~p"/namespaces/#{@ns}/operatives/#{@operative_id}/stream"}
        class="inline-flex items-center gap-2 px-4 py-2 text-sm font-medium text-white rounded-xl bg-accent hover:bg-accent-hover hover:shadow-btn-hover hover:scale-[1.02] active:scale-[0.98] transition-all duration-200"
      >
        <.icon name="hero-signal" class="w-4 h-4" /> Watch Stream
      </.link>
    </div>
  </div>
</div>

<.confirm_dialog
  :if={@confirm_stop}
  title="Stop Operative?"
  confirm_label="Stop"
  on_confirm="stop_operative"
  on_cancel="cancel_stop"
>
  Stop <.mono>{@operative_id}</.mono>? This cannot be undone.
</.confirm_dialog>

<.confirm_dialog
  :if={@confirm_detach}
  title="Detach Plugin?"
  confirm_label="Detach"
  on_confirm="detach_plugin"
  on_cancel="cancel_detach"
  values={%{"plugin_id" => @confirm_detach}}
  testid="detach-confirm-modal"
  cancel_testid="detach-cancel-btn"
  confirm_testid="detach-confirm-btn"
>
  Remove plugin <.mono>{@confirm_detach}</.mono>?
</.confirm_dialog>

<%!-- Attach Plugin Modal --%>
<.dialog
  :if={@show_attach_modal}
  testid="attach-modal"
  size="max-w-lg"
  on_close="close_attach_modal"
  close_testid="attach-close-btn"
>
  <:title>
    {if @attach_step == :choose_provider, do: "Choose Provider", else: "Configure Plugin"}
  </:title>

  <%= if @attach_step == :choose_provider do %>
    <div data-testid="provider-grid" class="grid grid-cols-2 gap-3">
      <%= for provider <- @enabled_providers do %>
        <button
          phx-click="choose_provider"
          phx-value-provider_id={provider.id}
          data-testid={"provider-btn-#{provider.id}"}
          class="group text-left p-4 bg-surface-input hover:bg-surface-hover border border-brd rounded-xl hover:shadow-panel-hover hover:-translate-y-0.5 transition-all duration-200"
        >
          <div class="flex items-center gap-2">
            <.icon
              name="hero-cube"
              class="w-4 h-4 text-th-tertiary group-hover:text-accent transition-colors"
            />
            <p class="text-sm font-medium text-th-primary">{Format.humanize(provider.id)}</p>
          </div>
          <p class="text-xs text-th-tertiary mt-1 font-mono">{provider.id}</p>
        </button>
      <% end %>
    </div>
  <% else %>
    <% provider = Enum.find(@enabled_providers, fn p -> p.id == @attach_provider_id end) %>
    <.notice :if={@attach_error} kind={:error} testid="attach-error" class="mb-4">
      {@attach_error}
    </.notice>

    <form phx-submit="attach_plugin" phx-change="attach_form_change" class="space-y-4">
      <div class="grid grid-cols-2 gap-4">
        <div>
          <label class="block text-sm font-medium text-th-secondary mb-1">Plugin ID</label>
          <input
            type="text"
            name="plugin[plugin_id]"
            value={@attach_form["plugin_id"]}
            data-testid="input-plugin-id"
            class="w-full bg-surface-input border border-brd-input rounded-xl px-3 py-2 text-th-primary text-sm focus:outline-none focus:border-brd-focus focus-visible:ring-2 focus-visible:ring-accent/50 focus-visible:ring-offset-1 transition-colors"
          />
        </div>
        <div>
          <label class="block text-sm font-medium text-th-secondary mb-1">
            Position <span class="text-th-muted font-normal">(ordered extensions only)</span>
          </label>
          <input
            type="number"
            name="plugin[sub_position]"
            placeholder="unset"
            value={@attach_form["sub_position"]}
            data-testid="input-position"
            class="w-full bg-surface-input border border-brd-input rounded-xl px-3 py-2 text-th-primary text-sm focus:outline-none focus:border-brd-focus focus-visible:ring-2 focus-visible:ring-accent/50 focus-visible:ring-offset-1 transition-colors"
          />
        </div>
      </div>

      <div>
        <label class="block text-sm font-medium text-th-secondary mb-1">Trigger</label>
        <select
          name="plugin[trigger]"
          data-testid="input-trigger"
          class="w-full bg-surface-input border border-brd-input rounded-xl px-3 py-2 text-th-primary text-sm focus:outline-none focus:border-brd-focus"
        >
          <%= for trigger <- trigger_options() do %>
            <option value={trigger} selected={@attach_form["trigger"] == trigger}>
              {trigger}
            </option>
          <% end %>
        </select>
      </div>

      <%!-- Provider-specific fields (dynamic) --%>
      <%= if provider do %>
        <% all_fields = provider.required_fields ++ provider.optional_fields %>
        <%= if all_fields != [] do %>
          <div class="border-t border-brd pt-4">
            <p class="text-xs text-th-muted uppercase tracking-wider mb-3">
              {Format.humanize(provider.id)} Settings
            </p>
            <%!-- The provider's own help, when it exports any. Fields render
                  bare when it does not, rather than the form failing. --%>
            <details :if={@provider_help} data-testid="provider-help" class="mb-3">
              <summary class="text-xs text-accent-text cursor-pointer hover:text-accent">
                What do these options mean?
              </summary>
              <pre class="mt-2 p-3 bg-surface-input rounded-xl text-[11px] font-mono text-th-secondary overflow-auto max-h-64 whitespace-pre-wrap">{@provider_help}</pre>
            </details>
            <%= for field <- provider.required_fields do %>
              <div class="mb-3">
                <label class="block text-sm font-medium text-th-secondary mb-1">
                  {Format.humanize(field)} *
                </label>
                <input
                  type="text"
                  name={"plugin[field_#{field}]"}
                  value={Map.get(@attach_form, "field_#{field}", "")}
                  data-testid={"input-field-#{field}"}
                  data-required="true"
                  class="w-full bg-surface-input border border-brd-input rounded-xl px-3 py-2 text-th-primary text-sm focus:outline-none focus:border-brd-focus focus-visible:ring-2 focus-visible:ring-accent/50 focus-visible:ring-offset-1 transition-colors"
                />
              </div>
            <% end %>
            <%= for field <- provider.optional_fields do %>
              <div class="mb-3">
                <label class="block text-sm font-medium text-th-secondary mb-1">
                  {Format.humanize(field)}
                </label>
                <input
                  type="text"
                  name={"plugin[field_#{field}]"}
                  value={Map.get(@attach_form, "field_#{field}", "")}
                  data-testid={"input-field-#{field}"}
                  class="w-full bg-surface-input border border-brd-input rounded-xl px-3 py-2 text-th-primary text-sm focus:outline-none focus:border-brd-focus focus-visible:ring-2 focus-visible:ring-accent/50 focus-visible:ring-offset-1 transition-colors"
                />
              </div>
            <% end %>
          </div>
        <% end %>
      <% end %>

      <div class="flex justify-between pt-2">
        <button
          type="button"
          phx-click="close_attach_modal"
          data-testid="attach-cancel-btn"
          class="px-4 py-2 text-sm text-th-secondary hover:text-th-primary transition-colors"
        >
          Cancel
        </button>
        <button
          type="submit"
          data-testid="attach-submit-btn"
          class="px-4 py-2 text-sm font-medium text-white rounded-xl bg-accent hover:bg-accent-hover hover:shadow-btn-hover transition-all duration-200"
        >
          Attach
        </button>
      </div>
    </form>
  <% end %>
</.dialog>

<.dialog :if={@rewind_target} testid="rewind-modal" size="max-w-md">
  <h3 class="text-lg font-semibold text-th-primary mb-3">Rewind instance</h3>
  <.notice kind={:error} class="mb-4">
    Rewinding discards every iteration after the one you choose. The instance resumes from that
    boundary and the work in between is unwound.
  </.notice>
  <form phx-change="select_rewind" class="mb-4">
    <label class="block text-sm font-medium text-th-secondary mb-1">Committed iteration</label>
    <select
      name="rewind[iteration]"
      data-testid="rewind-iteration"
      class="w-full bg-surface-input border border-brd-input rounded-xl px-3 py-2 text-th-primary text-sm focus:outline-none focus:border-brd-focus"
    >
      <option
        :for={iteration <- @committed_iterations}
        value={iteration}
        selected={iteration == @rewind_target}
      >
        {iteration}
      </option>
    </select>
  </form>
  <div class="flex justify-end gap-3">
    <button
      phx-click="cancel_rewind"
      data-testid="rewind-cancel-btn"
      class="px-4 py-2 text-sm text-th-secondary hover:text-th-primary transition-colors"
    >
      Cancel
    </button>
    <button
      phx-click="rewind"
      data-testid="rewind-confirm-btn"
      class="px-4 py-2 text-sm font-medium text-white rounded-xl bg-danger hover:bg-danger-hover transition-all"
    >
      Rewind to {@rewind_target}
    </button>
  </div>
</.dialog>
