<div class="space-y-6">
  <h1 class="text-2xl font-bold text-th-primary">Cluster</h1>

  <.runtime_error error={@load_error} />

  <%!-- Nodes --%>
  <.panel icon="hero-server-stack">
    <:title>Nodes ({length(@cluster_nodes)})</:title>
    <%= if @cluster_nodes == [] do %>
      <div data-testid="cluster-nodes-empty" class="px-5 py-6 text-sm text-th-muted">
        No controller node is reachable.
      </div>
    <% else %>
      <ul data-testid="cluster-nodes" class="divide-y divide-brd-subtle">
        <li
          :for={node <- @cluster_nodes}
          data-testid={"cluster-node-#{node.name}"}
          class="px-5 py-3 flex items-center gap-3"
        >
          <span class={
            "w-2 h-2 rounded-full shrink-0 " <> if node.connected?, do: "bg-success", else: "bg-th-muted"
          }>
          </span>
          <span class="text-th-primary font-mono text-sm">{node.name}</span>
          <span
            :if={node.connected?}
            class="ml-auto text-xs px-2 py-0.5 rounded-lg bg-surface-input border border-brd text-th-secondary"
          >
            connected to this UI
          </span>
        </li>
      </ul>
    <% end %>
  </.panel>

  <%!-- Per-namespace hubs and fleet --%>
  <.empty_state
    :if={@namespaces == []}
    icon="hero-rectangle-stack"
    testid="cluster-namespaces-empty"
    boxed={true}
  >
    No namespace is running.
  </.empty_state>

  <div
    :for={ns <- @namespaces}
    data-testid={"cluster-namespace-#{ns.name}"}
    class="bg-surface border border-brd rounded-panel shadow-panel"
  >
    <div class="px-5 py-4 border-b border-brd flex items-center justify-between">
      <div class="flex items-center gap-2">
        <.icon name="hero-rectangle-stack" class="w-4 h-4 text-th-tertiary" />
        <h2 class="text-sm font-semibold text-th-primary font-mono">{ns.name}</h2>
      </div>
      <div class="flex items-center gap-2 text-xs text-th-tertiary">
        <span>Hub:</span>
        <%= if ns.hub_nodes == [] do %>
          <span data-testid={"hub-nodes-#{ns.name}"} class="text-th-muted">no hub running</span>
        <% else %>
          <span data-testid={"hub-nodes-#{ns.name}"} class="font-mono text-th-secondary">
            {Enum.join(ns.hub_nodes, ", ")}
          </span>
        <% end %>
      </div>
    </div>

    <%!-- Per-node operative rollup --%>
    <div data-testid={"node-rollup-#{ns.name}"} class="px-5 py-4 border-b border-brd-subtle">
      <p class="text-xs text-th-muted uppercase tracking-wider mb-3">
        Operatives per node
      </p>
      <p :if={ns.per_node == []} class="text-sm text-th-muted">
        No operative is placed in this namespace.
      </p>
      <table :if={ns.per_node != []} class="w-full text-sm">
        <thead>
          <tr class="border-b border-brd-subtle">
            <th class="text-left py-2 text-th-tertiary font-medium">Node</th>
            <th class="text-left py-2 text-th-tertiary font-medium">Operatives</th>
            <th class="text-left py-2 text-th-tertiary font-medium">Health</th>
            <th class="text-left py-2 text-th-tertiary font-medium">Hub recovery</th>
          </tr>
        </thead>
        <tbody>
          <tr
            :for={row <- ns.per_node}
            data-testid={"node-#{row.node}"}
            class="border-b border-brd-subtle last:border-b-0"
          >
            <td class="py-2 text-th-primary font-mono text-xs">{row.node}</td>
            <td
              data-testid={"node-count-#{row.node}"}
              class="py-2 text-th-secondary font-mono text-xs"
            >
              {row.count}
            </td>
            <td class="py-2">
              <span class="flex flex-wrap gap-1">
                <.health_badge :for={{health, count} <- row.health} health={health} count={count} />
              </span>
            </td>
            <td class="py-2 font-mono text-xs">
              <span
                :if={row.recovery in [:unavailable, :unreachable]}
                data-testid={"recovery-unavailable-#{row.node}"}
                class="text-th-muted"
              >
                unavailable
              </span>
              <span
                :if={row.recovery not in [:unavailable, :unreachable]}
                data-testid={"recovery-#{row.node}"}
                class={if row.recovery == :normal, do: "text-success", else: "text-warning"}
              >
                {if row.recovery == :normal, do: "serving", else: row.recovery}
              </span>
            </td>
          </tr>
        </tbody>
      </table>

      <div :if={ns.unplaced != []} data-testid={"unplaced-#{ns.name}"} class="mt-3">
        <p class="text-xs text-warning mb-1">
          {length(ns.unplaced)} operative(s) have no live node:
        </p>
        <p class="text-xs font-mono text-th-tertiary">
          {Enum.map_join(ns.unplaced, ", ", &to_string(&1.id))}
        </p>
      </div>
    </div>

    <%!-- Runners --%>
    <div class="px-5 py-4">
      <p class="text-xs text-th-muted uppercase tracking-wider mb-3">
        Runners ({length(ns.runners)})
        <span
          :if={ns.runner_principal}
          data-testid={"runner-principal-#{ns.name}"}
          class="ml-2 normal-case font-mono text-th-tertiary tracking-normal"
        >
          principal {ns.runner_principal}
        </span>
      </p>
      <%= if ns.runners == [] do %>
        <p data-testid={"runners-empty-#{ns.name}"} class="text-sm text-th-muted">
          No runner has connected to this namespace.
        </p>
      <% else %>
        <ul data-testid={"runners-#{ns.name}"} class="space-y-2">
          <li
            :for={runner <- ns.runners}
            data-testid={"runner-#{runner.id}"}
            class="bg-surface-input border border-brd rounded-xl px-4 py-3"
          >
            <p class="text-th-primary font-mono text-xs">{runner.id}</p>
            <p class="text-th-tertiary text-xs mt-1">
              {if runner.factories == [],
                do: "no factories registered",
                else: Enum.join(runner.factories, ", ")}
            </p>
          </li>
        </ul>
      <% end %>
    </div>

    <%!-- Factory placement --%>
    <div :if={ns.factories != []} class="px-5 py-4 border-t border-brd">
      <p class="text-xs text-th-muted uppercase tracking-wider mb-3">Factory placement</p>
      <div class="flex flex-wrap gap-2">
        <button
          :for={factory <- ns.factories}
          phx-click="select_factory"
          phx-value-namespace={ns.name}
          phx-value-factory={factory}
          data-testid={"factory-#{factory}"}
          class={
            "px-3 py-1.5 text-xs font-mono rounded-lg border transition-colors " <>
              if @selected_factory == {ns.name, factory},
                do: "bg-accent text-white border-accent",
                else: "bg-surface-input text-th-secondary border-brd hover:bg-surface-hover"
          }
        >
          {factory}
        </button>
      </div>

      <div :if={@selected_factory && elem(@selected_factory, 0) == ns.name} class="mt-4">
        <%= if @factory_runners == [] do %>
          <p data-testid="factory-runners-empty" class="text-sm text-th-muted">
            No runner currently serves <span class="font-mono">{elem(@selected_factory, 1)}</span>.
          </p>
        <% else %>
          <p data-testid="factory-runners" class="text-sm text-th-secondary">
            <span class="font-mono">{elem(@selected_factory, 1)}</span>
            is served by:
            <span class="font-mono text-th-primary">{Enum.join(@factory_runners, ", ")}</span>
          </p>
        <% end %>
        <button
          phx-click="clear_factory"
          class="mt-2 text-xs text-th-tertiary hover:text-th-primary transition-colors"
        >
          Clear
        </button>
      </div>
    </div>
  </div>
</div>
