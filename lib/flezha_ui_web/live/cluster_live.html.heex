<div class="space-y-6">
  <.header>Cluster</.header>

  <.runtime_error error={@load_error} />

  <%!-- Nodes --%>
  <.panel icon="hero-server-stack">
    <:title>Nodes ({length(@cluster_nodes)})</:title>
    <%= if @cluster_nodes == [] do %>
      <.empty_state icon="hero-server" testid="cluster-nodes-empty">
        No controller node is reachable.
      </.empty_state>
    <% else %>
      <ul data-testid="cluster-nodes" class="divide-y divide-brd-subtle">
        <li
          :for={node <- @cluster_nodes}
          data-testid={"cluster-node-#{node.name}"}
          class="px-5 py-3 flex items-center gap-3"
        >
          <span class={
            "w-2 h-2 rounded-full shrink-0 " <> if node.connected?, do: "bg-success", else: "bg-th-muted"
          }>
          </span>
          <span class="text-th-primary font-mono text-sm">{node.name}</span>
          <span
            :if={node.connected?}
            class="flz-badge ml-auto"
          >
            connected to this UI
          </span>
        </li>
      </ul>
    <% end %>
  </.panel>

  <%!-- Per-namespace hubs and fleet --%>
  <.empty_state
    :if={@namespaces == []}
    icon="hero-rectangle-stack"
    testid="cluster-namespaces-empty"
    boxed={true}
  >
    No namespace is running.
  </.empty_state>

  <div
    :for={ns <- @namespaces}
    data-testid={"cluster-namespace-#{ns.name}"}
    class="flz-panel"
  >
    <div class="px-5 py-4 border-b border-brd flex items-center justify-between">
      <div class="flex items-center gap-2">
        <.icon name="hero-rectangle-stack" class="w-4 h-4 text-th-secondary" />
        <h2 class="text-sm font-semibold text-th-primary font-mono">{ns.name}</h2>
      </div>
      <div class="flex items-center gap-2 text-xs text-th-secondary">
        <.button
          variant="ghost"
          size="sm"
          phx-click="open_recovery"
          phx-value-namespace={ns.name}
          data-testid={"open-recovery-#{ns.name}"}
        >
          Recovery
        </.button>
        <span>Hub:</span>
        <%= cond do %>
          <% ns.hub_error -> %>
            <span data-testid={"hub-nodes-#{ns.name}"} class="text-warning">
              {error_message(ns.hub_error, "the hub read")}
            </span>
          <% ns.hub_nodes == [] -> %>
            <span data-testid={"hub-nodes-#{ns.name}"} class="text-th-muted">no hub running</span>
          <% true -> %>
            <span data-testid={"hub-nodes-#{ns.name}"} class="font-mono text-th-secondary">
              {Enum.join(ns.hub_nodes, ", ")}
            </span>
        <% end %>
      </div>
    </div>

    <%!-- Per-node relay rollup --%>
    <div data-testid={"node-rollup-#{ns.name}"} class="px-5 py-4 border-b border-brd-subtle">
      <p class="text-xs text-th-muted uppercase tracking-wider mb-3">
        Relays per node
      </p>
      <p :if={ns.per_node == []} class="text-sm text-th-muted">
        No relay is placed in this namespace.
      </p>
      <table :if={ns.per_node != []} class="flz-table">
        <thead>
          <tr>
            <th>Node</th>
            <th>Relays</th>
            <th>Health</th>
            <th>Hub recovery</th>
          </tr>
        </thead>
        <tbody>
          <tr
            :for={row <- ns.per_node}
            data-testid={"node-#{row.node}"}
            class="last:border-b-0"
          >
            <td class="text-th-primary flz-num text-xs">{row.node}</td>
            <td
              data-testid={"node-count-#{row.node}"}
              class="flz-num text-xs"
            >
              {row.count}
            </td>
            <td>
              <span class="flex flex-wrap gap-1">
                <.health_badge :for={{health, count} <- row.health} health={health} count={count} />
              </span>
            </td>
            <td class="flz-num text-xs">
              <span
                :if={row.recovery in [:unavailable, :unreachable]}
                data-testid={"recovery-unavailable-#{row.node}"}
                class="text-th-muted"
              >
                unavailable
              </span>
              <span
                :if={row.recovery not in [:unavailable, :unreachable]}
                data-testid={"recovery-#{row.node}"}
                class={if row.recovery == :normal, do: "text-success", else: "text-warning"}
              >
                {recovery_label(row.recovery)}
              </span>
            </td>
          </tr>
        </tbody>
      </table>

      <div :if={ns.unplaced != []} data-testid={"unplaced-#{ns.name}"} class="mt-3">
        <p class="text-xs text-warning mb-1">
          {length(ns.unplaced)} relay(s) have no live node:
        </p>
        <p class="text-xs font-mono text-th-secondary">
          {Enum.map_join(ns.unplaced, ", ", &to_string(&1.id))}
        </p>
      </div>
    </div>

    <%!-- Runners --%>
    <div class="px-5 py-4">
      <p class="text-xs text-th-muted uppercase tracking-wider mb-3">
        Runners ({length(ns.runners)})
        <span
          :if={ns.runner_principal}
          data-testid={"runner-principal-#{ns.name}"}
          class="ml-2 normal-case font-mono text-th-secondary tracking-normal"
        >
          principal {ns.runner_principal}
        </span>
      </p>
      <.runner_table
        namespace={ns.name}
        runners={ns.runners}
        marks={ns.marks}
        factories?={true}
        can_drop={NodeManager.granted?(@operations, "Fleet.drop_runner")}
        can_readmit={NodeManager.granted?(@operations, "Fleet.readmit_runner")}
        error={FlezhaUiWeb.Live.RunnerActions.error_for(@runner_error, ns.name)}
      >
        <:empty>
          <p data-testid={"runners-empty-#{ns.name}"} class="text-sm text-th-muted">
            No runner has connected to this namespace.
          </p>
        </:empty>
      </.runner_table>
    </div>

    <%!-- Factory placement --%>
    <div :if={ns.factories != []} class="px-5 py-4 border-t border-brd">
      <p class="text-xs text-th-muted uppercase tracking-wider mb-3">Factory placement</p>
      <div class="flex flex-wrap gap-2">
        <button
          :for={factory <- ns.factories}
          phx-click="select_factory"
          phx-value-namespace={ns.name}
          phx-value-factory={factory.id}
          data-testid={"factory-#{factory.id}"}
          aria-pressed={to_string(@selected_factory == {ns.name, factory.id})}
          class="flz-segmented-option flz-num"
        >
          {factory.id} <span class="text-th-secondary">· {factory.run || "—"}</span>
        </button>
      </div>

      <div :if={@selected_factory && elem(@selected_factory, 0) == ns.name} class="mt-4">
        <%= if @factory_runners == [] do %>
          <p data-testid="factory-runners-empty" class="text-sm text-th-muted">
            No runner currently serves <span class="font-mono">{elem(@selected_factory, 1)}</span>.
          </p>
        <% else %>
          <p data-testid="factory-runners" class="text-sm text-th-secondary">
            <span class="font-mono">{elem(@selected_factory, 1)}</span>
            is served by:
            <span class="font-mono text-th-primary">{Enum.join(@factory_runners, ", ")}</span>
          </p>
        <% end %>
        <button
          phx-click="clear_factory"
          class="mt-2 flz-button flz-button--sm flz-button--ghost"
        >
          Clear
        </button>
      </div>
    </div>
  </div>

  <.runner_dialogs drop={@runner_drop} readmit={@runner_readmit} />

  <.dialog
    :if={@recovery}
    testid="recovery-modal"
    size="form"
    on_close="close_recovery"
    close_testid="recovery-close"
  >
    <:title>
      Recovery of
      <.mono>{@recovery.namespace}</.mono>
    </:title>
    <%= if @recovery.error do %>
      <div data-testid="recovery-error">
        <.runtime_error error={@recovery.error} action="the recovery read" />
      </div>
    <% else %>
      <dl class="flz-stats mb-4">
        <.stat label="Hub" testid="recovery-hub-id">{@recovery.hub_id}</.stat>
        <.stat label="On this node" testid="recovery-local">
          {recovery_label(@recovery.local)}
        </.stat>
      </dl>
      <div :if={@recovery.per_node_error} data-testid="recovery-per-node-error">
        <.runtime_error error={@recovery.per_node_error} action="the per-node recovery read" />
      </div>
      <table :if={@recovery.per_node != []} data-testid="recovery-per-node" class="flz-table">
        <thead>
          <tr>
            <th>Node</th>
            <th>Recovery</th>
          </tr>
        </thead>
        <tbody>
          <tr :for={{node, state} <- @recovery.per_node} data-testid={"recovery-node-#{node}"}>
            <td class="text-th-primary flz-num text-xs">{node}</td>
            <td class={[
              "flz-num text-xs",
              state == :normal && "text-success",
              state == :unreachable && "text-th-muted",
              state not in [:normal, :unreachable] && "text-warning"
            ]}>
              {recovery_label(state)}
            </td>
          </tr>
        </tbody>
      </table>
    <% end %>
  </.dialog>
</div>
