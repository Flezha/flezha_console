<div class="flex flex-col h-full space-y-4">
  <.header class="flex-shrink-0">
    Listen: <span class="font-mono text-base">{@relay_id}</span>
    <:actions>
      <%!-- IO type tabs --%>
      <div class="flex items-center gap-2">
        <%= if @status == :connecting do %>
          <span class="text-xs text-th-muted mr-1">Connecting...</span>
        <% end %>
        <div class="flz-segmented">
          <button
            :for={direction <- ~w(input output)}
            data-testid={"listen-direction-#{direction}"}
            phx-click="switch_direction"
            phx-value-direction={direction}
            disabled={@status == :connecting}
            aria-pressed={to_string(@direction == direction)}
            class="flz-segmented-option"
          >
            {String.capitalize(direction)}
          </button>
        </div>
      </div>
    </:actions>
  </.header>

  <.relay_tabs ns={@ns} relay_id={@relay_id} current={:listen} />

  <%!-- Controls bar --%>
  <div class="flex items-center gap-3 flex-shrink-0">
    <button
      data-testid="listen-pause"
      phx-click="toggle_pause"
      aria-pressed={to_string(@paused)}
      class={[
        "flz-button flz-button--sm",
        !@paused && "flz-button--secondary",
        @paused && "flz-button--warning"
      ]}
    >
      <%= if @paused do %>
        <.icon name="hero-play" class="w-3.5 h-3.5" /> Resume
      <% else %>
        <.icon name="hero-pause" class="w-3.5 h-3.5" /> Pause
      <% end %>
    </button>
    <button
      data-testid="listen-clear"
      phx-click="clear"
      class="flz-button flz-button--md flz-button--secondary"
    >
      <.icon name="hero-trash" class="w-3.5 h-3.5" /> Clear
    </button>
    <form phx-change="set_filter" class="flex-1 max-w-xs">
      <.input
        type="text"
        name="filter"
        value={@filter}
        placeholder="Filter regex..."
        compact
        mono
        data-testid="listen-filter"
      />
    </form>
    <span data-testid="listen-count" class="ml-auto text-xs text-th-secondary">
      {@message_count} messages received {if @paused, do: " (paused)"}
    </span>
  </div>

  <%!-- Message feed --%>
  <div
    data-testid="listen-feed"
    class="flz-panel flex-1 overflow-y-auto font-mono text-xs"
    id="listen-feed"
    phx-hook="ScrollBottom"
  >
    <%= case @status do %>
      <% :connecting -> %>
        <div data-testid="listen-connecting" class="p-6 text-center">
          <div class="inline-flex items-center gap-2 text-th-secondary">
            <svg
              class="animate-spin h-4 w-4"
              xmlns="http://www.w3.org/2000/svg"
              fill="none"
              viewBox="0 0 24 24"
            >
              <circle
                class="opacity-25"
                cx="12"
                cy="12"
                r="10"
                stroke="currentColor"
                stroke-width="4"
              >
              </circle>
              <path
                class="opacity-75"
                fill="currentColor"
                d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4z"
              >
              </path>
            </svg>
            <span>Attaching a listener to the relay's {@direction}s...</span>
          </div>
        </div>
      <% :error -> %>
        <div data-testid="listen-error" class="p-6">
          <.runtime_error error={@error} action={"listening to this relay's #{@direction}s"} />
        </div>
      <% :ended -> %>
        <div data-testid="listen-ended" class="p-6 text-center text-th-muted">
          The relay ended, so the listen is over.
        </div>
      <% :connected -> %>
        <% display_messages = filtered_messages(@messages, @filter) %>
        <%= if display_messages == [] do %>
          <div data-testid="listen-empty" class="p-6 text-th-muted text-center">
            Waiting for the relay's {@direction}s...
          </div>
        <% else %>
          <%= for msg <- Enum.reverse(display_messages) do %>
            <div
              data-testid="listen-message"
              data-kind={msg.kind}
              class="flex gap-3 px-4 py-2 border-b border-brd-subtle hover:bg-surface-hover transition-colors"
            >
              <span class="text-th-muted flex-shrink-0 w-28">
                {Format.time_of_day(msg.timestamp)}
              </span>
              <span class="text-th-brand flex-1 break-all whitespace-pre-wrap">
                {msg.message}
              </span>
              <%= if msg.metadata && msg.metadata != %{} do %>
                <span class="text-th-muted flex-shrink-0 text-xs">
                  {Enum.map_join(msg.metadata, ", ", fn {k, v} -> "#{k}=#{inspect(v)}" end)}
                </span>
              <% end %>
            </div>
          <% end %>
        <% end %>
    <% end %>
  </div>
</div>
