<div class="space-y-6">
  <.header>Plugins</.header>

  <%!-- Available Providers Grid --%>
  <%= if @available_providers == [] do %>
    <.empty_state icon="hero-puzzle-piece" boxed={true}>
      No providers discovered from agent.
    </.empty_state>
  <% else %>
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-4">
      <%= for provider <- @available_providers do %>
        <div class="flz-panel group p-5 flex flex-col gap-3 transition-shadow hover:shadow-md">
          <div class="flex items-center justify-between">
            <div class="flex items-center gap-2">
              <.icon
                name="hero-cube"
                class="w-4 h-4 text-th-tertiary group-hover:text-accent transition-colors"
              />
              <h3 class="text-sm font-semibold text-th-primary">
                {Format.humanize(provider.id)}
              </h3>
            </div>
            <%= if provider.internal? do %>
              <span class="flz-badge uppercase tracking-wider">
                Internal
              </span>
            <% end %>
          </div>

          <div class="space-y-1 text-xs">
            <p class="text-th-secondary">
              <span class="text-th-tertiary">ID:</span>
              <span class="font-mono">{provider.id}</span>
            </p>
            <p class="text-th-secondary">
              <span class="text-th-tertiary">Module:</span>
              <span class="font-mono">{provider.module}</span>
            </p>
            <p class="text-th-secondary">
              <span class="text-th-tertiary">Type:</span> {provider.type}
            </p>
          </div>

          <%= if provider.required_fields != [] do %>
            <div>
              <p class="flz-label mb-1">Required</p>
              <div class="flex flex-wrap gap-1">
                <%= for field <- provider.required_fields do %>
                  <span class="flz-badge flz-num">
                    {field}
                  </span>
                <% end %>
              </div>
            </div>
          <% end %>

          <%= if provider.optional_fields != [] do %>
            <div>
              <p class="flz-label mb-1">Optional</p>
              <div class="flex flex-wrap gap-1">
                <%= for field <- provider.optional_fields do %>
                  <span class="flz-badge flz-num opacity-70">
                    {field}
                  </span>
                <% end %>
              </div>
            </div>
          <% end %>
        </div>
      <% end %>
    </div>
  <% end %>

  <%!-- Active Plugins --%>
  <h2 class="flz-modal-title pt-2">Active Plugins</h2>

  <%= if @plugins == [] do %>
    <.empty_state icon="hero-puzzle-piece" boxed={true}>
      No active plugins found.
    </.empty_state>
  <% else %>
    <div class="flz-panel overflow-hidden">
      <table class="flz-table">
        <thead>
          <tr>
            <th>Plugin ID</th>
            <th>Provider</th>
            <th>Extensions</th>
            <th>Namespace</th>
            <th>Operative</th>
            <th></th>
          </tr>
        </thead>
        <tbody>
          <%= for plugin <- @plugins do %>
            <tr data-testid={"plugin-row-#{plugin.id}"}>
              <td class="text-th-primary flz-num text-xs">{plugin.id}</td>
              <td class="text-xs">{plugin.provider}</td>
              <td class="text-xs">{plugin.extensions}</td>
              <td class="text-xs">{plugin.namespace || "—"}</td>
              <td class="flz-num text-xs">
                {plugin.operative_id || "—"}
              </td>
              <td class="text-right">
                <button
                  phx-click="confirm_disable"
                  phx-value-plugin_id={plugin.id}
                  class="text-xs text-danger-text hover:text-danger transition-colors"
                >
                  Disable
                </button>
              </td>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>
  <% end %>
</div>

<.confirm_dialog
  :if={@confirm_disable}
  title="Disable Plugin?"
  confirm_label="Disable"
  on_confirm="disable_plugin"
  on_cancel="cancel_disable"
  values={%{"plugin_id" => @confirm_disable}}
>
  Disable plugin <.mono>{@confirm_disable}</.mono>?
</.confirm_dialog>

<.panel testid="installed-catalog" icon="hero-archive-box" class="overflow-hidden mt-6">
  <:title>Installed on the controller ({length(@catalog)})</:title>

  <p class="px-5 py-2 text-xs text-th-muted border-b border-brd-subtle">
    Installing, upgrading and uninstalling move files on the controller host — those are
    <code class="font-mono">flz plugin</code>
    verbs, not control-panel actions.
  </p>

  <.notice
    :if={@catalog_error}
    kind={:info}
    testid="catalog-unavailable"
    class="m-5"
  >
    The installed-plugin catalog is unavailable on this controller. The enabled plugins above
    still list normally.
  </.notice>

  <.empty_state :if={@catalog == [] and is_nil(@catalog_error)} icon="hero-archive-box">
    No plugins are installed on the controller host.
  </.empty_state>

  <table :if={@catalog != []} class="flz-table">
    <thead>
      <tr>
        <th>Plugin</th>
        <th>Version</th>
        <th>Status</th>
        <th>Description</th>
      </tr>
    </thead>
    <tbody>
      <tr
        :for={plugin <- @catalog}
        data-testid={"installed-#{plugin[:id]}"}
      >
        <td class="text-th-primary flz-num text-xs">{plugin[:id]}</td>
        <td class="flz-num text-xs">{plugin[:version]}</td>
        <td>
          <span
            data-testid={"installed-status-#{plugin[:id]}"}
            class={[
              "inline-flex items-center px-2 py-0.5 rounded-lg text-[11px]",
              if(plugin[:status] == :enabled,
                do: "bg-success/10 text-success",
                else: "bg-surface-input text-th-tertiary"
              )
            ]}
          >
            {plugin[:status]}
          </span>
        </td>
        <td class="text-xs">{plugin[:description] || "—"}</td>
      </tr>
    </tbody>
  </table>
</.panel>
