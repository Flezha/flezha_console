<.page_header
  eyebrow="Plugins"
  title={(@scoped_namespace && "Plugins in #{@scoped_namespace}") || "Every plugin"}
>
  <:sentence>
    A <.term key="plugin" /> is a <.term key="provider" />
    enabled by name and bound to relays on <.term key="hook">hooks</.term>. {if @scoped_namespace,
      do: "These are enabled in #{@scoped_namespace}.",
      else: "These are enabled in every namespace you can reach."}
  </:sentence>
  <:actions>
    <.segmented label="Scope" testid="scope-switch">
      <:option
        :if={@shell_namespace}
        patch={~p"/namespaces/#{@shell_namespace}/plugins"}
        current={@scoped_namespace != nil}
        testid="scope-namespace"
      >
        {@shell_namespace}
      </:option>
      <:option patch={~p"/plugins"} current={is_nil(@scoped_namespace)} testid="scope-all">
        All namespaces
      </:option>
    </.segmented>
    <.button
      :if={NodeManager.granted?(@operations, "PluginManager.enable")}
      phx-click="plugin_form_open"
      phx-value-mode="enable"
      phx-value-namespace={@scoped_namespace}
      data-testid="enable-plugin-btn"
      icon="hero-plus"
    >
      Enable plugin
    </.button>
  </:actions>
</.page_header>

<div :for={{namespace, reason} <- @refused} data-testid={"plugins-refused-#{namespace}"}>
  <.runtime_error error={reason} action={"the plugin listing of #{namespace}"} />
</div>

<.runtime_error error={@namespaces_error} action="list the namespaces" />

<.skeleton :if={!@loaded?} rows={4} testid="plugins-loading" />

<%!-- Enabled plugins --%>
<.empty_state
  :if={@loaded? and @plugins == [] and is_nil(@namespaces_error)}
  icon="hero-puzzle-piece"
  testid="plugins-empty"
>
  A plugin adds behaviour to relays — reading their input, carrying their output — once a provider
  is enabled by name. <span :if={@scoped_namespace}>None is enabled in {@scoped_namespace}.</span>
  <span :if={!@scoped_namespace}>None is enabled.</span>
  <:action :if={NodeManager.granted?(@operations, "PluginManager.enable")}>
    <.button
      size="sm"
      phx-click="plugin_form_open"
      phx-value-mode="enable"
      phx-value-namespace={@scoped_namespace}
      data-testid="enable-plugin-empty-btn"
    >
      Enable plugin
    </.button>
  </:action>
</.empty_state>

<.grid
  :if={@plugins != []}
  paging={@paging}
  id="plugins"
  rows={@plugins}
  row_testid={&"plugin-row-#{&1.name}"}
  row_tone={&(&1[:lagging] not in [nil, []] && "warning")}
  row_label={&"Inspect #{&1.name}"}
  row_activate={
    &JS.push("inspect", value: %{kind: "plugin", id: inspect_id(&1, @scoped_namespace)})
  }
  row_selected={
    &(@inspected != nil and @inspected.kind == "plugin" and
        @inspected.id == inspect_id(&1, @scoped_namespace))
  }
>
  <:col :let={plugin} label="Plugin">
    <span class="fui-num">{plugin.name}</span>
    <span
      :if={plugin[:single]}
      data-testid={"plugin-single-#{plugin.name}"}
      class="fui-badge ml-1"
    >
      Single
    </span>
  </:col>
  <:col :let={plugin} label="Provider">
    <span class="font-medium">{Format.humanize(provider_id(plugin))}</span>
    <span
      :if={@provider_details[provider_id(plugin)][:description]}
      class="block fui-muted text-xs"
      data-testid={"plugin-description-#{plugin.name}"}
    >
      {@provider_details[provider_id(plugin)].description}
    </span>
  </:col>
  <:col :let={plugin} label="Hooks">
    <span class="flex flex-wrap gap-1">
      <.chip :for={hook <- plugin[:hooks] || []} mono>{hook}</.chip>
    </span>
  </:col>
  <:col :let={plugin} :if={!@scoped_namespace} label="Namespace">
    <span class="fui-num">{plugin.namespace}</span>
  </:col>
  <:col :let={plugin} label="Relays">
    <span data-testid={"plugin-relays-#{plugin.name}"} class="fui-num">
      {join_or_dash(plugin[:relays])}
    </span>
  </:col>
  <:col :let={plugin} label="Runs on">
    <span class="fui-num" data-testid={"plugin-controllers-#{plugin.name}"}>
      {join_or_dash(plugin[:controllers])}
    </span>
    <span
      :if={plugin[:lagging] not in [nil, []]}
      data-testid={"plugin-lagging-#{plugin.name}"}
      class="fui-badge fui-badge--warning ml-1"
    >
      Lagging on {Enum.join(plugin.lagging, ", ")}
    </span>
  </:col>
  <:menu :let={plugin}>
    <.row_menu
      id={"plugin-menu-#{plugin.namespace}-#{plugin.name}"}
      label={"Actions for #{plugin.name}"}
      testid={"plugin-menu-#{plugin.name}"}
    >
      <:item
        click="inspect"
        values={%{kind: "plugin", id: inspect_id(plugin, @scoped_namespace)}}
        icon="hero-eye"
        testid={"plugin-inspect-#{plugin.name}"}
      >
        Inspect
      </:item>
      <:item
        :if={
          not controller_plugin?(plugin, @available_providers) and
            NodeManager.granted?(@operations, "PluginManager.bind")
        }
        click="plugin_form_open"
        values={
          %{
            mode: "bind",
            name: plugin.name,
            provider: provider_id(plugin),
            namespace: plugin.namespace
          }
        }
        testid={"plugin-bind-#{plugin.name}"}
      >
        Bind to a relay
      </:item>
      <:item
        :if={NodeManager.granted?(@operations, "PluginManager.update")}
        click="plugin_form_open"
        values={
          %{
            mode: "update",
            name: plugin.name,
            provider: provider_id(plugin),
            namespace: plugin.namespace,
            hooks: Enum.join(plugin[:hooks] || [], ",")
          }
        }
        testid={"plugin-update-#{plugin.name}"}
      >
        Update options
      </:item>
      <:item
        :for={
          relay <-
            (NodeManager.granted?(@operations, "PluginManager.unbind") && plugin[:relays]) || []
        }
        click="confirm_unbind"
        values={%{name: plugin.name, namespace: plugin.namespace, relay: relay}}
        testid={"plugin-unbind-#{plugin.name}-#{relay}"}
        danger
      >
        Unbind {relay}
      </:item>
      <:item
        :if={NodeManager.granted?(@operations, "PluginManager.disable")}
        click="confirm_disable"
        values={%{name: plugin.name, namespace: plugin.namespace}}
        testid={"plugin-disable-#{plugin.name}"}
        danger
      >
        Disable
      </:item>
    </.row_menu>
  </:menu>
</.grid>

<%!-- What the controller can enable --%>
<.section
  testid="providers-panel"
  fold="providers"
  open={@sections["providers"]}
  digest={Words.count(length(@available_providers), "provider")}
>
  <:title>Providers this controller offers</:title>
  <.runtime_error error={@providers_error} action="the provider listing" />
  <.notice :if={@refused_packages > 0} kind={:error} testid="providers-refused">
    The controller refused {Words.count(@refused_packages, "installed package")} at boot; their
    providers are not offered. The installed catalog below says why.
  </.notice>
  <.empty_state
    :if={@available_providers == [] and is_nil(@providers_error)}
    icon="hero-puzzle-piece"
  >
    This controller offers no plugin providers.
  </.empty_state>
  <.paged :let={page} id="providers" rows={@available_providers} paging={@paging}>
    <div :if={@available_providers != []} class="fui-tiles">
      <div
        :for={provider <- page}
        data-testid={"provider-#{provider.id}"}
        class="fui-tile flz-tile"
      >
        <p class="font-medium">{Format.humanize(provider.id)}</p>
        <p :if={@provider_details[to_string(provider.id)][:description]} class="fui-quiet text-sm">
          {@provider_details[to_string(provider.id)].description}
        </p>
        <p class="flex flex-wrap gap-1">
          <.chip
            :for={hook <- (@provider_details[to_string(provider.id)] || %{hooks: []}).hooks}
            mono
          >
            {hook}
          </.chip>
        </p>
        <p class="fui-muted text-xs">Runs on the {provider.type}.</p>
        <details data-testid={"provider-module-#{provider.id}"}>
          <summary class="fui-label cursor-pointer">Implementation</summary>
          <p class="fui-num text-xs mt-1">{provider.module}</p>
        </details>
      </div>
    </div>
  </.paged>
</.section>

<.inspector inspected={@inspected} operations={@operations} />

<.confirm_dialog
  :if={@confirm_disable}
  title="Disable Plugin?"
  confirm_label="Disable"
  on_confirm="disable_plugin"
  on_cancel="cancel_disable"
  values={%{"name" => @confirm_disable.name, "namespace" => @confirm_disable.namespace}}
  testid="plugin-disable-modal"
  cancel_testid="plugin-disable-cancel"
  confirm_testid="plugin-disable-confirm"
>
  Disable plugin <span class="fui-ident">{@confirm_disable.name}</span>
  in <span class="fui-ident">{@confirm_disable.namespace}</span>? Every running copy stops; its bindings stay.
</.confirm_dialog>

<.confirm_dialog
  :if={@confirm_unbind}
  title="Unbind relay?"
  confirm_label="Unbind"
  on_confirm="unbind_plugin"
  on_cancel="cancel_unbind"
  values={
    %{
      "name" => @confirm_unbind.name,
      "namespace" => @confirm_unbind.namespace,
      "relay" => @confirm_unbind.relay
    }
  }
  testid="plugin-unbind-modal"
  cancel_testid="plugin-unbind-cancel"
  confirm_testid="plugin-unbind-confirm"
>
  Unbind <span class="fui-ident">{@confirm_unbind.relay}</span>
  from plugin <span class="fui-ident">{@confirm_unbind.name}</span>? The plugin stays enabled; this relay stops
  using it.
</.confirm_dialog>

<.plugin_form_dialog form={@plugin_form} />

<.section testid="installed-catalog" digest={Words.count(length(@catalog), "package")}>
  <:title>Installed on the controller</:title>

  <p class="fui-figures mb-3">
    Installing, upgrading and uninstalling move files on the controller host — those are
    <code>flz plugin</code>
    verbs, not control-panel actions.
  </p>

  <.notice
    :if={@catalog_error}
    kind={:info}
    testid="catalog-unavailable"
  >
    The installed-plugin catalog is unavailable on this controller. The enabled plugins above
    still list normally.
  </.notice>

  <.empty_state :if={@catalog == [] and is_nil(@catalog_error)} icon="hero-archive-box">
    No plugins are installed on the controller host.
  </.empty_state>

  <div :if={@catalog != []} class="mt-3">
    <.grid
      paging={@paging}
      id="installed-plugins"
      rows={@catalog}
      row_testid={&"installed-#{&1[:id]}"}
    >
      <:col :let={plugin} label="Plugin" class="fui-strong fui-num text-xs">{plugin[:id]}</:col>
      <:col :let={plugin} label="Version" class="fui-num text-xs">
        {plugin[:version]}
        <span
          :if={plugin[:status] == :pending and plugin[:loaded_version]}
          data-testid={"installed-loaded-#{plugin[:id]}"}
          class="block fui-muted"
        >
          {plugin[:loaded_version]} still loaded until the next boot
        </span>
      </:col>
      <:col :let={plugin} label="Status">
        <span
          data-testid={"installed-status-#{plugin[:id]}"}
          class={["fui-badge", plugin[:status] == :loaded && "fui-badge--positive"]}
        >
          {Words.humanize(plugin[:status])}
        </span>
      </:col>
      <:col :let={plugin} label="Providers" class="text-xs">
        <div data-testid={"installed-providers-#{plugin[:id]}"}>
          {join_or_dash(plugin[:providers])}
          <div :if={plugin[:error]} data-testid={"installed-error-#{plugin[:id]}"} class="mt-2">
            <.runtime_error error={plugin.error} action="the package" />
          </div>
        </div>
      </:col>
    </.grid>
  </div>
</.section>
