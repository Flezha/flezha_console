<div class="space-y-6">
  <.header>
    Plugins
    <:subtitle :if={@scoped_namespace}>
      Enabled in <span class="flz-num">{@scoped_namespace}</span>.
    </:subtitle>
    <:actions>
      <.button
        :if={NodeManager.granted?(@operations, "PluginManager.enable")}
        phx-click="plugin_form_open"
        phx-value-mode="enable"
        phx-value-namespace={@scoped_namespace}
        data-testid="enable-plugin-btn"
        icon="hero-plus"
      >
        Enable Plugin
      </.button>
    </:actions>
  </.header>

  <%!-- Available Providers Grid --%>
  <.runtime_error error={@providers_error} action="the provider listing" />
  <.notice :if={@refused_packages > 0} kind={:error} testid="providers-refused">
    The controller refused {@refused_packages} installed package{if @refused_packages != 1,
      do: "s"} at boot; their providers are not offered. The installed catalog below says why.
  </.notice>
  <%= if @available_providers == [] do %>
    <.empty_state :if={is_nil(@providers_error)} icon="hero-puzzle-piece" boxed={true}>
      This controller offers no plugin providers.
    </.empty_state>
  <% else %>
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-4">
      <div
        :for={provider <- @available_providers}
        data-testid={"provider-#{provider.id}"}
        class="flz-card"
      >
        <div class="flex items-center gap-2">
          <.icon
            name="hero-cube"
            class="w-4 h-4 text-th-secondary"
          />
          <h3 class="text-sm font-semibold text-th-primary">
            {Format.humanize(provider.id)}
          </h3>
        </div>

        <div class="space-y-1 text-xs">
          <p class="text-th-secondary">
            <span class="text-th-secondary">ID:</span>
            <span class="font-mono">{provider.id}</span>
          </p>
          <p class="text-th-secondary">
            <span class="text-th-secondary">Module:</span>
            <span class="font-mono">{provider.module}</span>
          </p>
          <p class="text-th-secondary">
            <span class="text-th-secondary">Type:</span> {provider.type}
          </p>
        </div>
      </div>
    </div>
  <% end %>

  <%!-- Enabled Plugins --%>
  <h2 class="flz-modal-title pt-2">Enabled Plugins</h2>

  <div :for={{namespace, reason} <- @refused} data-testid={"plugins-refused-#{namespace}"}>
    <.runtime_error error={reason} action={"the plugin listing of #{namespace}"} />
  </div>

  <%= if @plugins == [] do %>
    <.empty_state icon="hero-puzzle-piece" boxed={true} testid="plugins-empty">
      <span :if={@scoped_namespace}>No plugin is enabled in {@scoped_namespace}.</span>
      <span :if={!@scoped_namespace}>No plugin is enabled.</span>
    </.empty_state>
  <% else %>
    <div class="flz-panel overflow-hidden">
      <table class="flz-table">
        <thead>
          <tr>
            <th>Plugin</th>
            <th>Provider</th>
            <th>Hooks</th>
            <th>Namespace</th>
            <th>Relays</th>
            <th>Runs on</th>
            <th></th>
          </tr>
        </thead>
        <tbody>
          <tr :for={plugin <- @plugins} data-testid={"plugin-row-#{plugin.name}"}>
            <td class="text-th-primary flz-num text-xs">
              {plugin.name}
              <span
                :if={plugin[:single]}
                data-testid={"plugin-single-#{plugin.name}"}
                class="flz-badge"
              >
                single
              </span>
            </td>
            <td class="text-xs">{plugin.provider}</td>
            <td class="text-xs">{join_or_dash(plugin[:hooks])}</td>
            <td class="text-xs">{plugin.namespace}</td>
            <td class="flz-num text-xs" data-testid={"plugin-relays-#{plugin.name}"}>
              <span :if={plugin[:relays] in [nil, []]}>—</span>
              <span
                :for={relay <- plugin[:relays] || []}
                class="inline-flex items-center gap-1 mr-2"
              >
                {relay}
                <button
                  :if={NodeManager.granted?(@operations, "PluginManager.unbind")}
                  phx-click="confirm_unbind"
                  phx-value-name={plugin.name}
                  phx-value-namespace={plugin.namespace}
                  phx-value-relay={relay}
                  data-testid={"plugin-unbind-#{plugin.name}-#{relay}"}
                  class="text-danger-text hover:text-danger"
                  aria-label={"Unbind #{relay}"}
                >
                  <.icon name="hero-x-mark" class="w-3 h-3" />
                </button>
              </span>
            </td>
            <td class="flz-num text-xs" data-testid={"plugin-controllers-#{plugin.name}"}>
              {join_or_dash(plugin[:controllers])}
              <span
                :if={plugin[:lagging] not in [nil, []]}
                data-testid={"plugin-lagging-#{plugin.name}"}
                class="flz-badge flz-badge--warning ml-1"
              >
                lagging on {Enum.join(plugin.lagging, ", ")}
              </span>
            </td>
            <td class="text-right whitespace-nowrap space-x-3">
              <button
                :if={
                  not controller_plugin?(plugin, @available_providers) and
                    NodeManager.granted?(@operations, "PluginManager.bind")
                }
                phx-click="plugin_form_open"
                phx-value-mode="bind"
                phx-value-name={plugin.name}
                phx-value-provider={provider_id(plugin)}
                phx-value-namespace={plugin.namespace}
                data-testid={"plugin-bind-#{plugin.name}"}
                class="flz-button flz-button--sm flz-button--ghost"
              >
                Bind
              </button>
              <button
                :if={NodeManager.granted?(@operations, "PluginManager.update")}
                phx-click="plugin_form_open"
                phx-value-mode="update"
                phx-value-name={plugin.name}
                phx-value-provider={provider_id(plugin)}
                phx-value-namespace={plugin.namespace}
                phx-value-hooks={Enum.join(plugin[:hooks] || [], ",")}
                data-testid={"plugin-update-#{plugin.name}"}
                class="flz-button flz-button--sm flz-button--ghost"
              >
                Update
              </button>
              <button
                :if={NodeManager.granted?(@operations, "PluginManager.disable")}
                phx-click="confirm_disable"
                phx-value-name={plugin.name}
                phx-value-namespace={plugin.namespace}
                data-testid={"plugin-disable-#{plugin.name}"}
                class="flz-button flz-button--sm flz-button--ghost"
              >
                Disable
              </button>
            </td>
          </tr>
        </tbody>
      </table>
    </div>
  <% end %>
</div>

<.confirm_dialog
  :if={@confirm_disable}
  title="Disable Plugin?"
  confirm_label="Disable"
  on_confirm="disable_plugin"
  on_cancel="cancel_disable"
  values={%{"name" => @confirm_disable.name, "namespace" => @confirm_disable.namespace}}
  testid="plugin-disable-modal"
  cancel_testid="plugin-disable-cancel"
  confirm_testid="plugin-disable-confirm"
>
  Disable plugin
  <.mono>{@confirm_disable.name}</.mono>
  in <.mono>{@confirm_disable.namespace}</.mono>? Every running copy stops; its bindings stay.
</.confirm_dialog>

<.confirm_dialog
  :if={@confirm_unbind}
  title="Unbind relay?"
  confirm_label="Unbind"
  on_confirm="unbind_plugin"
  on_cancel="cancel_unbind"
  values={
    %{
      "name" => @confirm_unbind.name,
      "namespace" => @confirm_unbind.namespace,
      "relay" => @confirm_unbind.relay
    }
  }
  testid="plugin-unbind-modal"
  cancel_testid="plugin-unbind-cancel"
  confirm_testid="plugin-unbind-confirm"
>
  Unbind
  <.mono>{@confirm_unbind.relay}</.mono>
  from plugin <.mono>{@confirm_unbind.name}</.mono>? The plugin stays enabled; this relay stops
  using it.
</.confirm_dialog>

<.plugin_form_dialog form={@plugin_form} />

<.panel testid="installed-catalog" icon="hero-archive-box" class="overflow-hidden mt-6">
  <:title>Installed on the controller ({length(@catalog)})</:title>

  <p class="px-5 py-2 text-xs text-th-muted border-b border-brd-subtle">
    Installing, upgrading and uninstalling move files on the controller host — those are
    <code class="font-mono">flz plugin</code>
    verbs, not control-panel actions.
  </p>

  <.notice
    :if={@catalog_error}
    kind={:info}
    testid="catalog-unavailable"
    class="m-5"
  >
    The installed-plugin catalog is unavailable on this controller. The enabled plugins above
    still list normally.
  </.notice>

  <.empty_state :if={@catalog == [] and is_nil(@catalog_error)} icon="hero-archive-box">
    No plugins are installed on the controller host.
  </.empty_state>

  <table :if={@catalog != []} class="flz-table">
    <thead>
      <tr>
        <th>Plugin</th>
        <th>Version</th>
        <th>Status</th>
        <th>Providers</th>
      </tr>
    </thead>
    <tbody>
      <tr
        :for={plugin <- @catalog}
        data-testid={"installed-#{plugin[:id]}"}
      >
        <td class="text-th-primary flz-num text-xs">{plugin[:id]}</td>
        <td class="flz-num text-xs">
          {plugin[:version]}
          <span
            :if={plugin[:status] == :pending and plugin[:loaded_version]}
            data-testid={"installed-loaded-#{plugin[:id]}"}
            class="block text-th-muted"
          >
            {plugin[:loaded_version]} still loaded until the next boot
          </span>
        </td>
        <td>
          <span
            data-testid={"installed-status-#{plugin[:id]}"}
            class={["flz-badge", plugin[:status] == :loaded && "flz-badge--positive"]}
          >
            {plugin[:status]}
          </span>
        </td>
        <td class="text-xs" data-testid={"installed-providers-#{plugin[:id]}"}>
          {join_or_dash(plugin[:providers])}
          <div :if={plugin[:error]} data-testid={"installed-error-#{plugin[:id]}"} class="mt-2">
            <.runtime_error error={plugin.error} action="the package" />
          </div>
        </td>
      </tr>
    </tbody>
  </table>
</.panel>
