<div class="space-y-6">
  <h1 class="text-2xl font-bold text-white">Active Plugins</h1>

  <%= if @plugins == [] do %>
    <div class="bg-zinc-900 border border-zinc-800 rounded-lg px-6 py-10 text-center">
      <p class="text-zinc-400">No active plugins found.</p>
    </div>
  <% else %>
    <div class="bg-zinc-900 border border-zinc-800 rounded-lg overflow-hidden">
      <table class="w-full text-sm">
        <thead>
          <tr class="border-b border-zinc-800">
            <th class="text-left px-5 py-3 text-zinc-400 font-medium">Plugin ID</th>
            <th class="text-left px-5 py-3 text-zinc-400 font-medium">Provider</th>
            <th class="text-left px-5 py-3 text-zinc-400 font-medium">Namespace</th>
            <th class="text-left px-5 py-3 text-zinc-400 font-medium">Processor</th>
            <th class="text-left px-5 py-3 text-zinc-400 font-medium">Trigger</th>
            <th class="px-5 py-3"></th>
          </tr>
        </thead>
        <tbody>
          <%= for plugin <- @plugins do %>
            <tr class="border-b border-zinc-800/50 hover:bg-zinc-800/30">
              <td class="px-5 py-3 text-white font-mono text-xs"><%= plugin.id %></td>
              <td class="px-5 py-3 text-zinc-300 text-xs"><%= plugin.module %></td>
              <td class="px-5 py-3 text-zinc-400 text-xs"><%= plugin.namespace || "—" %></td>
              <td class="px-5 py-3 text-zinc-400 font-mono text-xs"><%= plugin.processor_id || "—" %></td>
              <td class="px-5 py-3 text-zinc-400 text-xs"><%= plugin.trigger || "—" %></td>
              <td class="px-5 py-3 text-right">
                <button phx-click="confirm_disable" phx-value-plugin_id={plugin.id}
                  class="text-xs text-red-400 hover:text-red-300 transition-colors">
                  Disable
                </button>
              </td>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>
  <% end %>
</div>

<%= if @confirm_disable do %>
  <div class="fixed inset-0 z-50 flex items-center justify-center bg-black/60">
    <div class="bg-zinc-900 border border-zinc-700 rounded-xl w-full max-w-sm p-6 shadow-xl">
      <h3 class="text-lg font-semibold text-white mb-3">Disable Plugin?</h3>
      <p class="text-sm text-zinc-400 mb-5">
        Disable plugin <span class="text-white font-mono"><%= @confirm_disable %></span>?
      </p>
      <div class="flex justify-end gap-3">
        <button phx-click="cancel_disable" class="px-4 py-2 text-sm text-zinc-300 hover:text-white">Cancel</button>
        <button phx-click="disable_plugin" phx-value-plugin_id={@confirm_disable}
          class="px-4 py-2 text-sm font-medium text-white bg-red-600 hover:bg-red-500 rounded-md">
          Disable
        </button>
      </div>
    </div>
  </div>
<% end %>
