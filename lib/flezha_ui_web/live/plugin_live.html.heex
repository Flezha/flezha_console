<div class="space-y-6">
  <.header>
    Plugins
    <:subtitle :if={@scoped_namespace}>
      Enabled in <span class="flz-num">{@scoped_namespace}</span>.
    </:subtitle>
  </.header>

  <%!-- Available Providers Grid --%>
  <.runtime_error error={@providers_error} action="the provider listing" />
  <%= if @available_providers == [] do %>
    <.empty_state :if={is_nil(@providers_error)} icon="hero-puzzle-piece" boxed={true}>
      This controller offers no plugin providers.
    </.empty_state>
  <% else %>
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-4">
      <div
        :for={provider <- @available_providers}
        data-testid={"provider-#{provider.id}"}
        class="flz-panel group p-5 flex flex-col gap-3 transition-shadow hover:shadow-md"
      >
        <div class="flex items-center gap-2">
          <.icon
            name="hero-cube"
            class="w-4 h-4 text-th-tertiary group-hover:text-accent transition-colors"
          />
          <h3 class="text-sm font-semibold text-th-primary">
            {Format.humanize(provider.id)}
          </h3>
        </div>

        <div class="space-y-1 text-xs">
          <p class="text-th-secondary">
            <span class="text-th-tertiary">ID:</span>
            <span class="font-mono">{provider.id}</span>
          </p>
          <p class="text-th-secondary">
            <span class="text-th-tertiary">Module:</span>
            <span class="font-mono">{provider.module}</span>
          </p>
          <p class="text-th-secondary">
            <span class="text-th-tertiary">Type:</span> {provider.type}
          </p>
        </div>
      </div>
    </div>
  <% end %>

  <%!-- Enabled Plugins --%>
  <h2 class="flz-modal-title pt-2">Enabled Plugins</h2>

  <div :for={{namespace, reason} <- @refused} data-testid={"plugins-refused-#{namespace}"}>
    <.runtime_error error={reason} action={"the plugin listing of #{namespace}"} />
  </div>

  <%= if @plugins == [] do %>
    <.empty_state icon="hero-puzzle-piece" boxed={true} testid="plugins-empty">
      <span :if={@scoped_namespace}>No plugin is enabled in {@scoped_namespace}.</span>
      <span :if={!@scoped_namespace}>No plugin is enabled.</span>
    </.empty_state>
  <% else %>
    <div class="flz-panel overflow-hidden">
      <table class="flz-table">
        <thead>
          <tr>
            <th>Plugin</th>
            <th>Provider</th>
            <th>Hooks</th>
            <th>Namespace</th>
            <th>Relays</th>
            <th></th>
          </tr>
        </thead>
        <tbody>
          <tr :for={plugin <- @plugins} data-testid={"plugin-row-#{plugin.name}"}>
            <td class="text-th-primary flz-num text-xs">{plugin.name}</td>
            <td class="text-xs">{plugin.provider}</td>
            <td class="text-xs">{join_or_dash(plugin[:hooks])}</td>
            <td class="text-xs">{plugin.namespace}</td>
            <td class="flz-num text-xs" data-testid={"plugin-relays-#{plugin.name}"}>
              {join_or_dash(plugin[:relays])}
            </td>
            <td class="text-right">
              <button
                phx-click="confirm_disable"
                phx-value-name={plugin.name}
                phx-value-namespace={plugin.namespace}
                data-testid={"plugin-disable-#{plugin.name}"}
                class="text-xs text-danger-text hover:text-danger transition-colors"
              >
                Disable
              </button>
            </td>
          </tr>
        </tbody>
      </table>
    </div>
  <% end %>
</div>

<.confirm_dialog
  :if={@confirm_disable}
  title="Disable Plugin?"
  confirm_label="Disable"
  on_confirm="disable_plugin"
  on_cancel="cancel_disable"
  values={%{"name" => @confirm_disable.name, "namespace" => @confirm_disable.namespace}}
  testid="plugin-disable-modal"
  cancel_testid="plugin-disable-cancel"
  confirm_testid="plugin-disable-confirm"
>
  Disable plugin
  <.mono>{@confirm_disable.name}</.mono>
  in <.mono>{@confirm_disable.namespace}</.mono>? Every running copy stops; its bindings stay.
</.confirm_dialog>

<.panel testid="installed-catalog" icon="hero-archive-box" class="overflow-hidden mt-6">
  <:title>Installed on the controller ({length(@catalog)})</:title>

  <p class="px-5 py-2 text-xs text-th-muted border-b border-brd-subtle">
    Installing, upgrading and uninstalling move files on the controller host — those are
    <code class="font-mono">flz plugin</code>
    verbs, not control-panel actions.
  </p>

  <.notice
    :if={@catalog_error}
    kind={:info}
    testid="catalog-unavailable"
    class="m-5"
  >
    The installed-plugin catalog is unavailable on this controller. The enabled plugins above
    still list normally.
  </.notice>

  <.empty_state :if={@catalog == [] and is_nil(@catalog_error)} icon="hero-archive-box">
    No plugins are installed on the controller host.
  </.empty_state>

  <table :if={@catalog != []} class="flz-table">
    <thead>
      <tr>
        <th>Plugin</th>
        <th>Version</th>
        <th>Status</th>
        <th>Error</th>
      </tr>
    </thead>
    <tbody>
      <tr
        :for={plugin <- @catalog}
        data-testid={"installed-#{plugin[:id]}"}
      >
        <td class="text-th-primary flz-num text-xs">{plugin[:id]}</td>
        <td class="flz-num text-xs">{plugin[:version]}</td>
        <td>
          <span
            data-testid={"installed-status-#{plugin[:id]}"}
            class={[
              "inline-flex items-center px-2 py-0.5 rounded-lg text-[11px]",
              if(plugin[:status] == :loaded,
                do: "bg-success/10 text-success",
                else: "bg-surface-input text-th-tertiary"
              )
            ]}
          >
            {plugin[:status]}
          </span>
        </td>
        <td class="text-xs">{(plugin[:error] || %{})[:message] || "—"}</td>
      </tr>
    </tbody>
  </table>
</.panel>
