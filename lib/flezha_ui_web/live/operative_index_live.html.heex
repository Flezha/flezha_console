<div class="space-y-6">
  <.header>
    {screen_name(@scoped_namespace)}
    <:subtitle :if={@scoped_namespace}>
      Every operative in <span class="flz-num">{@scoped_namespace}</span>.
    </:subtitle>
    <:actions>
      <span class="text-sm text-th-tertiary font-mono" data-testid="operatives-count">
        <span :if={@scoped_namespace}>{length(@rows)} in {@scoped_namespace}</span>
        <span :if={!@scoped_namespace}>
          {length(@rows)} across {length(@namespaces)} namespaces
        </span>
      </span>
      <.button phx-click="launcher_open" data-testid="start-operative-btn" icon="hero-plus">
        Start Operative
      </.button>
    </:actions>
  </.header>

  <.runtime_error error={@load_error} action="the operative listing" />

  <form phx-change="filter" class="flex flex-wrap items-end gap-3">
    <%!-- Scoped by the route, the namespace is the screen rather than one of
          its controls, so it is stated rather than offered. --%>
    <div :if={@scoped_namespace} class="flz-field">
      <span class="flz-field-label">Namespace</span>
      <p data-testid="fixed-namespace" class="flz-num text-sm text-th-primary py-2">
        {@scoped_namespace}
      </p>
    </div>
    <div :if={!@scoped_namespace}>
      <.dropdown
        label="Namespace"
        id="filter-namespace"
        name="filters[namespace]"
        value={@filters["namespace"]}
        testid="filter-namespace"
        prompt="all"
        class="w-40"
      >
        <:option value="">all</:option>
        <:option :for={ns <- @namespaces} value={ns}>{ns}</:option>
      </.dropdown>
    </div>
    <div>
      <.dropdown
        label="Health"
        id="filter-health"
        name="filters[health]"
        value={@filters["health"]}
        testid="filter-health"
        prompt="all"
        class="w-36"
      >
        <:option value="">all</:option>
        <:option :for={health <- health_options()} value={to_string(health)}>{health}</:option>
      </.dropdown>
    </div>
    <div>
      <.dropdown
        label="Kind"
        id="filter-kind"
        name="filters[kind]"
        value={@filters["kind"]}
        testid="filter-kind"
        prompt="all"
        class="w-32"
      >
        <:option value="">all</:option>
        <%!-- The kinds the controller recognises, which is the same list the
              start form offers — a hardcoded pair here would drift from it. --%>
        <:option :for={kind <- @launcher.kinds} value={to_string(kind.kind)}>{kind.kind}</:option>
      </.dropdown>
    </div>
  </form>

  <div class="flz-panel overflow-hidden">
    <%= if @rows == [] do %>
      <.empty_state icon="hero-cpu-chip" testid="operatives-empty">
        <span :if={@scoped_namespace}>No operatives are running in {@scoped_namespace}.</span>
        <span :if={!@scoped_namespace}>
          No operatives are running in any reachable namespace.
        </span>
      </.empty_state>
    <% else %>
      <table data-testid="operatives-index-table" class="flz-table">
        <thead>
          <tr>
            <th>Operative ID</th>
            <th>Namespace</th>
            <th>Factory</th>
            <th>Health</th>
            <th>Kind</th>
            <th>Node</th>
            <th>Runner</th>
            <th>Plugins</th>
          </tr>
        </thead>
        <tbody>
          <tr
            :for={row <- @rows}
            data-testid={"operative-index-row-#{row.id}"}
          >
            <td class="flz-num text-xs">
              <.link
                navigate={~p"/namespaces/#{row.namespace}/operatives/#{row.id}"}
                class="text-accent-text hover:text-accent transition-colors"
              >
                {row.id}
              </.link>
            </td>
            <td class="flz-num text-xs">{row.namespace}</td>
            <td class="flz-num text-xs">{row[:factory] || "—"}</td>
            <td><.health_badge health={row.health} /></td>
            <td class="flz-num text-xs">
              {row.kind}
            </td>
            <td class="flz-num text-xs">
              <span :if={row[:node]}>{row[:node]}</span>
              <span :if={is_nil(row[:node])} class="text-warning">unplaced</span>
            </td>
            <td class="flz-num text-xs">{row[:runner] || "—"}</td>
            <td class="flz-num text-xs">{row.plugins}</td>
          </tr>
        </tbody>
      </table>
    <% end %>
  </div>
</div>

<.launcher_dialog launcher={@launcher} />
