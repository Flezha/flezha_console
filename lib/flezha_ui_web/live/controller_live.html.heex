<div class="space-y-6">
  <.header>Controller</.header>

  <%!-- Durability --%>
  <div
    data-testid="durability-panel"
    class="flz-panel p-5"
  >
    <div class="flex items-center gap-2 mb-4">
      <.icon name="hero-circle-stack" class="w-4 h-4 text-th-tertiary" />
      <h2 class="flz-panel-title">Durability</h2>
    </div>
    <.runtime_error error={@status_error} action="the controller status" />
    <dl :if={@status} class="grid grid-cols-4 gap-4 text-sm">
      <.stat label="Backend" testid="durability-backend">
        {backend_label(@status[:durability_backend])}
      </.stat>
      <.stat label="Posture" testid="durability-posture">
        {inspect(@status[:durability_posture])}
      </.stat>
      <.stat label="RPO breaches" testid="durability-breaches">
        {@status[:durability_rpo_breaches]}
      </.stat>
      <.stat label="Superseded" testid="durability-superseded">
        {@status[:durability_superseded]}
      </.stat>
    </dl>

    <%!-- A stated posture, not an alarm: one copy is a choice, not a failure. --%>
    <.notice
      :if={@status && @status[:durability_posture] == :local_only}
      kind={:info}
      testid="durability-local-only"
      class="mt-4"
    >
      This controller is <span class="font-mono">local_only</span>: durable state has exactly one
      copy, on the node that wrote it. No remote tier is shipping it.
    </.notice>

    <div :if={@breaches != []} class="mt-4">
      <table data-testid="durability-breach-table" class="flz-table">
        <thead>
          <tr>
            <th>Reference</th>
            <th>Past target by</th>
          </tr>
        </thead>
        <tbody>
          <tr :for={breach <- @breaches}>
            <td class="text-th-primary flz-num text-xs">
              {inspect(breach[:ref] || breach[:reference])}
            </td>
            <td class="text-danger-text flz-num text-xs">
              {Format.duration(breach[:lag_ms])}
            </td>
          </tr>
        </tbody>
      </table>
    </div>
  </div>

  <%!-- Shutdown and boot --%>
  <div class="grid grid-cols-2 gap-6">
    <div
      data-testid="shutdown-panel"
      class="flz-panel p-5"
    >
      <div class="flex items-center gap-2 mb-4">
        <.icon name="hero-power" class="w-4 h-4 text-th-tertiary" />
        <h2 class="flz-panel-title">Shutdown</h2>
      </div>
      <p :if={is_nil(@status)} data-testid="shutdown-unavailable" class="text-sm text-th-muted">
        Shutdown status is unavailable on this controller.
      </p>
      <dl :if={@status} class="space-y-2 text-sm">
        <div class="flex gap-2">
          <dt class="text-th-tertiary w-48">In progress</dt>
          <dd data-testid="shutdown-in-progress" class="font-mono">
            {if @status.shutdown_in_progress, do: "yes", else: "no"}
          </dd>
        </div>
        <div class="flex gap-2">
          <dt class="text-th-tertiary w-48">Phase</dt>
          <dd data-testid="shutdown-phase" class="font-mono">
            {@status.shutdown_phase || "none"}
          </dd>
        </div>
        <div class="flex gap-2">
          <dt class="text-th-tertiary w-48">Signal handler</dt>
          <dd class="font-mono">{inspect(@status.signal_handler_status)}</dd>
        </div>
        <div class="flex gap-2">
          <dt class="text-th-tertiary w-48">Graceful shutdown</dt>
          <dd class="font-mono">
            {if @status.graceful_shutdown_enabled, do: "enabled", else: "disabled"}, {Format.duration(
              @status.graceful_shutdown_timeout_ms
            )}
          </dd>
        </div>
      </dl>
    </div>

    <div
      data-testid="boot-panel"
      class="flz-panel p-5"
    >
      <div class="flex items-center gap-2 mb-4">
        <.icon name="hero-rocket-launch" class="w-4 h-4 text-th-tertiary" />
        <h2 class="flz-panel-title">Boot</h2>
      </div>
      <.runtime_error error={@boot_error} action="the boot status" />
      <p :if={@boot} data-testid="boot-readiness" class="text-sm text-th-secondary mb-2">
        Readiness: <span class="font-mono">{inspect(@boot.readiness)}</span>
      </p>
      <p :if={@boot && @boot.namespaces == []} class="text-sm text-th-muted">
        No namespace hub is running.
      </p>
      <ul :if={@boot} class="space-y-1 text-sm">
        <li
          :for={row <- @boot.namespaces}
          data-testid={"boot-#{row.namespace}"}
          class="flex gap-3"
        >
          <span class="font-mono text-th-primary w-48">{row.namespace}</span>
          <span class="font-mono text-th-tertiary">{row.recovery_state}</span>
        </li>
      </ul>
    </div>
  </div>

  <%!-- Authorization --%>
  <div
    data-testid="authz-panel"
    class="flz-panel p-5"
  >
    <div class="flex items-center gap-2 mb-4">
      <.icon name="hero-key" class="w-4 h-4 text-th-tertiary" />
      <h2 class="flz-panel-title">
        Authorization
      </h2>
    </div>
    <p data-testid="authz-posture" class="text-sm text-th-secondary">
      Posture: <span class="font-mono">{inspect(@authz.posture)}</span>
    </p>
    <%!-- A wide-open controller is a fact an operator should be able to find. --%>
    <.notice :if={@authz.posture == :open} kind={:error} testid="authz-open" class="mt-3">
      Authorization is disabled on this controller. Every call is allowed, whoever makes it.
    </.notice>
    <p :if={@authz.posture == :enforced} class="text-sm text-th-secondary mt-2">
      Authorization is enforced. Calls are policy-checked against the caller's role binding.
    </p>
  </div>

  <%!-- Memory hot spots, operator-triggered --%>
  <div
    data-testid="memory-panel"
    class="flz-panel p-5"
  >
    <div class="flex items-center justify-between mb-4">
      <div class="flex items-center gap-2">
        <.icon name="hero-chart-pie" class="w-4 h-4 text-th-tertiary" />
        <h2 class="flz-panel-title">
          Memory hot spots
        </h2>
      </div>
      <button
        phx-click="memory_snapshot"
        data-testid="memory-snapshot-btn"
        class="flz-button flz-button--sm flz-button--secondary"
      >
        Take snapshot
      </button>
    </div>

    <.runtime_error error={@memory_error} action="the memory snapshot" />

    <p :if={is_nil(@memory) and is_nil(@memory_error)} class="text-sm text-th-muted">
      Not taken. A snapshot scans every process and the allocator, so it runs only when asked.
    </p>

    <div :if={@memory}>
      <p data-testid="memory-captured-at" class="text-xs text-th-muted mb-3">
        Captured at {@memory[:captured_at]} on {@memory[:node]} — a point reading, not live.
      </p>
      <dl class="grid grid-cols-4 gap-4 text-sm mb-4">
        <.stat :for={{key, value} <- Enum.sort(@memory[:erlang_memory] || %{})} label={key}>
          {Format.bytes(value)}
        </.stat>
      </dl>
      <table data-testid="memory-top-processes" class="flz-table">
        <thead>
          <tr>
            <th>Process</th>
            <th>Memory</th>
          </tr>
        </thead>
        <tbody>
          <tr :for={proc <- Enum.take(@memory[:top_processes] || [], 10)}>
            <td class="text-th-primary flz-num text-xs">
              {inspect(proc[:name] || proc[:pid])}
            </td>
            <td class="flz-num text-xs">
              {Format.bytes(proc[:memory])}
            </td>
          </tr>
        </tbody>
      </table>
    </div>
  </div>
</div>
