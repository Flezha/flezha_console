<.page_header eyebrow="Platform" title="Controller">
  <:sentence>
    <span data-testid="controller-sentence">
      {sentence(@boot, @authz, @status)}
    </span>
  </:sentence>
</.page_header>

<%!-- Readiness --%>
<.section flush testid="boot-panel">
  <:title>Readiness</:title>
  <.runtime_error error={@boot_error} action="the boot status" />
  <p :if={@boot} data-testid="boot-readiness" class="mb-3">
    <.state_badge kind={:readiness} value={@boot.readiness} />
  </p>
  <p :if={@boot && @boot.namespaces == []} class="fui-figures">No namespace hub is running.</p>
  <.grid
    :if={@boot && @boot.namespaces != []}
    paging={@paging}
    id="boot-namespaces"
    rows={@boot.namespaces}
    row_testid={&"boot-#{&1.namespace}"}
  >
    <:col :let={row} label="Namespace"><span class="fui-num">{row.namespace}</span></:col>
    <:col :let={row} label="Hub recovery">
      <.said kind={:hub_recovery} value={row.recovery_state} />
    </:col>
  </.grid>
</.section>

<%!-- Authorization --%>
<.section testid="authz-panel">
  <:title>Authorization</:title>
  <p data-testid="authz-posture">
    <.state_badge :if={@authz.posture} kind={:authz_posture} value={@authz.posture} />
    <span :if={is_nil(@authz.posture)} class="fui-muted">The controller could not be asked.</span>
  </p>
  <%!-- A wide-open controller is a fact an operator should be able to find. --%>
  <.notice :if={@authz.posture == :open} kind={:error} testid="authz-open" class="mt-3">
    Authorization is disabled on this controller. Every call is allowed, whoever makes it.
  </.notice>
  <p :if={@authz.posture == :enforced} class="fui-figures mt-2">
    Every call is checked against the <.term key="role" /> its <.term key="principal" />
    is bound to.
  </p>
</.section>

<%!-- Durability --%>
<.section
  testid="durability-panel"
  help="How many copies of each relay's durable state exist, and whether a remote tier ships them off this machine. The RPO target is how much recent state you could lose."
>
  <:title>Durability</:title>
  <.runtime_error error={@status_error} action="the controller status" />
  <dl :if={@status} class="fui-facts">
    <.stat label="Backend" testid="durability-backend">
      {backend_label(@status[:durability_backend])}
    </.stat>
    <.stat label="Posture" testid="durability-posture">
      <.said kind={:durability_posture} value={@status[:durability_posture]} />
    </.stat>
    <.stat
      label="Past their RPO target"
      testid="durability-breaches"
      tone={((@status[:durability_rpo_breaches] || 0) > 0 && :negative) || nil}
    >
      {@status[:durability_rpo_breaches]}
    </.stat>
    <.stat label="Shipped by another controller" testid="durability-superseded">
      {@status[:durability_superseded]}
    </.stat>
  </dl>

  <%!-- A stated posture, not an alarm: one copy is a choice, not a failure. --%>
  <.notice
    :if={@status && @status[:durability_posture] == :local_only}
    testid="durability-local-only"
    class="mt-4"
  >
    Durable state has exactly one copy, on the node that wrote it. No remote tier is shipping it.
  </.notice>

  <.grid
    :if={@breaches != []}
    paging={@paging}
    id="breaches"
    rows={@breaches}
    testid="durability-breach-table"
    row_tone={fn _ -> "negative" end}
  >
    <:col :let={breach} label="Reference">
      <code>{inspect(breach[:ref] || breach[:reference])}</code>
    </:col>
    <:col :let={breach} label="Past target by" num>{Format.duration(breach[:lag_ms])}</:col>
  </.grid>

  <%!-- The shipper's own rows: what the remote tier holds and how far behind it is. --%>
  <div data-testid="shipper-status" class="mt-6 space-y-2">
    <h3 class="fui-eyebrow">Shipper</h3>
    <.runtime_error error={@shipper_error} action="the shipper status" />
    <p
      :if={(is_nil(@shipper_error) and @status) && @status[:durability_posture] == :local_only}
      data-testid="shipper-not-applicable"
      class="fui-figures"
    >
      Not applicable: nothing is shipped from a controller that keeps one copy.
    </p>
    <p
      :if={
        is_nil(@shipper_error) and @shipper == [] and
          !(@status && @status[:durability_posture] == :local_only)
      }
      data-testid="shipper-empty"
      class="fui-figures"
    >
      The shipper holds no references yet.
    </p>
    <.grid
      :if={@shipper != []}
      paging={@paging}
      id="shipper"
      rows={@shipper}
      testid="shipper-table"
      row_testid={fn _ -> "shipper-row" end}
    >
      <:col :let={row} label="Reference"><code>{inspect(row[:ref])}</code></:col>
      <:col :let={row} label="Last shipped" num>
        {Format.unix_time(row[:last_shipped_ms], :millisecond)}
      </:col>
      <:col :let={row} label="Pending since" num>
        {Format.unix_time(row[:pending_since_ms], :millisecond)}
      </:col>
      <:col :let={row} label="Failures" num>
        <span class={(row[:failures] || 0) > 0 && "fui-tone-negative"}>
          {row[:failures] || 0}
        </span>
      </:col>
      <:col :let={row} label="Retry" num>
        {Format.until(row[:retry_in_ms])}
      </:col>
      <:col :let={row} label="Superseded by">
        <code>{(row[:superseded_by] && inspect(row[:superseded_by])) || "—"}</code>
      </:col>
      <:col :let={row} label="Last error">
        <code>{row[:last_error] || "—"}</code>
      </:col>
    </.grid>
  </div>
</.section>

<%!-- Shutdown --%>
<.section testid="shutdown-panel">
  <:title>Shutdown</:title>
  <p :if={is_nil(@status)} data-testid="shutdown-unavailable" class="fui-figures">
    Shutdown status is unavailable on this controller.
  </p>
  <dl :if={@status} class="fui-facts">
    <.stat label="Stopping" testid="shutdown-in-progress">
      {if @status.shutdown_in_progress, do: "Yes", else: "No"}
    </.stat>
    <.stat label="Phase" testid="shutdown-phase">
      <.said kind={:shutdown_phase} value={@status.shutdown_phase} />
    </.stat>
    <.stat label="Signal handler">
      <.said kind={:signal_handler} value={@status.signal_handler_status} />
    </.stat>
    <.stat label="Graceful shutdown">
      {if @status.graceful_shutdown_enabled, do: "On", else: "Off"}, within {Format.duration(
        @status.graceful_shutdown_timeout_ms
      )}
    </.stat>
  </dl>
</.section>

<%!-- Memory hot spots, operator-triggered --%>
<.section
  id="memory-panel"
  testid="memory-panel"
  help="A one-off scan of the controller's memory: totals by kind and the processes holding the most. It is expensive, so it runs only when you press the button."
>
  <:title>Memory hot spots</:title>
  <:actions>
    <.button
      variant="secondary"
      size="sm"
      icon="hero-camera"
      loading={@memory_loading}
      phx-click="memory_snapshot"
      data-testid="memory-snapshot-btn"
    >
      {if @memory_loading, do: "Taking snapshot…", else: "Take snapshot"}
    </.button>
  </:actions>
  <.runtime_error error={@memory_error} action="the memory snapshot" />
  <p :if={is_nil(@memory) and is_nil(@memory_error) and not @memory_loading} class="fui-figures">
    Not taken. A snapshot scans every process and the allocator, so it runs only when asked.
  </p>
  <p :if={@memory_loading} class="fui-figures" data-testid="memory-loading">
    Scanning every process on the controller. This takes a few seconds.
  </p>
  <div :if={@memory} class="space-y-4">
    <p data-testid="memory-captured-at" class="fui-figures">
      Captured at {@memory[:captured_at]} on {@memory[:node]} — a point reading, not live.
    </p>
    <dl class="fui-facts">
      <.stat
        :for={{key, value} <- Enum.sort(@memory[:erlang_memory] || %{})}
        label={Words.humanize(key)}
      >
        {Format.bytes(value)}
      </.stat>
    </dl>
    <.grid
      paging={@paging}
      id="memory-processes"
      rows={@memory[:top_processes] || []}
      page_size={10}
      testid="memory-top-processes"
    >
      <:col :let={proc} label="Process">
        <code>{Format.printable(proc[:registered_name] || proc[:pid])}</code>
      </:col>
      <:col :let={proc} label="Memory" num>{Format.bytes(proc[:memory])}</:col>
      <:col :let={proc} label="Queue" num>{proc[:message_queue_len] || "—"}</:col>
      <:col :let={proc} label="Started as">
        <code>{proc[:initial_call] || "—"}</code>
      </:col>
    </.grid>
  </div>
</.section>
