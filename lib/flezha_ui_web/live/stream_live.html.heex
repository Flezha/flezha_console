<div class="flex flex-col h-full space-y-4">
  <div class="flex items-center justify-between flex-shrink-0">
    <div class="flex items-center gap-3">
      <.link
        navigate={~p"/namespaces/#{@ns}/operatives/#{@operative_id}"}
        class="text-th-tertiary hover:text-th-primary transition-colors"
      >
        <.icon name="hero-arrow-left" class="w-4 h-4" />
      </.link>
      <h1 class="text-xl font-bold text-th-primary">
        Stream: <span class="font-mono text-base">{@operative_id}</span>
      </h1>
    </div>

    <%!-- IO type tabs --%>
    <div class="flex items-center gap-2">
      <%= if @status == :connecting do %>
        <span class="text-xs text-th-muted mr-1">Connecting...</span>
      <% end %>
      <div class="flex items-center gap-1 bg-surface-input border border-brd rounded-xl p-1">
        <button
          data-testid="stream-io-input"
          phx-click="switch_io"
          phx-value-type="input"
          disabled={@status == :connecting}
          class={"px-3 py-1.5 text-sm rounded-lg transition-all duration-200 " <> if @io_type == "input", do: "bg-accent text-white", else: "text-th-tertiary hover:text-th-primary disabled:opacity-40"}
        >
          Input
        </button>
        <button
          data-testid="stream-io-output"
          phx-click="switch_io"
          phx-value-type="output"
          disabled={@status == :connecting}
          class={"px-3 py-1.5 text-sm rounded-lg transition-all duration-200 " <> if @io_type == "output", do: "bg-accent text-white", else: "text-th-tertiary hover:text-th-primary disabled:opacity-40"}
        >
          Output
        </button>
      </div>
    </div>
  </div>

  <%!-- Controls bar --%>
  <div class="flex items-center gap-3 flex-shrink-0">
    <button
      data-testid="stream-pause"
      phx-click="toggle_pause"
      class={"inline-flex items-center gap-1.5 px-3 py-1.5 text-sm rounded-xl transition-all duration-200 " <> if @paused, do: "bg-warning text-white", else: "bg-surface-input text-th-secondary border border-brd hover:bg-surface-hover"}
    >
      <%= if @paused do %>
        <.icon name="hero-play" class="w-3.5 h-3.5" /> Resume
      <% else %>
        <.icon name="hero-pause" class="w-3.5 h-3.5" /> Pause
      <% end %>
    </button>
    <button
      data-testid="stream-clear"
      phx-click="clear"
      class="inline-flex items-center gap-1.5 px-3 py-1.5 text-sm bg-surface-input text-th-secondary border border-brd hover:bg-surface-hover rounded-xl transition-colors"
    >
      <.icon name="hero-trash" class="w-3.5 h-3.5" /> Clear
    </button>
    <form phx-change="set_filter" class="flex-1 max-w-xs">
      <input
        data-testid="stream-filter"
        type="text"
        name="filter"
        value={@filter}
        placeholder="Filter regex..."
        class="w-full bg-surface-input border border-brd-input rounded-xl px-3 py-1.5 text-th-primary text-sm focus:outline-none focus:border-brd-focus focus-visible:ring-2 focus-visible:ring-accent/50 focus-visible:ring-offset-1 transition-colors"
      />
    </form>
    <span data-testid="stream-count" class="ml-auto text-xs text-th-tertiary">
      {@message_count} messages received {if @paused, do: " (paused)"}
    </span>
  </div>

  <%!-- Message feed --%>
  <div
    data-testid="stream-feed"
    class="flex-1 bg-surface border border-brd rounded-panel overflow-y-auto font-mono text-xs shadow-panel"
    id="stream-feed"
    phx-hook="ScrollBottom"
  >
    <%= case @status do %>
      <% :connecting -> %>
        <div data-testid="stream-connecting" class="p-6 text-center">
          <div class="inline-flex items-center gap-2 text-th-tertiary">
            <svg
              class="animate-spin h-4 w-4"
              xmlns="http://www.w3.org/2000/svg"
              fill="none"
              viewBox="0 0 24 24"
            >
              <circle
                class="opacity-25"
                cx="12"
                cy="12"
                r="10"
                stroke="currentColor"
                stroke-width="4"
              >
              </circle>
              <path
                class="opacity-75"
                fill="currentColor"
                d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4z"
              >
              </path>
            </svg>
            <span>Connecting to {@io_type} stream...</span>
          </div>
        </div>
      <% :error -> %>
        <div data-testid="stream-error" class="p-6 text-center text-danger-text">
          Failed to connect to {@io_type} stream. Try navigating back and reopening.
        </div>
      <% :connected -> %>
        <% display_messages = filtered_messages(@messages, @filter) %>
        <%= if display_messages == [] do %>
          <div data-testid="stream-empty" class="p-6 text-th-muted text-center">
            Waiting for messages on {@io_type} stream...
          </div>
        <% else %>
          <%= for msg <- Enum.reverse(display_messages) do %>
            <div
              data-testid="stream-message"
              class="flex gap-3 px-4 py-2 border-b border-brd-subtle hover:bg-surface-hover transition-colors"
            >
              <span class="text-th-muted flex-shrink-0 w-28">
                {Format.time_of_day(msg.timestamp)}
              </span>
              <span class="text-code flex-1 break-all whitespace-pre-wrap">
                {msg.message}
              </span>
              <%= if msg.metadata && msg.metadata != %{} do %>
                <span class="text-th-muted flex-shrink-0 text-xs">
                  {Enum.map_join(msg.metadata, ", ", fn {k, v} -> "#{k}=#{inspect(v)}" end)}
                </span>
              <% end %>
            </div>
          <% end %>
        <% end %>
    <% end %>
  </div>
</div>
