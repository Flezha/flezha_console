<div class="flex flex-col h-full space-y-4">
  <div class="flex items-center justify-between flex-shrink-0">
    <div class="flex items-center gap-3">
      <a href={~p"/namespaces/#{@ns}/processors/#{@proc_id}"} class="text-zinc-400 hover:text-white">
        <.icon name="hero-arrow-left" class="w-4 h-4" />
      </a>
      <h1 class="text-xl font-bold text-white">
        Stream: <span class="font-mono text-base"><%= @proc_id %></span>
      </h1>
    </div>

    <%!-- IO type tabs --%>
    <div class="flex items-center gap-1 bg-zinc-800 rounded-lg p-1">
      <button phx-click="switch_io" phx-value-type="input"
        class={"px-3 py-1.5 text-sm rounded-md transition-colors " <> if @io_type == "input", do: "bg-zinc-600 text-white", else: "text-zinc-400 hover:text-white"}>
        Input
      </button>
      <button phx-click="switch_io" phx-value-type="output"
        class={"px-3 py-1.5 text-sm rounded-md transition-colors " <> if @io_type == "output", do: "bg-zinc-600 text-white", else: "text-zinc-400 hover:text-white"}>
        Output
      </button>
    </div>
  </div>

  <%!-- Controls bar --%>
  <div class="flex items-center gap-3 flex-shrink-0">
    <button phx-click="toggle_pause"
      class={"px-3 py-1.5 text-sm rounded-md transition-colors " <> if @paused, do: "bg-yellow-600 text-white", else: "bg-zinc-800 text-zinc-300 hover:bg-zinc-700"}>
      <%= if @paused, do: "Resume", else: "Pause" %>
    </button>
    <button phx-click="clear"
      class="px-3 py-1.5 text-sm bg-zinc-800 text-zinc-300 hover:bg-zinc-700 rounded-md transition-colors">
      Clear
    </button>
    <form phx-change="set_filter" class="flex-1 max-w-xs">
      <input type="text" name="filter" value={@filter}
        placeholder="Filter regex..."
        class="w-full bg-zinc-800 border border-zinc-700 rounded-md px-3 py-1.5 text-white text-sm focus:outline-none focus:border-orange-500" />
    </form>
    <span class="ml-auto text-xs text-zinc-400">
      <%= @message_count %> messages received
      <%= if @paused, do: " (paused)" %>
    </span>
  </div>

  <%!-- Message feed --%>
  <div class="flex-1 bg-zinc-950 border border-zinc-800 rounded-lg overflow-y-auto font-mono text-xs"
       id="stream-feed"
       phx-hook="ScrollBottom">
    <% display_messages = filtered_messages(@messages, @filter) %>
    <%= if display_messages == [] do %>
      <div class="p-6 text-zinc-500 text-center">
        Waiting for messages on <%= @io_type %> stream...
      </div>
    <% else %>
      <%= for msg <- Enum.reverse(display_messages) do %>
        <div class="flex gap-3 px-4 py-2 border-b border-zinc-900 hover:bg-zinc-900/50">
          <span class="text-zinc-500 flex-shrink-0 w-28"><%= format_timestamp(msg.timestamp) %></span>
          <span class="text-green-300 flex-1 break-all whitespace-pre-wrap"><%= msg.message %></span>
          <%= if msg.metadata && msg.metadata != %{} do %>
            <span class="text-zinc-600 flex-shrink-0 text-xs">
              <%= Enum.map_join(msg.metadata, ", ", fn {k, v} -> "#{k}=#{inspect(v)}" end) %>
            </span>
          <% end %>
        </div>
      <% end %>
    <% end %>
  </div>
</div>
