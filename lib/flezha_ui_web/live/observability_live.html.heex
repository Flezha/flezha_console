<.page_header eyebrow="Platform" title="Observability">
  <:sentence>
    <%= if @disabled? do %>
      Observability is switched off on this controller.
    <% else %>
      The controller emits {Words.count(
        Enum.count(@sources, &NodeManager.source_enabled?/1),
        "source"
      )} of {length(@sources)} and ships them to {Words.count(length(@sinks), "sink")}. Switch a
      <.term key="source" /> on or off, or tail it live.
    <% end %>
  </:sentence>
</.page_header>

<.runtime_error error={@load_error} action="the observability listing" />

<.notice :if={@disabled?} kind={:info} testid="observability-disabled">
  Observability is switched off on this controller, so it emits no signals and there is nothing
  to list or tail.
</.notice>

<.runtime_error error={@toggle_error} action="the source toggle" />

<.section
  :if={not @disabled?}
  flush
  testid="sources-panel"
  help="A source is one kind of signal the controller can emit, such as VM memory or relay throughput. Switch it off to stop emitting it; Tail streams it live beside the list."
>
  <:title>Sources</:title>
  <:actions>
    <form phx-change="filter_sources" class="w-56" data-testid="source-filter-form">
      <.input
        type="search"
        name="q"
        value={@source_filter}
        placeholder="Filter by name"
        aria-label="Filter sources by name"
        compact
        phx-debounce="150"
        data-testid="source-filter"
      />
    </form>
  </:actions>
  <.empty_state :if={@sources == []} icon="hero-signal">
    A source is a stream of signals the controller can emit. This controller reports none.
  </.empty_state>
  <div class="space-y-8">
    <div
      :for={group <- groups(@sources, @source_filter)}
      data-testid={"source-group-#{group.key}"}
      class="space-y-2"
    >
      <h3 class="flex items-baseline gap-3">
        <span class="font-medium">{group.label}</span>
        <span class="fui-figures" data-testid={"source-group-count-#{group.key}"}>
          {group.enabled} of {group.total} on
        </span>
      </h3>
      <p :if={group.sources == []} class="fui-figures">No source in this area matches.</p>
      <.grid
        :if={group.sources != []}
        paging={@paging}
        id={"sources-#{group.key}"}
        rows={group.sources}
        row_testid={&"source-#{&1[:name]}"}
      >
        <:col :let={source} label="Source"><span class="fui-num">{source[:name]}</span></:col>
        <:col :let={source} label="Emitting">
          <span
            data-testid={"source-enabled-#{source[:name]}"}
            data-enabled={to_string(NodeManager.source_enabled?(source))}
          >
            <.switch
              checked={NodeManager.source_enabled?(source)}
              label={to_string(source[:name])}
              show_label={false}
              phx-click="toggle_source"
              phx-value-source={source[:name]}
              testid={"toggle-#{source[:name]}"}
            />
          </span>
        </:col>
        <:col :let={source} label="Live">
          <.button
            variant="secondary"
            size="sm"
            icon={if @tailing == source[:name], do: "hero-signal", else: "hero-play"}
            phx-click={if @tailing == source[:name], do: "stop_tail", else: "start_tail"}
            phx-value-source={source[:name]}
            aria-pressed={to_string(@tailing == source[:name])}
            data-testid={"tail-#{source[:name]}"}
          >
            {if @tailing == source[:name], do: "Stop tail", else: "Tail"}
          </.button>
        </:col>
      </.grid>
    </div>
  </div>
</.section>

<.section
  :if={not @disabled?}
  testid="sinks-panel"
  help="Where the emitted signals go: pubsub feeds live tails, a ring buffer keeps the recent ones for queries."
>
  <:title>Sinks</:title>
  <.empty_state :if={@sinks == []} icon="hero-inbox-arrow-down">
    A sink is where the controller ships its signals. This controller reports none.
  </.empty_state>
  <.paged :let={page} id="sinks" rows={@sinks} paging={@paging}>
    <ul :if={@sinks != []} class="fui-tiles">
      <li :for={sink <- page} data-testid={"sink-#{sink[:name]}"} class="fui-tile flz-tile">
        <span class="fui-num font-medium">{sink[:name]}</span>
        <span data-testid={"sink-running-#{sink[:name]}"}>
          <span class={["fui-badge", NodeManager.sink_running?(sink) && "fui-badge--positive"]}>
            {if NodeManager.sink_running?(sink), do: "Running", else: "Not running"}
          </span>
        </span>
      </li>
    </ul>
  </.paged>
</.section>

<%!-- A drawer, so the tail is in view the moment it starts, wherever the
      source sat in the listing. Closing it stops the tail. --%>
<.drawer
  :if={@tailing || @tail_error}
  id="tail-panel"
  testid="tail-panel"
  eyebrow="Live tail"
  title={to_string(@tailing || "Tail")}
  on_close="stop_tail"
>
  <p class="fui-figures" data-testid="tail-count">
    {Words.count(length(@tail_records), "signal")} so far, newest first.
  </p>

  <.notice :if={pubsub_disabled?(@tail_error)} kind={:info} testid="pubsub-sink-disabled">
    Live tailing is unavailable: the controller's pubsub sink is disabled. The query-based views
    still work.
  </.notice>
  <.runtime_error
    :if={@tail_error && !pubsub_disabled?(@tail_error)}
    error={@tail_error}
    action="the live tail"
  />
  <.notice :if={@tail_reconnected?} kind={:info} testid="tail-reconnected">
    The tail reconnected after its stream to the controller was cut — signals emitted while it was
    down are not shown.
  </.notice>

  <pre :if={@tailing} class="fui-code fui-tail"><span :for={signal <- @tail_records} data-testid="tail-record" class="block">{signal[:source]}.{signal[:name]}  {measurements(signal[:measurements])}</span><span :if={@tail_records == []} class="fui-muted">Waiting for signals. A quiet source emits only when its subject does something.</span></pre>

  <:actions>
    <.button variant="secondary" phx-click="stop_tail" data-testid="stop-tail" icon="hero-stop">
      Stop tail
    </.button>
  </:actions>
</.drawer>
