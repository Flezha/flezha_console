<.page_header eyebrow="Problems" title="Dead-letter queue">
  <:sentence>
    <%= cond do %>
      <% @entries == [] and @filter in [nil, ""] -> %>
        No dead letters: every record reached its tasklet.
      <% @entries == [] -> %>
        No dead letters for {@filter}.
      <% true -> %>
        {Words.count(length(@entries), "record")} could not be processed and wait here as <.term key="dead letter">dead letters</.term>, to be replayed or dropped.
    <% end %>
  </:sentence>
  <:actions>
    <form phx-change="filter" class="w-64">
      <.input
        type="text"
        name="filter[relay_class]"
        value={@filter}
        placeholder="Filter by relay class"
        aria-label="Filter by relay class"
        compact
        phx-debounce="300"
        data-testid="dlq-filter"
      />
    </form>
  </:actions>
</.page_header>

<.runtime_error error={@load_error} />

<%= case @replay_outcome do %>
  <% {:pending, ref} -> %>
    <.notice testid="replay-pending" icon="hero-arrow-path">
      Replaying <span class="fui-ident">{ref}</span>
      — the controller is waiting to see whether it fails again.
    </.notice>
  <% {:replayed, ref} -> %>
    <.notice testid="replay-succeeded" icon="hero-check-circle">
      Replayed <span class="fui-ident">{ref}</span>: the payload was accepted and the entry left the queue.
    </.notice>
  <% {:reparked, ref, generation} -> %>
    <.notice kind={:error} testid="replay-reparked">
      <span class="fui-ident">{ref}</span>
      failed again and is a dead letter again, as generation {generation}; its new error is on the row.
    </.notice>
  <% {:refused, _ref, reason} -> %>
    <div data-testid="replay-refused">
      <.runtime_error error={reason} action="the replay" />
    </div>
  <% nil -> %>
<% end %>

<%!-- Statistics: dead letters per tasklet --%>
<dl :if={@stats != []} data-testid="dlq-stats" class="fui-facts mb-6">
  <.stat :for={stat <- @stats} label={"#{stat[:relay_class]}/#{stat[:tasklet_id]}"}>
    <span class="fui-figure">{stat[:entries]}</span> {if stat[:entries] == 1,
      do: "dead letter",
      else: "dead letters"}
  </.stat>
</dl>

<.empty_state :if={@entries == []} icon="hero-check-circle" testid="dlq-empty">
  A record a tasklet cannot process waits here as a dead letter, so it can be inspected, replayed or dropped. {if @filter in [
                                                                                                                    nil,
                                                                                                                    ""
                                                                                                                  ],
                                                                                                                  do:
                                                                                                                    "The queue is empty.",
                                                                                                                  else:
                                                                                                                    "None waits for that relay class."}
</.empty_state>

<div :if={@entries != []} class="space-y-8">
  <div
    :for={group <- @groups}
    data-testid={"dlq-group-#{group.relay_class}-#{group.tasklet_id}"}
    class="space-y-2"
  >
    <h3 class="flex items-center gap-3">
      <span class="fui-num font-medium">{group.relay_class}/{group.tasklet_id}</span>
      <span
        data-testid={"dlq-group-count-#{group.relay_class}-#{group.tasklet_id}"}
        class="fui-figures"
      >
        {Words.count(group.parked, "dead letter")}
      </span>
    </h3>
    <.grid
      paging={@paging}
      id={"dlq-#{group.relay_class}-#{group.tasklet_id}"}
      rows={group.entries}
      testid="dlq-table"
      row_testid={&"dlq-row-#{&1.ref}"}
      row_tone={&((&1.generation > 1 && "negative") || "warning")}
      row_label={&"Inspect #{&1.ref}"}
      row_activate={&JS.push("inspect", value: %{kind: "entry", id: &1.ref})}
      row_selected={&(@inspected != nil and @inspected.id == &1.ref)}
    >
      <:col :let={entry} label="Entry"><.ident value={entry.ref} /></:col>
      <:col :let={entry} label="Cell"><span class="fui-num">{entry.cell_key || "—"}</span></:col>
      <:col :let={entry} label="Channel">
        <span class="fui-num">{entry.channel || "—"}</span>
      </:col>
      <:col :let={entry} label="Generation" num>{entry.generation}</:col>
      <:col :let={entry} label="Age" num>{Format.age(entry.age_s)}</:col>
      <:col :let={entry} label="Error">
        <code class="block max-w-xs truncate" title={entry.error}>{entry.error || "—"}</code>
      </:col>
      <:menu :let={entry}>
        <.row_menu
          id={"dlq-menu-#{entry.ref}"}
          label={"Actions for #{entry.ref}"}
          testid={"dlq-menu-#{entry.ref}"}
        >
          <:item
            click="inspect"
            values={%{kind: "entry", id: entry.ref}}
            icon="hero-eye"
            testid={"dlq-inspect-#{entry.ref}"}
          >
            Inspect
          </:item>
          <:item
            :if={NodeManager.granted?(@operations, "Dlq.replay")}
            click="confirm"
            values={%{action: "replay", ref: entry.ref}}
            icon="hero-arrow-path"
            testid={"dlq-replay-#{entry.ref}"}
          >
            Replay
          </:item>
          <:item
            :if={NodeManager.granted?(@operations, "Dlq.drop")}
            click="confirm"
            values={%{action: "drop", ref: entry.ref}}
            testid={"dlq-drop-#{entry.ref}"}
            danger
          >
            Drop
          </:item>
        </.row_menu>
      </:menu>
    </.grid>
  </div>
</div>

<.inspector inspected={@inspected} operations={@operations} />

<.confirm_dialog
  :if={@confirm}
  title={if @confirm.action == "replay", do: "Replay entry?", else: "Drop entry?"}
  confirm_label={if @confirm.action == "replay", do: "Replay", else: "Drop"}
  variant={if @confirm.action == "replay", do: "primary", else: "danger"}
  on_confirm={@confirm.action}
  on_cancel="cancel_confirm"
  values={%{"ref" => @confirm.ref}}
  testid="dlq-confirm-modal"
  cancel_testid="dlq-confirm-cancel"
  confirm_testid="dlq-confirm-submit"
>
  <%= if @confirm.action == "replay" do %>
    Re-send <span class="fui-ident">{@confirm.ref}</span>
    to its relay as a new input. If it fails again it becomes
    a dead letter again, and the outcome is reported here.
  <% else %>
    Discard <span class="fui-ident">{@confirm.ref}</span>
    and its payload. This is permanent and cannot be undone.
  <% end %>
</.confirm_dialog>
