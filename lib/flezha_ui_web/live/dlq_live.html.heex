<div class="space-y-6">
  <.header>
    Dead-letter queue
    <:actions>
      <form phx-change="filter" class="w-64">
        <.input
          type="text"
          name="filter[relay_class]"
          value={@filter}
          placeholder="Filter by relay class"
          compact
          data-testid="dlq-filter"
        />
      </form>
    </:actions>
  </.header>

  <.runtime_error error={@load_error} />

  <%= case @replay_outcome do %>
    <% {:pending, ref} -> %>
      <.notice testid="replay-pending" icon="hero-arrow-path">
        Replaying
        <.mono>{ref}</.mono>
        — the controller is waiting to see whether it parks again.
      </.notice>
    <% {:replayed, ref} -> %>
      <.notice testid="replay-succeeded" icon="hero-check-circle">
        Replayed <.mono>{ref}</.mono>: the payload was accepted and the entry left the queue.
      </.notice>
    <% {:reparked, ref, generation} -> %>
      <.notice kind={:error} testid="replay-reparked">
        <.mono>{ref}</.mono>
        failed again and was parked as generation {generation}; its new error is on the row.
      </.notice>
    <% {:refused, _ref, reason} -> %>
      <div data-testid="replay-refused">
        <.runtime_error error={reason} action="the replay" />
      </div>
    <% nil -> %>
  <% end %>

  <%!-- Stats --%>
  <div :if={@stats != []} class="flz-panel p-5">
    <h2 class="flz-panel-title mb-3">
      Statistics
    </h2>
    <div data-testid="dlq-stats" class="grid grid-cols-3 gap-4">
      <div :for={stat <- @stats} class="bg-surface-input border border-brd rounded-xl px-4 py-3">
        <p class="flz-label">
          {stat[:relay_class]}/{stat[:tasklet_id]}
        </p>
        <p class="text-2xl font-bold text-th-primary font-mono mt-1">
          {stat[:entries] || 0}
        </p>
      </div>
    </div>
  </div>

  <%!-- Entries --%>
  <.panel icon="hero-inbox-stack" class="overflow-hidden">
    <:title>Parked entries ({length(@entries)})</:title>

    <%= if @entries == [] do %>
      <.empty_state icon="hero-check-circle" testid="dlq-empty">
        {if @filter == "",
          do: "The dead-letter queue is empty.",
          else: "No parked entries for that relay class."}
      </.empty_state>
    <% else %>
      <div
        :for={group <- @groups}
        data-testid={"dlq-group-#{group.relay_class}-#{group.tasklet_id}"}
        class="border-b border-brd last:border-b-0"
      >
        <div class="px-5 py-3 flex items-center gap-3 bg-surface-input/40">
          <.icon name="hero-folder" class="w-3.5 h-3.5 text-th-tertiary" />
          <span class="font-mono text-xs text-th-primary">
            {group.relay_class}/{group.tasklet_id}
          </span>
          <span
            data-testid={"dlq-group-count-#{group.relay_class}-#{group.tasklet_id}"}
            class="text-[11px] text-th-tertiary font-mono"
          >
            {group.parked} parked
          </span>
        </div>
        <div class="overflow-x-auto">
          <table data-testid="dlq-table" class="flz-table">
            <thead>
              <tr>
                <th>Entry</th>
                <th>Cell</th>
                <th>Channel</th>
                <th>Gen</th>
                <th>Age</th>
                <th>Error</th>
                <th></th>
              </tr>
            </thead>
            <tbody>
              <tr
                :for={entry <- group.entries}
                data-testid={"dlq-row-#{entry.ref}"}
              >
                <td class="text-th-primary flz-num text-xs">{entry.ref}</td>
                <td class="flz-num text-xs">
                  {entry.cell_key || "—"}
                </td>
                <td class="text-xs">{entry.channel || "—"}</td>
                <td class="text-xs">{entry.generation}</td>
                <td class="text-xs">{Format.age(entry.age_s)}</td>
                <td
                  class="text-xs max-w-xs truncate"
                  title={entry.error}
                >
                  {entry.error || "—"}
                </td>
                <td class="text-right whitespace-nowrap">
                  <button
                    phx-click="inspect"
                    phx-value-ref={entry.ref}
                    data-testid={"dlq-inspect-#{entry.ref}"}
                    class="text-xs text-th-secondary hover:text-th-primary transition-colors mr-3"
                  >
                    Inspect
                  </button>
                  <button
                    :if={NodeManager.granted?(@operations, "Dlq.replay")}
                    phx-click="confirm"
                    phx-value-action="replay"
                    phx-value-ref={entry.ref}
                    data-testid={"dlq-replay-#{entry.ref}"}
                    class="text-xs text-accent hover:text-accent-hover transition-colors mr-3"
                  >
                    Replay
                  </button>
                  <button
                    :if={NodeManager.granted?(@operations, "Dlq.drop")}
                    phx-click="confirm"
                    phx-value-action="drop"
                    phx-value-ref={entry.ref}
                    data-testid={"dlq-drop-#{entry.ref}"}
                    class="text-xs text-danger-text hover:text-danger transition-colors"
                  >
                    Drop
                  </button>
                </td>
              </tr>
            </tbody>
          </table>
        </div>
      </div>
    <% end %>
  </.panel>
</div>

<%!-- Inspect --%>
<.dialog :if={@selected} testid="dlq-inspect-modal" size="wide">
  <div class="flex items-center justify-between mb-4">
    <h3 class="flz-modal-title flz-num">{@selected.ref}</h3>
    <button
      phx-click="close_inspect"
      data-testid="dlq-inspect-close"
      class="text-th-muted hover:text-th-primary transition-colors"
    >
      <.icon name="hero-x-mark" class="w-5 h-5" />
    </button>
  </div>

  <p class="text-xs text-th-muted uppercase tracking-wider mb-2">Metadata</p>
  <pre class="flz-code mb-4"><%= inspect(@selected.entry, pretty: true) %></pre>

  <p class="text-xs text-th-muted uppercase tracking-wider mb-2">Payload preview</p>
  <pre
    data-testid="dlq-payload"
    class="flz-code"
  ><%= Format.printable(@selected.payload, limit: 2_000) %></pre>
</.dialog>

<.confirm_dialog
  :if={@confirm}
  title={if @confirm.action == "replay", do: "Replay entry?", else: "Drop entry?"}
  confirm_label={if @confirm.action == "replay", do: "Replay", else: "Drop"}
  variant={if @confirm.action == "replay", do: "accent", else: "danger"}
  on_confirm={@confirm.action}
  on_cancel="cancel_confirm"
  values={%{"ref" => @confirm.ref}}
  testid="dlq-confirm-modal"
  cancel_testid="dlq-confirm-cancel"
  confirm_testid="dlq-confirm-submit"
>
  <%= if @confirm.action == "replay" do %>
    Re-send
    <.mono>{@confirm.ref}</.mono>
    to its relay as a new input. If it fails again it is
    parked again, and the outcome is reported here.
  <% else %>
    Discard
    <.mono>{@confirm.ref}</.mono>
    and its payload. This is permanent and cannot be undone.
  <% end %>
</.confirm_dialog>
