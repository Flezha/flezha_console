<div class="space-y-6">
  <div class="flex items-center justify-between">
    <h1 class="text-2xl font-bold text-th-primary">Dead-letter queue</h1>
    <form phx-change="filter">
      <input
        type="text"
        name="filter[operative_class]"
        value={@filter}
        placeholder="Filter by operative class"
        data-testid="dlq-filter"
        class="w-64 bg-surface-input border border-brd-input rounded-xl px-3 py-2 text-th-primary text-sm focus:outline-none focus:border-brd-focus transition-colors"
      />
    </form>
  </div>

  <.runtime_error error={@load_error} />

  <%= case @replay_outcome do %>
    <% {:pending, ref} -> %>
      <.notice testid="replay-pending" icon="hero-arrow-path">
        Replaying
        <.mono>{ref}</.mono>
        — waiting to see whether it parks again.
      </.notice>
    <% {:replayed, ref} -> %>
      <.notice testid="replay-succeeded" icon="hero-check-circle">
        Replayed <.mono>{ref}</.mono>: the payload was accepted.
      </.notice>
    <% {:reparked, ref, error} -> %>
      <.notice kind={:error} testid="replay-reparked">
        <.mono>{ref}</.mono>
        failed again and was parked: {error || "no error reported"}
      </.notice>
    <% {:unknown, _ref, reason} -> %>
      <.runtime_error error={reason} />
    <% nil -> %>
  <% end %>

  <%!-- Stats --%>
  <div :if={@stats != []} class="bg-surface border border-brd rounded-panel p-5 shadow-panel">
    <h2 class="text-sm font-semibold text-th-tertiary uppercase tracking-wider mb-3">
      Statistics
    </h2>
    <div data-testid="dlq-stats" class="grid grid-cols-3 gap-4">
      <div :for={stat <- @stats} class="bg-surface-input border border-brd rounded-xl px-4 py-3">
        <p class="text-xs text-th-muted uppercase tracking-wider">
          {stat["operative_class"] || stat[:operative_class] || "total"}
        </p>
        <p class="text-2xl font-bold text-th-primary font-mono mt-1">
          {stat["count"] || stat[:count] || 0}
        </p>
      </div>
    </div>
  </div>

  <%!-- Entries --%>
  <.panel icon="hero-inbox-stack" class="overflow-hidden">
    <:title>Parked entries ({length(@entries)})</:title>

    <%= if @entries == [] do %>
      <.empty_state icon="hero-check-circle" testid="dlq-empty">
        {if @filter == "",
          do: "The dead-letter queue is empty.",
          else: "No parked entries for that operative class."}
      </.empty_state>
    <% else %>
      <div
        :for={group <- @groups}
        data-testid={"dlq-group-#{group.operative_class}-#{group.procedure_id}"}
        class="border-b border-brd last:border-b-0"
      >
        <div class="px-5 py-3 flex items-center gap-3 bg-surface-input/40">
          <.icon name="hero-folder" class="w-3.5 h-3.5 text-th-tertiary" />
          <span class="font-mono text-xs text-th-primary">
            {group.operative_class}/{group.procedure_id}
          </span>
          <span
            data-testid={"dlq-group-count-#{group.operative_class}-#{group.procedure_id}"}
            class="text-[11px] text-th-tertiary font-mono"
          >
            {group.parked} parked
          </span>
        </div>
        <div class="overflow-x-auto">
          <table data-testid="dlq-table" class="w-full text-sm">
            <thead>
              <tr class="border-b border-brd">
                <th class="text-left px-5 py-3 text-th-tertiary font-medium">Entry</th>
                <th class="text-left px-5 py-3 text-th-tertiary font-medium">Entity</th>
                <th class="text-left px-5 py-3 text-th-tertiary font-medium">Channel</th>
                <th class="text-left px-5 py-3 text-th-tertiary font-medium">Gen</th>
                <th class="text-left px-5 py-3 text-th-tertiary font-medium">Age</th>
                <th class="text-left px-5 py-3 text-th-tertiary font-medium">Error</th>
                <th class="px-5 py-3"></th>
              </tr>
            </thead>
            <tbody>
              <tr
                :for={entry <- group.entries}
                data-testid={"dlq-row-#{entry.ref}"}
                class="border-b border-brd-subtle hover:bg-surface-hover transition-colors"
              >
                <td class="px-5 py-3 text-th-primary font-mono text-xs">{entry.ref}</td>
                <td class="px-5 py-3 text-th-secondary font-mono text-xs">
                  {entry.entity_key || "—"}
                </td>
                <td class="px-5 py-3 text-th-secondary text-xs">{entry.channel || "—"}</td>
                <td class="px-5 py-3 text-th-tertiary text-xs">{entry.generation}</td>
                <td class="px-5 py-3 text-th-tertiary text-xs">{Format.age(entry.age_s)}</td>
                <td
                  class="px-5 py-3 text-th-secondary text-xs max-w-xs truncate"
                  title={entry.error}
                >
                  {entry.error || "—"}
                </td>
                <td class="px-5 py-3 text-right whitespace-nowrap">
                  <button
                    phx-click="inspect"
                    phx-value-ref={entry.ref}
                    data-testid={"dlq-inspect-#{entry.ref}"}
                    class="text-xs text-th-secondary hover:text-th-primary transition-colors mr-3"
                  >
                    Inspect
                  </button>
                  <button
                    phx-click="confirm"
                    phx-value-action="replay"
                    phx-value-ref={entry.ref}
                    data-testid={"dlq-replay-#{entry.ref}"}
                    class="text-xs text-accent hover:text-accent-hover transition-colors mr-3"
                  >
                    Replay
                  </button>
                  <button
                    phx-click="confirm"
                    phx-value-action="drop"
                    phx-value-ref={entry.ref}
                    data-testid={"dlq-drop-#{entry.ref}"}
                    class="text-xs text-danger-text hover:text-danger transition-colors"
                  >
                    Drop
                  </button>
                </td>
              </tr>
            </tbody>
          </table>
        </div>
      </div>
    <% end %>
  </.panel>
</div>

<%!-- Inspect --%>
<.dialog :if={@selected} testid="dlq-inspect-modal" size="max-w-2xl">
  <div class="flex items-center justify-between mb-4">
    <h3 class="text-lg font-semibold text-th-primary font-mono">{@selected.ref}</h3>
    <button
      phx-click="close_inspect"
      data-testid="dlq-inspect-close"
      class="text-th-muted hover:text-th-primary transition-colors"
    >
      <.icon name="hero-x-mark" class="w-5 h-5" />
    </button>
  </div>

  <p class="text-xs text-th-muted uppercase tracking-wider mb-2">Metadata</p>
  <pre class="bg-surface-base rounded-xl p-4 text-xs text-code font-mono overflow-x-auto whitespace-pre-wrap border border-brd mb-4"><%= inspect(@selected.entry, pretty: true) %></pre>

  <p class="text-xs text-th-muted uppercase tracking-wider mb-2">Payload preview</p>
  <pre
    data-testid="dlq-payload"
    class="bg-surface-base rounded-xl p-4 text-xs text-code font-mono overflow-x-auto whitespace-pre-wrap border border-brd"
  ><%= Format.printable(@selected.payload, limit: 2_000) %></pre>
</.dialog>

<.confirm_dialog
  :if={@confirm}
  title={if @confirm.action == "replay", do: "Replay entry?", else: "Drop entry?"}
  confirm_label={if @confirm.action == "replay", do: "Replay", else: "Drop"}
  variant={if @confirm.action == "replay", do: "accent", else: "danger"}
  on_confirm={@confirm.action}
  on_cancel="cancel_confirm"
  values={%{"ref" => @confirm.ref}}
  testid="dlq-confirm-modal"
  cancel_testid="dlq-confirm-cancel"
  confirm_testid="dlq-confirm-submit"
>
  <%= if @confirm.action == "replay" do %>
    Re-dispatch <.mono>{@confirm.ref}</.mono>. If it fails again it will be parked again, and the
    outcome will be reported here.
  <% else %>
    Discard
    <.mono>{@confirm.ref}</.mono>
    and its payload. This is permanent and cannot be undone.
  <% end %>
</.confirm_dialog>
