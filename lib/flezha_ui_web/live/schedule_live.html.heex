<div class="space-y-6">
  <.header>
    Schedules
    <:subtitle :if={@scoped_namespace}>
      Targeting <span class="flz-num">{@scoped_namespace}</span>.
    </:subtitle>
    <:actions>
      <button
        :if={NodeManager.granted?(@operations, "Schedule.add")}
        phx-click="open_form"
        data-testid="schedule-new-btn"
        class="flz-button flz-button--md"
      >
        <.icon name="hero-plus" class="w-4 h-4" /> New Schedule
      </button>
    </:actions>
  </.header>

  <.runtime_error error={@load_error} />

  <div :if={@ran} data-testid="schedule-ran">
    <.runtime_error :if={@ran[:error]} error={@ran[:error]} action={"the run of #{@ran.name}"} />
    <.notice :if={@ran[:answer] && @ran.answer.outcome == :spawned} icon="hero-play">
      {@ran.name} ran now and started <.link
        navigate={~p"/namespaces/#{@ran.namespace || "default"}/relays/#{@ran.answer.relay_id}"}
        data-testid="schedule-ran-link"
        class="underline hover:no-underline font-mono"
      >
        {@ran.answer.relay_id}
      </.link>.
    </.notice>
    <.notice :if={@ran[:answer] && @ran.answer.outcome == :already_running}>
      {@ran.name} has an instance running already, so none was started.
    </.notice>
  </div>

  <.scope_notice
    :if={@scoped_namespace}
    scope={@scoped_namespace}
    listing="schedule"
    testid="schedule-scope-notice"
  />

  <.panel icon="hero-clock" class="overflow-hidden">
    <:title>Entries ({length(@schedules)})</:title>

    <%= if @schedules == [] do %>
      <.empty_state icon="hero-clock" testid="schedule-empty">
        <span :if={@scoped_namespace}>No schedule targets {@scoped_namespace}.</span>
        <span :if={!@scoped_namespace}>No schedule has been created.</span>
      </.empty_state>
    <% else %>
      <div class="overflow-x-auto">
        <table data-testid="schedule-table" class="flz-table">
          <thead>
            <tr>
              <th>Name</th>
              <th>Cron</th>
              <th>Timezone</th>
              <th>Namespace</th>
              <th>Factory</th>
              <th>Status</th>
              <th>Last fire</th>
              <th>Next fire</th>
              <th></th>
            </tr>
          </thead>
          <tbody>
            <tr
              :for={schedule <- @schedules}
              data-testid={"schedule-row-#{schedule.name}"}
            >
              <td class="text-th-primary flz-num text-xs">{schedule.name}</td>
              <td class="flz-num text-xs">{schedule.cron}</td>
              <td class="text-xs">{schedule.timezone}</td>
              <td class="text-xs">{schedule.namespace}</td>
              <td class="flz-num text-xs">{schedule.factory_id}</td>
              <td class="text-xs">
                <span
                  :if={schedule.armed}
                  data-testid={"schedule-status-#{schedule.name}"}
                  class="flz-badge"
                >
                  <span class="w-1.5 h-1.5 rounded-full bg-success"></span> Armed
                </span>
                <span
                  :if={!schedule.armed}
                  data-testid={"schedule-status-#{schedule.name}"}
                  class="flz-badge"
                >
                  <span class="w-1.5 h-1.5 rounded-full bg-th-muted"></span> Not armed
                </span>
              </td>
              <td class="text-xs">
                {Format.timestamp(schedule.last_fire)}
              </td>
              <td
                data-testid={"schedule-next-fire-#{schedule.name}"}
                class="text-xs"
              >
                {Format.timestamp(schedule.next_fire)}
              </td>
              <td class="text-right whitespace-nowrap space-x-3">
                <button
                  :if={NodeManager.granted?(@operations, "Schedule.run")}
                  phx-click="run_now"
                  phx-value-name={schedule.name}
                  data-testid={"schedule-run-#{schedule.name}"}
                  class="flz-button flz-button--sm flz-button--ghost"
                >
                  Run now
                </button>
                <button
                  :if={NodeManager.granted?(@operations, "Schedule.remove")}
                  phx-click="confirm_remove"
                  phx-value-name={schedule.name}
                  data-testid={"schedule-remove-#{schedule.name}"}
                  class="flz-button flz-button--sm flz-button--ghost"
                >
                  Remove
                </button>
              </td>
            </tr>
          </tbody>
        </table>
      </div>
    <% end %>
  </.panel>
</div>

<%!-- Create --%>
<.dialog :if={@show_form} testid="schedule-form-modal" size="form" on_close="close_form">
  <:title>New Schedule</:title>

  <.notice :if={@form_error} kind={:error} testid="schedule-form-error" class="mb-4">
    {@form_error}
  </.notice>

  <form phx-submit="create" phx-change="form_change" class="space-y-4">
    <%!-- The controller composes `<name>@<slot-iso>` as the relay id, and
          that must fit its 32-byte limit — so the name gets 11. --%>
    <.input
      type="text"
      name="schedule[name]"
      label="Name"
      value={@form["name"]}
      maxlength="11"
      hint="max 11 characters"
      data-testid="schedule-input-name"
    />
    <.input
      type="text"
      name="schedule[cron]"
      label="Cron expression"
      value={@form["cron"]}
      placeholder="*/5 * * * *"
      mono
      data-testid="schedule-input-cron"
    />
    <.input
      type="text"
      name="schedule[timezone]"
      label="Timezone"
      value={@form["timezone"]}
      data-testid="schedule-input-timezone"
    />
    <div class="grid grid-cols-2 gap-4">
      <Target.namespace_field
        target={@target}
        name="schedule[namespace]"
        value={@form["namespace"]}
        testid="schedule-input-namespace"
      />
      <Target.factory_field
        target={@target}
        name="schedule[factory_id]"
        label="Steps factory"
        value={@form["factory_id"]}
        testid="schedule-input-factory"
      />
    </div>
    <p class="text-xs text-th-muted">
      Only a factory whose run is <span class="font-mono">steps</span>
      can be scheduled, so only those are offered.
    </p>
    <.input
      type="textarea"
      name="schedule[init_values]"
      label="Init Values"
      hint="JSON, optional"
      value={@form["init_values"]}
      placeholder="{}"
      mono
      data-testid="schedule-input-init-values"
    />

    <div class="flex justify-between pt-2">
      <.button variant="ghost" phx-click="close_form" data-testid="schedule-form-cancel">
        Cancel
      </.button>
      <.button type="submit" data-testid="schedule-form-submit">Create</.button>
    </div>
  </form>
</.dialog>

<.confirm_dialog
  :if={@confirm_remove}
  title="Remove schedule?"
  confirm_label="Remove"
  on_confirm="remove"
  on_cancel="cancel_remove"
  values={%{"name" => @confirm_remove}}
  testid="schedule-remove-modal"
  cancel_testid="schedule-remove-cancel"
  confirm_testid="schedule-remove-confirm"
>
  Retract
  <.mono>{@confirm_remove}</.mono>
  from the hub and delete it. It will stop firing.
</.confirm_dialog>
