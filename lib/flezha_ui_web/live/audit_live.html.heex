<div class="space-y-6">
  <.header>Audit log</.header>

  <.runtime_error error={@load_error} action="the audit log" />

  <.notice :if={@disabled_reason} testid="audit-disabled">
    {disabled_message(@disabled_reason)}
  </.notice>

  <%= if is_nil(@disabled_reason) do %>
    <%!-- Stats --%>
    <div :if={@stats} class="flz-panel p-5">
      <h2 class="flz-panel-title mb-3">
        Statistics
      </h2>
      <dl data-testid="audit-stats" class="flz-stats">
        <.stat :for={{label, value} <- stat_tiles(@stats)} label={label} boxed>{value}</.stat>
      </dl>
      <p :if={@stats[:drop_count] not in [nil, 0]} class="mt-3 text-xs text-danger-text">
        {@stats[:drop_count]} record(s) were dropped rather than written.
      </p>
    </div>

    <%!-- Files --%>
    <.panel icon="hero-document-text">
      <:title>Files ({length(@files)})</:title>
      <:actions>
        <button
          :if={NodeManager.granted?(@operations, "AuditLog.rotate")}
          phx-click="rotate"
          data-testid="audit-rotate-btn"
          class="flz-button flz-button--sm flz-button--secondary"
        >
          <.icon name="hero-arrow-path-rounded-square" class="w-3.5 h-3.5" /> Rotate
        </button>
      </:actions>
      <div :if={@rotate_error} data-testid="audit-rotate-error" class="px-5 pt-3">
        <.runtime_error error={@rotate_error} action="the rotation" />
      </div>
      <%= if @files == [] do %>
        <%!-- The catalog lists rotated files, so it is empty until the first
              rotation even while the current file is being written. --%>
        <.empty_state icon="hero-document-text" testid="audit-files-empty">
          No file has been rotated yet.
          <:detail>
            Records are being written to <span class="flz-num text-th-secondary">{current_file(@stats)}</span>.
          </:detail>
        </.empty_state>
      <% else %>
        <ul data-testid="audit-files" class="divide-y divide-brd-subtle">
          <li :for={file <- @files} class="px-5 py-3 text-xs font-mono text-th-secondary">
            {inspect(file)}
          </li>
        </ul>
      <% end %>
    </.panel>

    <%!-- Read --%>
    <.panel icon="hero-magnifying-glass">
      <:title>Records</:title>
      <:actions>
        <button
          phx-click="read"
          data-testid="audit-read-btn"
          class="flz-button flz-button--sm flz-button--secondary"
        >
          <.icon name="hero-arrow-path" class="w-3.5 h-3.5" /> Read
        </button>
      </:actions>

      <div class="p-5 space-y-4">
        <form phx-change="filter_change" class="grid grid-cols-4 gap-4">
          <.input
            type="text"
            name="filter[file]"
            label="File"
            value={@filter["file"]}
            placeholder="all files"
            data-testid="audit-filter-file"
          />
          <.input
            type="text"
            name="filter[source]"
            label="Source"
            value={@filter["source"]}
            placeholder="all sources"
            data-testid="audit-filter-source"
          />
          <.input
            type="text"
            name="filter[name]"
            label="Name"
            value={@filter["name"]}
            placeholder="all names"
            data-testid="audit-filter-name"
          />
          <.input
            type="number"
            name="filter[limit]"
            label="Limit"
            value={@filter["limit"]}
            data-testid="audit-filter-limit"
          />
        </form>

        <.runtime_error :if={@read_error} error={@read_error} action="this audit read" />

        <.notice :if={@truncated} testid="audit-truncated">
          More records matched than the limit. Raise the limit or narrow the filter.
        </.notice>

        <%= cond do %>
          <% is_nil(@records) -> %>
            <p class="text-sm text-th-muted">Click "Read" to load audit records.</p>
          <% @records == [] -> %>
            <p data-testid="audit-records-empty" class="text-sm text-th-muted">
              No record matches this filter.
            </p>
          <% true -> %>
            <div data-testid="audit-records" class="space-y-1 max-h-96 overflow-y-auto">
              <pre
                :for={record <- @records}
                class="flz-code flz-code--wrap"
              ><%= Format.json_line(record) %></pre>
            </div>
        <% end %>
      </div>
    </.panel>

    <%!-- Tail --%>
    <.panel icon="hero-signal">
      <:title>Live tail ({length(@tail_records)})</:title>
      <:actions>
        <button
          phx-click={if @tailing, do: "stop_tail", else: "start_tail"}
          data-testid="audit-tail-toggle"
          aria-pressed={to_string(@tailing)}
          class={["flz-button flz-button--sm", !@tailing && "flz-button--secondary"]}
        >
          {if @tailing, do: "Tailing — stop", else: "Start tail"}
        </button>
      </:actions>
      <div class="p-5">
        <%!-- A subscription the controller refused is stated: a tail that never
              started looks exactly like a quiet one otherwise. --%>
        <.runtime_error
          :if={@tail_error}
          error={@tail_error}
          action="the live audit tail"
          class="mb-4"
        />
        <%= cond do %>
          <% is_nil(@tailing) -> %>
            <p data-testid="audit-tail-idle" class="text-sm text-th-muted">
              The tail is stopped. Start it to stream new audit records as they are written.
            </p>
          <% @tail_records == [] -> %>
            <p class="text-sm text-th-muted">Tailing — waiting for the next record.</p>
          <% true -> %>
            <div data-testid="audit-tail-records" class="space-y-1 max-h-96 overflow-y-auto">
              <pre
                :for={record <- @tail_records}
                class="flz-code flz-code--wrap"
              ><%= Format.json_line(record) %></pre>
            </div>
        <% end %>
      </div>
    </.panel>
  <% end %>
</div>
