<.page_header eyebrow="Platform" title="Audit log">
  <:sentence>
    The controller's record of who did what, as which <.term key="principal" />, and with which
    outcome. Read it with a filter, or tail it live.
  </:sentence>
</.page_header>
<div class="space-y-6">
  <.runtime_error error={@load_error} action="the audit log" />

  <.notice :if={@disabled_reason} testid="audit-disabled">
    {disabled_message(@disabled_reason)}
  </.notice>

  <%= if is_nil(@disabled_reason) do %>
    <%!-- Stats --%>
    <div :if={@stats}>
      <dl data-testid="audit-stats" class="fui-facts">
        <.stat :for={{label, value} <- stat_tiles(@stats)} label={label}>{value}</.stat>
      </dl>
      <p :if={@stats[:drop_count] not in [nil, 0]} class="mt-3 fui-tone-negative">
        {Words.count(@stats[:drop_count], "record")} dropped rather than written.
      </p>
    </div>

    <%!-- Files --%>
    <.section testid="audit-files-panel" digest={Words.count(length(@files), "rotated file")}>
      <:title>Files</:title>
      <:actions>
        <.button
          :if={NodeManager.granted?(@operations, "AuditLog.rotate")}
          variant="secondary"
          size="sm"
          icon="hero-arrow-path-rounded-square"
          phx-click="rotate"
          data-testid="audit-rotate-btn"
        >
          Rotate
        </.button>
      </:actions>
      <div :if={@rotate_error} data-testid="audit-rotate-error" class="mb-3">
        <.runtime_error error={@rotate_error} action="the rotation" />
      </div>
      <%= if @files == [] do %>
        <%!-- The catalog lists rotated files, so it is empty until the first
              rotation even while the current file is being written. --%>
        <.empty_state icon="hero-document-text" testid="audit-files-empty">
          A rotated file holds the records written before a rotation. None has been rotated yet.
          <:detail>
            Records are being written to <span class="fui-num fui-quiet">{current_file(@stats)}</span>.
          </:detail>
        </.empty_state>
      <% else %>
        <.grid
          id="audit-file-rows"
          rows={@files}
          testid="audit-files"
          row_testid={fn _ -> "audit-file" end}
        >
          <:col :let={file} label="File"><span class="fui-num">{file[:filename]}</span></:col>
          <:col :let={file} label="Records" num>{file[:record_count]}</:col>
          <:col :let={file} label="Size" num>{Format.bytes(file[:size_bytes])}</:col>
        </.grid>
      <% end %>
    </.section>

    <%!-- Read --%>
    <.section testid="audit-records-panel">
      <:title>Records</:title>
      <:actions>
        <.button
          variant="secondary"
          size="sm"
          icon="hero-arrow-path"
          phx-click="read"
          data-testid="audit-read-btn"
        >
          Read
        </.button>
      </:actions>

      <div class="space-y-4">
        <form phx-change="filter_change" class="grid gap-4 sm:grid-cols-4">
          <.input
            type="text"
            name="filter[file]"
            label="File"
            value={@filter["file"]}
            placeholder="all files"
            data-testid="audit-filter-file"
          />
          <.input
            type="text"
            name="filter[source]"
            label="Source"
            value={@filter["source"]}
            placeholder="all sources"
            data-testid="audit-filter-source"
          />
          <.input
            type="text"
            name="filter[name]"
            label="Name"
            value={@filter["name"]}
            placeholder="all names"
            data-testid="audit-filter-name"
          />
          <.input
            type="number"
            name="filter[limit]"
            label="Limit"
            value={@filter["limit"]}
            data-testid="audit-filter-limit"
          />
        </form>

        <.runtime_error :if={@read_error} error={@read_error} action="this audit read" />

        <.notice :if={@truncated} testid="audit-truncated">
          More records matched than the limit. Raise the limit or narrow the filter.
        </.notice>

        <%= cond do %>
          <% @read_error -> %>
          <% is_nil(@records) -> %>
            <p class="fui-figures">Read loads the records this filter matches.</p>
          <% @records == [] -> %>
            <p data-testid="audit-records-empty" class="fui-figures">
              No record matches this filter.
            </p>
          <% true -> %>
            <pre data-testid="audit-records" class="fui-code"><span :for={record <- @records} class="block">{Format.json_line(record)}</span></pre>
        <% end %>
      </div>
    </.section>

    <%!-- Tail --%>
    <.section
      testid="audit-tail-panel"
      digest={
        if @tailing,
          do: Words.count(length(@tail_records), "record") <> " so far",
          else: "stopped"
      }
    >
      <:title>Live tail</:title>
      <:actions>
        <.switch
          checked={@tailing != nil}
          label="Tail new records"
          phx-click={if @tailing, do: "stop_tail", else: "start_tail"}
          testid="audit-tail-toggle"
        />
      </:actions>
      <div>
        <%!-- A subscription the controller refused is stated: a tail that never
              started looks exactly like a quiet one otherwise. --%>
        <.runtime_error
          :if={@tail_error}
          error={@tail_error}
          action="the live audit tail"
        />
        <%= cond do %>
          <% is_nil(@tailing) -> %>
            <p data-testid="audit-tail-idle" class="fui-figures">
              The tail is stopped. Start it to stream new audit records as they are written.
            </p>
          <% @tail_records == [] -> %>
            <p class="fui-figures">Tailing — waiting for the next record.</p>
          <% true -> %>
            <pre data-testid="audit-tail-records" class="fui-code"><span :for={record <- @tail_records} class="block">{Format.json_line(record)}</span></pre>
        <% end %>
      </div>
    </.section>
  <% end %>
</div>
