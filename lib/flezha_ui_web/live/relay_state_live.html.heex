<div class="space-y-6">
  <.header>
    <span class="flz-num">{@relay_id}</span>
    <span class="ml-2 text-sm font-normal text-th-secondary">durable state</span>
  </.header>

  <.relay_tabs ns={@ns} relay_id={@relay_id} current={:state} />

  <.runtime_error error={@load_error} action="the state listing" />

  <div class="flz-panel p-5 space-y-3" data-testid="state-retention">
    <dl class="flex flex-wrap gap-6 text-sm">
      <div>
        <dt class="flz-label">History retention</dt>
        <dd data-testid="history-retention" class="flz-num text-th-primary mt-1">
          <%= case @history_retention do %>
            <% nil -> %>
              unavailable
            <% :unknown -> %>
              unknown — this controller does not report it
            <% hours -> %>
              {hours} hours
          <% end %>
        </dd>
      </div>
      <div :if={@run != :flow}>
        <dt class="flz-label">Finished-instance retention</dt>
        <dd data-testid="finished-retention" class="flz-num text-th-primary mt-1">
          {if @retention_hours, do: "#{@retention_hours} hours", else: "unavailable"}
        </dd>
      </div>
    </dl>
    <form
      :if={NodeManager.granted?(@operations, "Steps.set_retention")}
      phx-change="retention_change"
      phx-submit="set_retention"
      data-testid="retention-form"
      class="flex flex-wrap items-end gap-3"
    >
      <.input
        type="number"
        name="retention[hours]"
        label="Set history retention (hours)"
        value={@retention_form["hours"]}
        compact
        data-testid="retention-hours"
      />
      <.button type="submit" size="sm" data-testid="retention-submit">Set</.button>
      <p class="text-xs text-th-muted basis-full">
        Kept in the controller's memory: it lasts until the controller next boots unless its
        runtime configuration says the same.
      </p>
    </form>
    <.form_error error={@retention_error} action="the retention change" testid="retention-error" />
  </div>

  <%= if @cells == [] do %>
    <.empty_state icon="hero-circle-stack" testid="state-empty" boxed={true}>
      This relay has no durable state yet.
    </.empty_state>
  <% else %>
    <.panel
      :for={{tasklet, cells} <- Enum.group_by(@cells, & &1.tasklet)}
      testid={"tasklet-#{tasklet}"}
      icon="hero-circle-stack"
      class="overflow-hidden"
    >
      <:title>Tasklet <span class="font-mono normal-case">{tasklet}</span></:title>
      <table class="flz-table">
        <thead>
          <tr>
            <th>Cell</th>
            <th>WAL seq</th>
            <th>Snapshot seq</th>
            <th>Flush p99</th>
            <th>Fsync lag</th>
            <th>Dedup drops</th>
            <th></th>
          </tr>
        </thead>
        <tbody>
          <tr
            :for={cell <- cells}
            data-testid={"cell-#{cell.key}"}
          >
            <td class="text-th-primary flz-num text-xs">
              <%!-- A tasklet holding one unkeyed cell reports an empty key;
                    naming it is clearer than rendering nothing. --%>
              {if cell.cell_key == "", do: "(unkeyed)", else: cell.cell_key}
              <span
                :if={lagging?(cell)}
                data-testid={"cell-lagging-#{cell.key}"}
                class="flz-badge flz-badge--accent ml-1"
              >
                lagging
              </span>
            </td>
            <td class="flz-num text-xs">
              {cell.counters[:wal_seq]}
            </td>
            <td class="flz-num text-xs">
              {cell.counters[:snapshot_seq]}
            </td>
            <td class="flz-num text-xs">
              {cell.counters[:flush_latency_ms_p99]}
            </td>
            <td class="flz-num text-xs">
              {cell.counters[:fsync_durability_lag_ms]}
            </td>
            <td class="flz-num text-xs">
              {cell.counters[:dedup_drops_total]}
            </td>
            <td class="text-right whitespace-nowrap space-x-3">
              <button
                phx-click="select_cell"
                phx-value-cell={cell.key}
                data-testid={"select-#{cell.key}"}
                class="flz-button flz-button--sm flz-button--ghost"
              >
                Inspect
              </button>
              <button
                :if={NodeManager.granted?(@operations, "Steps.rotate")}
                phx-click="confirm"
                phx-value-action="rotate"
                phx-value-cell={cell.key}
                data-testid={"rotate-#{cell.key}"}
                class="flz-button flz-button--sm flz-button--ghost"
              >
                Rotate
              </button>
              <button
                :if={NodeManager.granted?(@operations, "Steps.delete")}
                phx-click="confirm"
                phx-value-action="delete"
                phx-value-cell={cell.key}
                data-testid={"delete-#{cell.key}"}
                class="flz-button flz-button--sm flz-button--ghost"
              >
                Delete
              </button>
            </td>
          </tr>
        </tbody>
      </table>
    </.panel>

    <%!-- Durability lag, sampled by this UI --%>
    <div
      data-testid="lag-chart"
      class="flz-panel p-5"
    >
      <div class="flex items-center gap-2 mb-1">
        <.icon name="hero-chart-bar-square" class="w-4 h-4 text-th-secondary" />
        <h2 class="flz-panel-title">
          Durability lag and WAL-behind-snapshot
        </h2>
      </div>
      <p data-testid="chart-provenance" class="text-xs text-th-muted mb-4">
        Sampled by this UI every 5s — not a series the controller records. A missed tick is drawn
        as a gap, never interpolated.
      </p>
      <div :for={cell <- @cells} class="mb-4 last:mb-0">
        <p class="text-xs font-mono text-th-secondary mb-1">{cell.key}</p>
        <div class="flex items-end gap-px h-12" data-testid={"spark-#{cell.key}"}>
          <span
            :for={point <- Enum.reverse(Map.get(@history, cell.key, []))}
            class={[
              "w-1 rounded-sm",
              if(is_nil(point.lag_ms), do: "bg-transparent", else: "bg-brand")
            ]}
            style={"height: #{min(48, (point.lag_ms || 0))}px"}
            title={"lag #{point.lag_ms || "—"}ms, wal gap #{point.wal_gap || "—"}"}
          >
          </span>
        </div>
      </div>
    </div>

    <%!-- Point-in-time read --%>
    <div
      :if={@selected}
      data-testid="time-travel"
      class="flz-panel p-5"
    >
      <div class="flex items-center gap-2 mb-4">
        <.icon name="hero-clock" class="w-4 h-4 text-th-secondary" />
        <h2 class="flz-panel-title">
          Where history stands — <span class="font-mono normal-case">{@selected}</span>
        </h2>
      </div>

      <form phx-change="travel_change" class="flex items-end gap-3 mb-4">
        <div>
          <.dropdown
            label="Target"
            id="travel-kind"
            name="travel[kind]"
            value={@travel_form["kind"]}
            testid="travel-kind"
            class="w-36"
          >
            <:option value="seq">sequence</:option>
            <:option value="time">ISO 8601 time</:option>
          </.dropdown>
        </div>
        <div>
          <.input
            type="text"
            name="travel[value]"
            label="Value"
            value={@travel_form["value"]}
            compact
            data-testid="travel-value"
          />
        </div>
      </form>
      <div class="flex gap-3">
        <button
          phx-click="travel"
          data-testid="travel-submit"
          class="flz-button flz-button--sm"
        >
          Read
        </button>
        <%!-- Core refuses a steps relay's cell, so replay is a flow relay's alone. --%>
        <button
          :if={@run == :flow and NodeManager.granted?(@operations, "Relay.replay")}
          phx-click="confirm"
          phx-value-action="replay"
          phx-value-cell={@selected}
          data-testid="replay-open"
          class="flz-button flz-button--sm flz-button--secondary"
        >
          Replay from here
        </button>
      </div>

      <p :if={@replayed} data-testid="replay-result" class="text-sm text-th-secondary mt-4">
        Replaying <span class="font-mono">{@replayed.cell}</span>
        from sequence <span class="font-mono">{@replayed.from_seq}</span>.
      </p>

      <p
        :if={@travel_target && @travel_result}
        data-testid="travel-target"
        class="text-xs text-th-muted mt-4"
      >
        Asked for: <span class="font-mono">{@travel_target}</span>
      </p>

      <%!-- The controller answers where the history stands, not the state
            itself, so the sizes are shown and nothing is presented as the
            cell's state at that point. --%>
      <dl :if={@travel_result} data-testid="travel-result" class="grid grid-cols-3 gap-4 mt-2">
        <.stat label="Resolved sequence" testid="travel-seq">{@travel_result.terminal_seq}</.stat>
        <.stat label="Snapshot" testid="travel-snapshot-size">
          {Format.bytes(@travel_result.snapshot_size)}
        </.stat>
        <.stat label="Change log" testid="travel-change-log-size">
          {Format.bytes(@travel_result.change_log_size)}
        </.stat>
      </dl>

      <.notice :if={@travel_error} kind={:error} testid="travel-error" class="mt-4">
        {travel_reason(@travel_error)}
      </.notice>

      <div data-testid="outbox" class="mt-6">
        <h3 class="flz-label mb-2">Outbox</h3>
        <.runtime_error error={@outbox_error} action="the outbox" />
        <dl :if={@outbox} class="grid grid-cols-3 gap-4">
          <.stat label="Durable seq" testid="outbox-durable-seq">
            {@outbox[:outbox_durable_seq] || "unknown — writer not running"}
          </.stat>
          <.stat label="Flush cursor">{@outbox[:outbox_flushed_seq]}</.stat>
          <.stat label="Persisted WAL seq" testid="outbox-persisted-seq">
            {@outbox[:last_persisted_seq]}
          </.stat>
          <.stat label="Epoch">{@outbox[:epoch]}</.stat>
          <.stat label="Pending" testid="outbox-pending">
            {if is_nil(@outbox[:pending]),
              do: "unknown — writer not running",
              else: @outbox.pending}
          </.stat>
          <.stat label="Held" testid="outbox-held">
            {if is_nil(@outbox[:held]), do: "unknown — writer not running", else: @outbox.held}
          </.stat>
          <.stat label="Input watermark">{@outbox[:input_watermark] || "—"}</.stat>
        </dl>
      </div>
    </div>
  <% end %>
</div>

<.confirm_dialog
  :if={@confirm}
  title={confirm_title(@confirm.action)}
  confirm_label={confirm_label(@confirm.action)}
  on_confirm={@confirm.action}
  on_cancel="cancel_confirm"
  variant={if @confirm.action == "rotate", do: "accent", else: "danger"}
  values={%{"cell" => @confirm.cell}}
  testid="state-confirm-modal"
  cancel_testid="state-confirm-cancel"
  confirm_testid="state-confirm-btn"
>
  <%= case @confirm.action do %>
    <% "rotate" -> %>
      Compact the persisted state of <.mono>{@confirm.cell}</.mono>? Its runner writes a fresh
      snapshot; nothing is lost.
    <% "delete" -> %>
      Delete the persisted state of <.mono>{@confirm.cell}</.mono>? Its write-ahead log,
      snapshots and outbox deduplication are removed and cannot be recovered.
    <% "replay" -> %>
      Replay
      <.mono>{@confirm.cell}</.mono>
      from <.mono>{@travel_form["value"]}</.mono>? The cell is rewound to that point and its
      retained inputs are run again through the current code.
  <% end %>
</.confirm_dialog>
