<div>
  <h1>
    {gettext("Namespace ID: %{namespace_id}", namespace_id: @namespace.id)}
  </h1>

  <div>
    {gettext("List of processors in the namespace:")}
    <ul>
      <%= for processor <- @namespace.processors do %>
        <li>{gettext("%{processor_name}", processor_name: processor)}</li>
      <% end %>
    </ul>
  </div>

  <div>
    {gettext("List of computations running in the namespace:")}
    <ul>
      <%= for compute_engine <- @namespace.compute_engines do %>
        <li>{gettext("%{compute_engine_name}", compute_engine_name: compute_engine)}</li>
      <% end %>
    </ul>
  </div>
</div>
