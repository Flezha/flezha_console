#!/bin/sh
# The console reaches its controllers over HTTPS and starts no Erlang
# distribution. Console replicas that cluster among themselves
# (DNS_CLUSTER_QUERY) set RELEASE_DISTRIBUTION=name, with a RELEASE_COOKIE of
# their own, never the controllers'.
export RELEASE_DISTRIBUTION="${RELEASE_DISTRIBUTION:-none}"

# The launcher reads a cookie whatever the distribution, and the archive ships
# none; without distribution nothing uses it, so each start draws its own.
if [ "$RELEASE_DISTRIBUTION" = none ] && [ -z "${RELEASE_COOKIE:-}" ]; then
  RELEASE_COOKIE=$(od -An -N32 -tx1 /dev/urandom | tr -d ' \n')
  export RELEASE_COOKIE
fi
